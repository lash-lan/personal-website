{
	"compatibility_date": "2026-04-20",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "personal-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// The private 2026 plan (/plan). No id on purpose: Cloudflare creates the
	// database on the first deploy and remembers it from then on.
	"d1_databases": [
		{
			"binding": "PLAN_DB",
			"database_name": "lash-plan"
		}
	],
	"observability": {
		"enabled": true
	}
}