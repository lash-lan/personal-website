---
import SectionLayout from '../layouts/SectionLayout.astro';
import { SECTIONS, STORIES, storyHref, ageBySlug } from '../data/content.js';

const latest = [...STORIES].reverse();

const DESCRIPTIONS = {
  library: 'Shorter tales, gathered by the age of the world they belong to.',
  sagas:   'The long tellings. Whole lives and whole wars, followed through the peoples who carry them.',
  codex:   'The chronicle. Titans, mortals, realms, and relics, recorded age by age.',
  gallery: 'Faces and places of the world, kept somewhere they can still be looked at.',
  trial:   'A set of questions, and the figure of the age your nature answers to.',
};
---
<SectionLayout
  title="LASH: Stories That Were Never Meant to Exist"
  description="Lash, dark fantasy and epic fiction. Stories born from grief, light, and the weight of things unnamed."
  theme="library"
  eyebrow="Tales from the space between"
  heading="LASH"
  tagline="I write worlds that were never meant to exist. Stories born from grief, light, and the weight of things unnamed."
>
  <div class="wrap">
    <!-- ─── THE WRITER ─── -->
    <section class="about reveal">
      <span class="band-label">The Writer</span>
      <p class="about-text">
        My name is <strong>Lash</strong>. I write dark fantasy and epic fiction,
        stories that live in the space between myth and memory.
        I've always believed that the most powerful tales are the ones
        that <strong>were never supposed to be told</strong>.
      </p>
    </section>

    <div class="ornament reveal">✦</div>

    <!-- ─── THE FIVE HALLS ─── -->
    <div class="band-head reveal">
      <span class="band-label">Where to begin</span>
      <h2 class="band-title">Five ways into the world</h2>
    </div>

    <div class="grid grid-3">
      {SECTIONS.map((s) => (
        <a href={s.href} class:list={['tile', 'reveal', { 'is-soon': s.comingSoon }]}>
          <span class="tile-eyebrow">{s.kind}</span>
          <span class="tile-title">{s.name}</span>
          <p class="tile-blurb">{DESCRIPTIONS[s.slug]}</p>
          {s.comingSoon && <span class="tile-meta">Coming Soon</span>}
        </a>
      ))}
    </div>

    <div class="ornament reveal">✦</div>

    <!-- ─── LATEST ─── -->
    <div class="band-head reveal">
      <span class="band-label">Most recent</span>
      <h2 class="band-title">Newly written</h2>
    </div>

    <div class="grid grid-3">
      {latest.map((s) => (
        <a href={storyHref(s)} class="tile reveal">
          <span class="tile-eyebrow">№ {s.number} · {ageBySlug(s.age)?.name}</span>
          <span class="tile-title">{s.title}</span>
          <p class="tile-blurb">{s.blurb}</p>
          <span class="tile-meta">{s.part}</span>
        </a>
      ))}
    </div>
  </div>
</SectionLayout>

<style>
  .about {
    max-width: 34rem;
    margin: 0 auto 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .about-text { font-size: 1.08rem; line-height: 1.85; color: var(--text); }
  .about-text strong { color: var(--textBright); font-weight: 500; }
</style>
