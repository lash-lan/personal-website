---
import SectionLayout from '../../layouts/SectionLayout.astro';
import PlateGrid from '../../components/PlateGrid.astro';
import { GALLERY_CATEGORIES, galleryItemHref } from '../../data/content.js';

export function getStaticPaths() {
  return GALLERY_CATEGORIES.map((cat) => ({ params: { category: cat.slug }, props: { cat } }));
}

const { cat } = Astro.props;

// Anyone with more than one image becomes a folder linking to their own page.
const plates = cat.items.map((item) => ({
  img: item.img,
  name: item.name,
  note: item.note,
  href: item.shots.length > 1 ? galleryItemHref(cat, item) : undefined,
  count: `${item.shots.length} images`,
}));
---
<SectionLayout
  title={`${cat.name} | Hall of Memories | LASH`}
  description={cat.blurb}
  theme="gallery"
  current="gallery"
  compact={true}
  back={{ href: "/gallery", label: "Hall of Memories" }}
  eyebrow="Hall of Memories"
  heading={cat.name}
  tagline={cat.blurb}
>
  <div class="wrap">
    {plates.length > 0 ? (
      <PlateGrid plates={plates} />
    ) : (
      <div class="empty reveal">
        <strong>No images yet</strong>
        Nothing has been hung in this hall so far. It will fill as the artwork is made.
      </div>
    )}
  </div>
</SectionLayout>
