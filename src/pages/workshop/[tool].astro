---
import SectionLayout from '../../layouts/SectionLayout.astro';
import ToolBench from '../../components/ToolBench.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { TOOLS, BENCHES } from '../../data/tools.js';

export function getStaticPaths() {
  return TOOLS.filter((t) => !t.soon).map((tool) => ({
    params: { tool: tool.slug },
    props: { tool, bench: BENCHES.find((b) => b.slug === tool.bench) },
  }));
}

const { tool, bench } = Astro.props;
---
<SectionLayout
  title={`${tool.name}, ${tool.sub} | The Workshop | LASH`}
  description={`${tool.blurb} Runs entirely in your browser. Nothing is uploaded.`}
  theme="workshop"
  current="workshop"
  compact={true}
  back={{ href: '/workshop', label: 'The Workshop' }}
  eyebrow={bench?.name ?? 'The Workshop'}
  heading={tool.name}
  tagline={tool.blurb}
  note={tool.sub}
>
  <div class="tool-crest"><ToolIcon slug={tool.slug} size={40} /></div>
  <ToolBench tool={tool} />

<style>
  .tool-crest {
    display: grid;
    place-items: center;
    width: 4.6rem;
    height: 4.6rem;
    margin: -1rem auto 2.2rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 8%, var(--card));
    color: var(--accent);
  }
</style>
</SectionLayout>
