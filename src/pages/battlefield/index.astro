---
// Blood of Icetear: Citadel Wars.
//
// The painting is the world. This file draws nothing of the battlefield
// itself: it places the game's pieces on top of one image at coordinates
// that live in src/data/battlefield-map.js, and turns taps into calls to
// src/lib/battle.js, which knows nothing about pictures at all.
//
//   engine        src/lib/battle.js        the rules
//   opponent      src/lib/battle-ai.js     the Keep
//   geography     src/data/battlefield-map.js   where the rules sit on art
//   this file     presentation only
//
// Changing the artwork therefore means writing another map beside that one.
import { GUARDIAN_BUDGET } from '../../lib/battle.js';
import { MAPS, DEFAULT_MAP } from '../../data/battlefield-map.js';
const map = MAPS[DEFAULT_MAP];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Citadel Wars | LASH</title>
  <meta name="description" content="Blood of Icetear: Citadel Wars. Two hosts, three roads, one citadel each." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cormorant+SC:wght@300;400;500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" />
  <link rel="preload" as="image" href={map.image} />
  <!-- is:global is required, not cosmetic: every piece on this board is
       built by script after the page loads, and Astro's scoped styles only
       reach elements that exist at build time. -->
  <style is:global>
    :root{
      --bg:#05080b; --ink:#0b1219;
      --text:#c5ced5; --dim:#8a97a3; --bright:#e8eef3;
      --blood:#8b191c; --blood-lt:#c65a52; --gold:#c9a24a; --frost:#9fc0d8;
      --ember:#d68a33;
      --line:rgba(200,214,226,.18);
      --p0:#7fb3dd; --p1:#c65a52;
    }
    *{box-sizing:border-box}
    html,body{margin:0;background:#04070a;color:var(--text);
      font-family:'EB Garamond',Georgia,serif;font-size:16px;line-height:1.5;
      -webkit-font-smoothing:antialiased;overscroll-behavior:none}
    h1,h2,h3{font-family:'Cinzel',serif;font-weight:600;color:var(--bright);margin:0}
    .lbl{font-family:'Cormorant SC',serif;font-size:.6rem;letter-spacing:.24em;
      text-transform:uppercase;color:var(--dim)}
    button{font:inherit;color:inherit;background:none;border:1px solid var(--line);
      padding:.38rem .7rem;cursor:pointer;
      transition:border-color .15s,color .15s,background .15s,transform .12s}
    button:hover:not(:disabled){border-color:var(--gold);color:var(--bright)}
    button:disabled{opacity:.32;cursor:not-allowed}
    button:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
    .primary{border-color:rgba(201,162,74,.55);color:var(--bright);
      background:linear-gradient(180deg,rgba(201,162,74,.16),rgba(201,162,74,.05))}
    [hidden]{display:none!important}

    /* ── the muster screen, before a battle ── */
    .wrap{max-width:1180px;margin:0 auto;padding:1.1rem 1rem 3rem}
    header.top{display:flex;align-items:baseline;gap:1rem;flex-wrap:wrap;
      border-bottom:1px solid var(--line);padding-bottom:.7rem;margin-bottom:1rem}
    header.top h1{font-size:clamp(1.1rem,3.4vw,1.6rem);letter-spacing:.05em}
    header.top a{color:var(--dim);text-decoration:none;font-size:.85rem;margin-left:auto}
    .setup{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:1.4rem}
    .col h2{font-size:1rem;margin-bottom:.2rem}
    .budget{display:flex;align-items:center;gap:.6rem;margin:.5rem 0 .9rem}
    .meter{flex:1;height:8px;background:rgba(255,255,255,.07);overflow:hidden}
    .meter i{display:block;height:100%;background:var(--gold)}
    .meter.over i{background:var(--blood-lt)}
    .spend{font-variant-numeric:tabular-nums;font-size:.85rem;color:var(--dim)}
    .spend.over{color:var(--blood-lt)}
    .post{display:flex;align-items:center;gap:.6rem;padding:.45rem 0;
      border-bottom:1px solid rgba(200,214,226,.08)}
    .post select{flex:1;min-width:0;background:var(--ink);color:var(--text);
      border:1px solid var(--line);padding:.35rem;font:inherit;font-size:.86rem}
    .hint{font-size:.85rem;color:var(--dim);min-height:1.2rem}

    /* ── the battle: the painting fills the screen ── */
    .battle{position:fixed;inset:0;display:flex;flex-direction:column;
      background:#04070a}
    .viewport{position:relative;flex:1;min-height:0;overflow:hidden;
      touch-action:pan-x pan-y}
    /* the stage is exactly the painting's own shape, never stretched */
    .stage{position:absolute;left:50%;top:50%;transform-origin:center center;
      aspect-ratio:1536/1024;background-size:cover;background-position:center;
      will-change:transform}
    .stage img{width:100%;height:100%;display:block;object-fit:contain;
      pointer-events:none;user-select:none}

    /* ── nodes: invisible until they have something to say ── */
    .node{position:absolute;transform:translate(-50%,-50%);
      display:flex;flex-direction:column;align-items:center;gap:2px;
      pointer-events:none}
    .node .crew{display:flex;gap:3px;align-items:flex-end;justify-content:center;
      pointer-events:auto}
    /* the ground ring that appears only when a move or a blow is offered */
    .spot{position:absolute;left:50%;top:50%;width:clamp(30px,4.2cqw,52px);
      height:clamp(16px,2.2cqw,28px);transform:translate(-50%,-50%);
      border-radius:50%;pointer-events:none;opacity:0;transition:opacity .18s}
    .node.open .spot{opacity:1;pointer-events:auto;cursor:pointer;
      border:1px solid rgba(201,162,74,.85);
      background:radial-gradient(ellipse at center,rgba(201,162,74,.3),transparent 70%);
      box-shadow:0 0 16px rgba(201,162,74,.4)}
    .node.hostile .spot{opacity:1;
      border:1px solid rgba(198,90,82,.85);
      background:radial-gradient(ellipse at center,rgba(198,90,82,.3),transparent 70%)}

    /* a character standing on the ground */
    .pawn{position:relative;width:clamp(26px,3.4cqw,44px);padding:0;border:0;
      background:none;cursor:pointer;display:block;line-height:0;
      filter:drop-shadow(0 4px 5px rgba(0,0,0,.75))}
    .pawn .face{display:block;width:100%;aspect-ratio:1;border-radius:50%;
      background-size:cover;background-position:center top;background-color:#16202a;
      border:2px solid var(--ring,#9fc0d8);
      box-shadow:0 0 0 1px rgba(0,0,0,.8),inset 0 0 12px rgba(0,0,0,.5)}
    .pawn.o0{--ring:#7fb3dd} .pawn.o1{--ring:#c65a52} .pawn.mon{--ring:#a8703c}
    .pawn.r-legendary,.pawn.r-mythical{--ring:#c9a24a}
    .pawn .atk,.pawn .hp{position:absolute;bottom:-3px;min-width:15px;height:15px;
      border-radius:50%;display:grid;place-items:center;line-height:1;
      font-family:'Cinzel',serif;font-size:9px;border:1px solid rgba(0,0,0,.75)}
    .pawn .atk{left:-4px;background:linear-gradient(180deg,#eef3f7,#93a3b0);color:#080e14}
    .pawn .hp{right:-4px;background:linear-gradient(180deg,#d9564f,#7c1417);color:#fff}
    .pawn.sel .face{border-color:var(--gold);
      box-shadow:0 0 0 2px var(--gold),0 0 20px rgba(201,162,74,.6)}
    .pawn.tgt .face{border-color:var(--blood-lt);
      box-shadow:0 0 0 2px var(--blood-lt),0 0 20px rgba(198,90,82,.6)}
    .pawn.spent{opacity:.5}

    /* ── keeps: a plaque under the painted gate, not a box over it ── */
    .work{position:absolute;transform:translate(-50%,-50%);text-align:center;
      pointer-events:none;width:max-content}
    .work .wn{font-family:'Cormorant SC',serif;font-size:clamp(7px,.85cqw,11px);
      letter-spacing:.18em;text-transform:uppercase;color:#dbe5ed;
      text-shadow:0 1px 3px #000,0 0 8px rgba(0,0,0,.9);white-space:nowrap}
    .work .wv{font-family:'Cinzel',serif;font-size:clamp(9px,1.1cqw,14px);
      color:var(--gold);text-shadow:0 1px 3px #000;font-variant-numeric:tabular-nums}
    .work .wbar{height:3px;width:clamp(40px,5.5cqw,78px);margin:1px auto 0;
      background:rgba(0,0,0,.65);border:1px solid rgba(0,0,0,.8)}
    .work .wbar i{display:block;height:100%;background:var(--frost)}
    .work.theirs .wbar i{background:var(--blood-lt)}
    .work.fallen{opacity:.45}
    .work.fallen .wv{color:var(--blood-lt)}
    .work.aim{pointer-events:auto;cursor:crosshair}
    .work.aim .wn{color:#ffd9b0}
    .work.aim::after{content:'';position:absolute;inset:-8px -12px;
      border:1px solid rgba(198,90,82,.8);border-radius:4px;
      box-shadow:0 0 18px rgba(198,90,82,.45)}

    /* a small standard where a middle has been taken */
    .flag{position:absolute;transform:translate(-50%,-50%);width:14px;height:18px;
      pointer-events:none;transition:opacity .3s}
    .flag::before{content:'';position:absolute;left:5px;top:0;width:1.5px;height:18px;
      background:linear-gradient(180deg,#d8e2ea,#5a6873)}
    .flag::after{content:'';position:absolute;left:6px;top:1px;width:9px;height:7px;
      background:var(--fc,#7fb3dd);clip-path:polygon(0 0,100% 0,100% 100%,0 100%,25% 50%)}
    .flag.o1{--fc:#c65a52}

    /* ── developer markers, for checking the geography ── */
    .mark{position:absolute;transform:translate(-50%,-50%);pointer-events:auto;
      cursor:grab;z-index:40;display:flex;flex-direction:column;align-items:center}
    .mark.drag{cursor:grabbing;z-index:60}
    .mark i{display:block;width:12px;height:12px;border-radius:50%;
      background:rgba(201,162,74,.9);border:1.5px solid #05080b;
      box-shadow:0 0 0 1px rgba(201,162,74,.6),0 0 10px rgba(201,162,74,.5)}
    .mark.keep i{background:rgba(127,179,221,.95)}
    .mark.foe i{background:rgba(198,90,82,.95)}
    .mark span{font-family:'Cormorant SC',serif;font-size:9px;letter-spacing:.12em;
      color:#fff;background:rgba(4,7,10,.82);padding:1px 4px;margin-top:2px;
      white-space:nowrap;border:1px solid rgba(201,162,74,.35)}

    /* ── the HUD: around the painting, never over its middle ── */
    .hud{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;
      padding:.4rem .6rem;background:linear-gradient(180deg,#080d13,#05080b);
      border-bottom:1px solid var(--line);flex:0 0 auto;
      padding-top:calc(.4rem + env(safe-area-inset-top,0px))}
    .who{font-family:'Cinzel',serif;font-size:.85rem;color:var(--bright)}
    .who.p1{color:var(--p1)} .who.p0{color:var(--p0)}
    .phases{display:flex;gap:2px}
    .ph{font-family:'Cormorant SC',serif;font-size:.54rem;letter-spacing:.14em;
      text-transform:uppercase;color:var(--dim);padding:.16rem .34rem;
      border:1px solid transparent}
    .ph.on{color:#080e14;background:var(--gold);border-color:var(--gold)}
    .muster{display:flex;align-items:center;gap:3px;font-variant-numeric:tabular-nums;
      color:var(--gold);font-size:.78rem}
    .pip{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.14);
      border:1px solid rgba(201,162,74,.4)}
    .pip.on{background:var(--gold);box-shadow:0 0 6px rgba(201,162,74,.7)}
    .hud .right{margin-left:auto;display:flex;gap:.4rem;align-items:center}

    .cam{display:flex;gap:2px;padding:.3rem .6rem;background:#05080b;
      border-top:1px solid var(--line);overflow-x:auto;flex:0 0 auto}
    .cam button{font-family:'Cormorant SC',serif;font-size:.54rem;letter-spacing:.14em;
      text-transform:uppercase;padding:.28rem .5rem;white-space:nowrap;flex:1}
    .cam button.on{border-color:var(--gold);color:var(--bright)}

    /* ── the hand, held at the bottom edge ── */
    .tray{flex:0 0 auto;background:linear-gradient(180deg,#05080b,#080d13);
      border-top:1px solid var(--line);padding:.3rem .5rem;
      padding-bottom:calc(.4rem + env(safe-area-inset-bottom,0px))}
    .trayhead{display:flex;align-items:baseline;gap:.5rem;margin-bottom:.2rem}
    .cards{display:flex;gap:.3rem;overflow-x:auto;padding:.35rem .1rem .2rem;
      scrollbar-width:thin;align-items:flex-end}
    .card{position:relative;flex:0 0 72px;width:72px;height:104px;padding:0;
      text-align:center;display:block;cursor:pointer;
      background:linear-gradient(170deg,#1b2733,#0a1017);
      border:1px solid var(--edge,rgba(160,182,200,.4));
      box-shadow:0 3px 9px rgba(0,0,0,.6)}
    .card.r-rare{--edge:rgba(96,140,180,.8)}
    .card.r-epic{--edge:rgba(150,110,190,.8)}
    .card.r-legendary{--edge:rgba(201,162,74,.9)}
    .card.r-mythical{--edge:rgba(228,199,124,1)}
    .card .cost{position:absolute;top:-6px;left:-6px;width:21px;height:21px;
      border-radius:50%;display:grid;place-items:center;z-index:2;
      font-family:'Cinzel',serif;font-size:.66rem;color:#04101a;
      background:linear-gradient(180deg,#a8d6ef,#3b7ea8);border:1px solid rgba(0,0,0,.7)}
    .card .cost.isfree{background:linear-gradient(180deg,#ecd79c,#c9a24a)}
    .hart{display:block;height:54px;background-size:cover;background-position:center top;
      background-color:#16202a;border-bottom:1px solid rgba(0,0,0,.6);
      font-family:'Cinzel',serif;font-size:1.3rem;color:#8d9aa6;line-height:54px}
    .hart.none{background-image:linear-gradient(160deg,#243441,#0e1720)}
    .hname{display:block;padding:.2rem .15rem 0;font-family:'Cinzel',serif;
      font-size:.5rem;line-height:1.2;color:var(--bright);max-height:2.4em;overflow:hidden}
    .hst{display:block;font-family:'Cinzel',serif;font-size:.54rem;color:var(--dim);
      margin-top:.1rem;font-variant-numeric:tabular-nums}
    .card.sel{transform:translateY(-8px);border-color:var(--gold);
      box-shadow:0 0 0 1px var(--gold),0 10px 18px rgba(0,0,0,.7)}
    .card.cant{opacity:.34;cursor:not-allowed;filter:grayscale(.55)}

    .toast{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);
      background:rgba(4,7,10,.9);border:1px solid var(--line);padding:.3rem .7rem;
      font-size:.78rem;color:var(--bright);pointer-events:none;z-index:50;
      max-width:92%;text-align:center}
    .verdict{position:absolute;inset:0;display:grid;place-items:center;z-index:70;
      background:rgba(4,7,10,.82);text-align:center;padding:1rem}
    .verdict h2{font-size:clamp(1.3rem,5vw,2rem);margin-bottom:.4rem}

    @media (max-width:700px){
      .card{flex:0 0 64px;width:64px;height:94px}
      .hart{height:48px;line-height:48px}
    }
  </style>
</head>
<body>

<!-- ── mustering ────────────────────────────────────────────────────── -->
<div class="wrap" id="setupScreen">
  <header class="top">
    <h1>Blood of Icetear: Citadel Wars</h1>
    <span class="lbl">Prototype</span>
    <a href="/">Back to the site</a>
  </header>
  <p style="max-width:58ch;margin-bottom:1rem">
    Post your Guardians before a shot is fired. You have
    <b style="color:var(--gold)">{GUARDIAN_BUDGET} points</b> across all three gates, and a
    Guardian costs whatever their rarity is worth in hit points. Whoever stands
    on the wall is not in your deck.
  </p>
  <div class="setup" id="setupCols"></div>
  <div style="margin-top:1.2rem;display:flex;gap:.5rem;flex-wrap:wrap;align-items:center">
    <button type="button" id="btnSkirmish" class="primary">Skirmish &mdash; play the Keep</button>
    <button type="button" id="btnQuick">Muster both sides for me</button>
    <button type="button" id="btnStart">Two players</button>
    <span class="hint" id="setupHint"></span>
  </div>
</div>

<!-- ── the battlefield ──────────────────────────────────────────────── -->
<div class="battle" id="battleScreen" hidden>
  <div class="hud">
    <span class="who" id="who"></span>
    <div class="phases" id="phaseBar"></div>
    <span class="muster" id="musterNow"></span>
    <div class="right">
      <button type="button" id="btnNodes" title="Show the gameplay positions">Nodes</button>
      <button type="button" id="btnLeave">Leave</button>
      <button type="button" id="btnNext" class="primary">Next</button>
    </div>
  </div>

  <div class="viewport" id="viewport">
    <div class="stage" id="stage">
      <img id="plate" src={map.image} alt="The battlefield before the Great Gate" />
      <div id="layer"></div>
    </div>
    <div class="toast" id="toast" hidden></div>
    <div class="verdict" id="verdict" hidden><div><h2 id="verdictName"></h2><p id="verdictNote"></p>
      <button type="button" id="btnAgain" class="primary" style="margin-top:.8rem">Again</button></div></div>
  </div>

  <div class="cam" id="cam"></div>

  <div class="tray">
    <div class="trayhead"><span class="lbl" id="handLabel"></span></div>
    <div class="cards" id="handCards"></div>
  </div>
</div>

<script>
  import {
    newGame, quickArmy, rngFrom, LANES, laneOf, trackOf, middleOf, homeOf,
    deploy, canDeploy, move, canMove, attack, targetsFor, advance, wallFor,
    guardianSpend, validateArmy, guardianCost, GUARDIAN_BUDGET,
    cardOf, PHASES, PHASE_NAME, MUSTER_MAX,
  } from '../../lib/battle.js';
  import { playPhase } from '../../lib/battle-ai.js';
  import { CARDS, RARITY, statsOf, artOf } from '../../data/battle-cards.js';
  import { MAPS, DEFAULT_MAP, nodeId, markerLabel } from '../../data/battlefield-map.js';

  const MAP = MAPS[DEFAULT_MAP];
  const $ = (id) => document.getElementById(id);
  const el = (tag, cls, text) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  };
  const pause = (ms) => new Promise((r) => setTimeout(r, ms));

  const NAMES = ['Your Host', 'The Keep'];
  let armies = [null, null];
  let game = null;
  let aiSide = null, aiBusy = false;
  let picked = null, pickedFree = false;
  let selected = null;
  let showNodes = false;
  // the near army is always the bottom of the painting: the picture does not
  // turn round, so a second player fights from the far end
  const viewSide = () => 0;
  const yourTurn = () => game && game.winner === null && !aiBusy &&
    (aiSide === null || game.current === viewSide());

  const say = (text) => {
    const t = $('toast');
    t.textContent = text || '';
    t.hidden = !text;
  };

  // ── mustering ─────────────────────────────────────────────────────
  const POSTS = [
    { key: 'commander', label: 'Commander', count: 1, only: (c) => c.commander },
    { key: 'great', label: 'Great Gate', count: 3 },
    { key: 'high', label: 'High Gate', count: 2 },
    { key: 'reinforcements', label: 'Reinforcement', count: 4 },
  ];
  const blankArmy = () => quickArmy(rngFrom(Math.floor(Math.random() * 1e9) || 1));

  function drawSetup() {
    const root = $('setupCols');
    root.innerHTML = '';
    for (let side = 0; side < 2; side++) {
      if (!armies[side]) armies[side] = blankArmy();
      const army = armies[side];
      const col = el('div', 'col');
      col.appendChild(el('h2', null, NAMES[side]));
      const spend = guardianSpend(army);
      const bar = el('div', 'budget');
      const meter = el('div', 'meter' + (spend.legal ? '' : ' over'));
      const fill = el('i');
      fill.style.width = Math.min(100, (spend.spent / GUARDIAN_BUDGET) * 100) + '%';
      meter.appendChild(fill);
      bar.appendChild(meter);
      bar.appendChild(el('span', 'spend' + (spend.legal ? '' : ' over'),
        `${spend.spent} / ${GUARDIAN_BUDGET}`));
      col.appendChild(bar);
      for (const post of POSTS) {
        for (let i = 0; i < post.count; i++) {
          const row = el('div', 'post');
          row.appendChild(el('span', 'lbl', post.count > 1 ? `${post.label} ${i + 1}` : post.label));
          const sel = document.createElement('select');
          const chosen = post.count === 1 ? army[post.key] : army[post.key][i];
          for (const c of CARDS.filter((c) => !post.only || post.only(c))) {
            const o = document.createElement('option');
            o.value = c.id;
            const costs = post.key === 'great' || post.key === 'high';
            o.textContent = `${c.name} — ${c.rarity}${costs ? ` (${guardianCost(c.id)})` : ''}`;
            if (c.id === chosen) o.selected = true;
            sel.appendChild(o);
          }
          sel.addEventListener('change', () => {
            if (post.count === 1) army[post.key] = sel.value;
            else army[post.key][i] = sel.value;
            drawSetup();
          });
          row.appendChild(sel);
          col.appendChild(row);
        }
      }
      root.appendChild(col);
    }
    const problems = armies.map((a, i) => (validateArmy(a) ? `${NAMES[i]}: ${validateArmy(a)}` : null))
      .filter(Boolean);
    $('setupHint').textContent = problems.join('  ');
    $('btnStart').disabled = problems.length > 0;
    $('btnSkirmish').disabled = problems.length > 0;
  }

  // ── the camera ────────────────────────────────────────────────────
  // The painting never re-renders and is never stretched. The camera is a
  // transform on the stage, so moving about costs nothing.
  let cam = { scale: 1, x: 0, y: 0 };
  const VIEWS = [
    { id: 'all', label: 'Whole field', to: { fx: 0.5, fy: 0.5, z: null } },
    { id: 'mine', label: 'My keep', to: { fx: 0.5, fy: 0.80, z: 1.9 } },
    { id: 'left', label: 'Left road', to: { fx: 0.20, fy: 0.42, z: 1.8 } },
    { id: 'centre', label: 'Centre', to: { fx: 0.49, fy: 0.42, z: 1.7 } },
    { id: 'right', label: 'Right road', to: { fx: 0.83, fy: 0.42, z: 1.8 } },
    { id: 'theirs', label: 'Their keep', to: { fx: 0.5, fy: 0.13, z: 1.9 } },
  ];
  let view = 'all';

  /** Fit the painting inside the viewport without ever distorting it. */
  function layoutStage() {
    const vp = $('viewport');
    const stage = $('stage');
    const w = vp.clientWidth, h = vp.clientHeight;
    if (!w || !h) return;
    const ar = MAP.width / MAP.height;
    let sw = w, sh = w / ar;
    if (sh > h) { sh = h; sw = h * ar; }
    stage.style.width = sw + 'px';
    stage.style.height = sh + 'px';
    stage.style.containerType = 'inline-size';
    applyCam();
  }

  function applyCam() {
    const { scale, x, y } = cam;
    $('stage').style.transform =
      `translate(-50%,-50%) translate(${x}px,${y}px) scale(${scale})`;
  }

  /**
   * The zoom at which the painting fills the viewport in both directions.
   * On a wide screen that is 1, and the whole battlefield is visible. On a
   * phone the painting is far wider than it is tall, so at 1 it would sit in
   * a thin band with dead space above and below; this fills the screen and
   * leaves the player to pan across, which is the point of a battlefield.
   */
  function fitZoom() {
    const vp = $('viewport'), stage = $('stage');
    if (!stage.clientHeight) return 1;
    // Height only, never width. A wide screen already shows the whole field
    // once the painting is fitted, and filling the width there would zoom in
    // and cut off both keeps. A phone is the opposite case: the painting
    // sits in a thin band, so it is grown until it fills and panned across.
    return Math.max(1, Math.min(2.6, vp.clientHeight / stage.clientHeight));
  }

  /** Put a fraction of the painting in the middle of the viewport. */
  function lookAt(fx, fy, z) {
    const stage = $('stage');
    const sw = stage.clientWidth, sh = stage.clientHeight;
    cam.scale = z;
    cam.x = (0.5 - fx) * sw * z;
    cam.y = (0.5 - fy) * sh * z;
    clampCam();
    $('stage').style.transition = 'transform .45s cubic-bezier(.4,0,.2,1)';
    applyCam();
    setTimeout(() => { $('stage').style.transition = ''; }, 460);
  }

  function clampCam() {
    const vp = $('viewport'), stage = $('stage');
    const sw = stage.clientWidth * cam.scale, sh = stage.clientHeight * cam.scale;
    const maxX = Math.max(0, (sw - vp.clientWidth) / 2);
    const maxY = Math.max(0, (sh - vp.clientHeight) / 2);
    cam.x = Math.max(-maxX, Math.min(maxX, cam.x));
    cam.y = Math.max(-maxY, Math.min(maxY, cam.y));
  }

  function drawCam() {
    const root = $('cam');
    root.innerHTML = '';
    for (const v of VIEWS) {
      const b = el('button', view === v.id ? 'on' : '', v.label);
      b.type = 'button';
      b.addEventListener('click', () => {
        view = v.id;
        lookAt(v.to.fx, v.to.fy, v.to.z === null ? fitZoom() : v.to.z);
        drawCam();
      });
      root.appendChild(b);
    }
  }

  // dragging the field about
  let drag = null;
  function wireDrag() {
    const vp = $('viewport');
    vp.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.pawn,.spot,.work,.mark')) return;
      drag = { x: e.clientX, y: e.clientY, cx: cam.x, cy: cam.y };
      vp.setPointerCapture(e.pointerId);
    });
    vp.addEventListener('pointermove', (e) => {
      if (!drag) return;
      cam.x = drag.cx + (e.clientX - drag.x);
      cam.y = drag.cy + (e.clientY - drag.y);
      clampCam(); applyCam();
    });
    const stop = () => { drag = null; };
    vp.addEventListener('pointerup', stop);
    vp.addEventListener('pointercancel', stop);
  }

  // ── placing things on the painting ────────────────────────────────
  const put = (node, x, y) => {
    node.style.left = (x * 100) + '%';
    node.style.top = (y * 100) + '%';
  };

  /**
   * A small formation, so several characters on one piece of ground look
   * like an army holding it rather than cards stacked in a div.
   */
  function spread(n, i) {
    if (n <= 1) return { dx: 0, dy: 0 };
    const perRow = n <= 3 ? n : Math.ceil(n / 2);
    const row = Math.floor(i / perRow);
    const col = i % perRow;
    const inRow = Math.min(perRow, n - row * perRow);
    return { dx: (col - (inRow - 1) / 2) * 0.62, dy: row * 0.42 };
  }

  function pawnFor(laneKey, u) {
    const card = cardOf(u.cardId);
    const done = u.owner === game.current && u.acted && u.moved;
    const b = el('button', 'pawn o' + u.owner + ' r-' + card.rarity.toLowerCase() +
      (selected && selected.uid === u.uid ? ' sel' : '') + (done ? ' spent' : ''));
    b.type = 'button';
    b.dataset.uid = u.uid;
    const face = el('span', 'face');
    const art = artOf(u.cardId);
    if (art) face.style.backgroundImage = `url(${art})`;
    b.appendChild(face);
    b.appendChild(el('span', 'atk', String(u.atk)));
    b.appendChild(el('span', 'hp', String(u.hp)));
    b.title = `${card.name} — ${card.rarity}. ${u.atk} attack, ${u.hp} of ${u.maxHp}. ${card.note}`;
    b.setAttribute('aria-label', b.title);
    b.addEventListener('click', (e) => { e.stopPropagation(); onPawn(laneKey, u); });
    return b;
  }

  function monsterPawn(laneKey, m) {
    const b = el('button', 'pawn mon');
    b.type = 'button';
    b.dataset.uid = m.uid;
    const face = el('span', 'face');
    face.style.backgroundImage = 'linear-gradient(160deg,#3a2118,#160b07)';
    b.appendChild(face);
    b.appendChild(el('span', 'atk', String(m.atk)));
    b.appendChild(el('span', 'hp', String(m.hp)));
    b.title = `${m.name} — ${m.atk} attack, ${m.hp} of ${m.maxHp}. It answers whenever struck.`;
    b.setAttribute('aria-label', b.title);
    b.addEventListener('click', (e) => { e.stopPropagation(); onTarget(m.uid); });
    return b;
  }

  /** The gates, commanders and citadels, as plaques under the painted stone. */
  function workFor(id, side, label, hp, maxHp, aimable) {
    const w = el('div', 'work' + (side === 1 ? ' theirs' : '') +
      (hp <= 0 ? ' fallen' : '') + (aimable ? ' aim' : ''));
    w.appendChild(el('span', 'wn', label));
    w.appendChild(el('span', 'wv', String(Math.max(0, Math.round(hp)))));
    const bar = el('div', 'wbar');
    const i = el('i');
    i.style.width = Math.max(0, Math.min(100, (hp / maxHp) * 100)) + '%';
    bar.appendChild(i);
    w.appendChild(bar);
    return w;
  }

  function drawBoard() {
    const layer = $('layer');
    layer.innerHTML = '';
    const targets = selected && game.phase === 'action'
      ? targetsFor(game, selected.lane, selected.uid) : [];
    const canHit = (uid) => targets.some((t) => t.uid === uid);
    const wallTarget = targets.find((t) => ['gate', 'commander', 'citadel'].includes(t.kind));

    // the keeps
    for (let side = 0; side < 2; side++) {
      const p = game.players[side];
      const nGreat = MAP.nodes[nodeId('centre', side === 0 ? 0 : trackOf(laneOf('centre')) - 1)];
      const great = workFor('great', side, 'The Great Gate', p.greatGate.hp, p.greatGate.maxHp,
        wallTarget && selected && selected.lane === 'centre' && side !== viewSide() && p.greatGate.hp > 0);
      put(great, nGreat.x, nGreat.y);
      if (great.classList.contains('aim')) great.addEventListener('click', () => onTarget('gate'));
      layer.appendChild(great);

      for (const [i, laneKey] of ['left', 'right'].entries()) {
        const g = p.highGates[i];
        const n = MAP.nodes[nodeId(laneKey, side === 0 ? 0 : trackOf(laneOf(laneKey)) - 1)];
        const aim = wallTarget && selected && selected.lane === laneKey && side !== viewSide() && g.hp > 0;
        const w = workFor('high', side, 'High Gate', g.hp, g.maxHp, aim);
        put(w, n.x, n.y);
        if (aim) w.addEventListener('click', () => onTarget('gate'));
        layer.appendChild(w);
      }

      const nc = MAP.nodes[`commander:${side}`];
      const cmdAim = wallTarget && wallTarget.kind === 'commander' && side !== viewSide();
      const cw = workFor('cmd', side, cardOf(p.commander.cardId).name,
        p.commander.hp, p.commander.maxHp, cmdAim);
      put(cw, nc.x, nc.y);
      if (cmdAim) cw.addEventListener('click', () => onTarget('commander'));
      layer.appendChild(cw);

      const ncit = MAP.nodes[`citadel:${side}`];
      const citAim = wallTarget && wallTarget.kind === 'citadel' && side !== viewSide();
      const cit = workFor('cit', side, side === viewSide() ? 'Your Citadel' : 'Their Citadel',
        p.citadel, 100, citAim);
      put(cit, ncit.x, ncit.y);
      if (citAim) cit.addEventListener('click', () => onTarget('citadel'));
      layer.appendChild(cit);
    }

    // the roads
    for (const lane of LANES) {
      const track = trackOf(laneOf(lane.key));
      const l = game.lanes[lane.key];
      const mid = middleOf(laneOf(lane.key));
      for (let pos = 0; pos < track; pos++) {
        const n = MAP.nodes[nodeId(lane.key, pos)];
        if (!n) continue;
        const here = l.units.filter((u) => u.pos === pos);
        const mons = l.monsters.filter((m) => m.pos === pos && m.hp > 0);
        const crewSize = here.length + mons.length;

        const open = picked && yourTurn() && game.phase === 'main' &&
          pos === homeOf(laneOf(lane.key), game.current) &&
          !canDeploy(game, lane.key, picked, { free: pickedFree });
        const stepHere = selected && game.phase === 'move' &&
          selected.lane === lane.key && !canMove(game, lane.key, selected.uid) &&
          pos === (l.units.find((u) => u.uid === selected.uid) || {}).pos +
            (game.current === 0 ? 1 : -1);

        const node = el('div', 'node' + (open || stepHere ? ' open' : ''));
        put(node, n.x, n.y);
        const spot = el('div', 'spot');
        if (open) spot.addEventListener('click', () => {
          const why = deploy(game, lane.key, picked, { free: pickedFree });
          if (why) { say(why); return; }
          picked = null; pickedFree = false; say('');
          render();
        });
        if (stepHere) spot.addEventListener('click', () => {
          move(game, lane.key, selected.uid);
          selected = null; render();
        });
        node.appendChild(spot);

        if (crewSize) {
          const crew = el('div', 'crew');
          let i = 0;
          for (const m of mons) {
            const pw = monsterPawn(lane.key, m);
            if (canHit(m.uid)) pw.classList.add('tgt');
            crew.appendChild(pw); i++;
          }
          for (const u of here) {
            const pw = pawnFor(lane.key, u);
            if (canHit(u.uid)) pw.classList.add('tgt');
            crew.appendChild(pw); i++;
          }
          node.appendChild(crew);
        }
        layer.appendChild(node);

        // a standard where a middle has been taken
        if (pos === mid && l.holder !== null) {
          const f = el('div', 'flag' + (l.holder === 1 ? ' o1' : ''));
          put(f, n.x + 0.022, n.y - 0.022);
          layer.appendChild(f);
        }
      }
    }

    if (showNodes) drawMarkers(layer);
  }

  // ── developer markers ─────────────────────────────────────────────
  // Only for checking that the geography sits where it should. Drag one and
  // the new coordinates are kept, so the map can be corrected by eye and
  // copied straight back into battlefield-map.js.
  function drawMarkers(layer) {
    for (const [id, n] of Object.entries(MAP.nodes)) {
      const m = el('div', 'mark' + (n.side === 0 ? ' keep' : n.side === 1 ? ' foe' : ''));
      put(m, n.x, n.y);
      m.appendChild(el('i'));
      m.appendChild(el('span', null, markerLabel(id)));
      m.addEventListener('pointerdown', (e) => {
        e.stopPropagation();
        m.classList.add('drag');
        m.setPointerCapture(e.pointerId);
        const stage = $('stage');
        const box = stage.getBoundingClientRect();
        const moveIt = (ev) => {
          n.x = Math.max(0, Math.min(1, (ev.clientX - box.left) / box.width));
          n.y = Math.max(0, Math.min(1, (ev.clientY - box.top) / box.height));
          put(m, n.x, n.y);
        };
        const done = () => {
          m.classList.remove('drag');
          m.removeEventListener('pointermove', moveIt);
          say(`${markerLabel(id)} → x ${n.x.toFixed(3)}, y ${n.y.toFixed(3)}`);
          render(true);
        };
        m.addEventListener('pointermove', moveIt);
        m.addEventListener('pointerup', done, { once: true });
      });
      layer.appendChild(m);
    }
  }

  /** The whole map as it now stands, for pasting back into the source. */
  window.citadelMap = () => {
    const out = {};
    for (const [id, n] of Object.entries(MAP.nodes)) {
      out[id] = { x: Number(n.x.toFixed(3)), y: Number(n.y.toFixed(3)) };
    }
    console.log(JSON.stringify(out, null, 2));
    return out;
  };

  // ── choosing things ───────────────────────────────────────────────
  function onPawn(laneKey, u) {
    if (!yourTurn()) return;
    if (u.owner !== viewSide()) { onTarget(u.uid); return; }
    if (game.phase === 'move') {
      const why = canMove(game, laneKey, u.uid);
      if (why) { say(why); return; }
      selected = { lane: laneKey, uid: u.uid };
      say(`${cardOf(u.cardId).name} may advance. Touch the lit ground.`);
      render(true);
      return;
    }
    if (game.phase === 'action') {
      selected = { lane: laneKey, uid: u.uid };
      const list = targetsFor(game, laneKey, u.uid);
      say(list.length
        ? `${cardOf(u.cardId).name} may strike ${list.map((t) => t.label).join(', ')}.`
        : `${cardOf(u.cardId).name} has nothing in reach.`);
      render(true);
      return;
    }
    say('Characters advance in the Movement layer and strike in the Action layer.');
  }

  function onTarget(uid) {
    if (!selected || game.phase !== 'action') return;
    const why = attack(game, selected.lane, selected.uid, { uid });
    if (why) { say(why); return; }
    selected = null; say('');
    render();
  }

  // ── the hand ──────────────────────────────────────────────────────
  function drawHand() {
    const p = game.players[viewSide()];
    const root = $('handCards');
    root.innerHTML = '';
    $('handLabel').textContent = `${p.name} — ${p.hand.length} in hand, ${p.deck.length} in deck` +
      (p.freeDeploys ? ` · ${p.freeDeploys} free` : '');
    const add = (id, free) => {
      const card = cardOf(id);
      const st = statsOf(card);
      const blocked = !yourTurn() ||
        (canDeploy(game, 'centre', id, { free }) && canDeploy(game, 'left', id, { free }));
      const b = el('button', 'card r-' + card.rarity.toLowerCase() +
        (picked === id && pickedFree === free ? ' sel' : '') + (blocked ? ' cant' : ''));
      b.type = 'button';
      const cost = el('span', 'cost', free ? '0' : String(st.cost));
      if (free) cost.classList.add('isfree');
      b.appendChild(cost);
      const art = el('span', 'hart');
      const face = artOf(id);
      if (face) art.style.backgroundImage = `url(${face})`;
      else { art.classList.add('none'); art.textContent = card.name.replace(/^The /, '').charAt(0); }
      b.appendChild(art);
      b.appendChild(el('span', 'hname', card.name));
      b.appendChild(el('span', 'hst', `${st.atk} / ${st.hp}`));
      b.title = `${card.name} — ${card.rarity}. ${card.note}`;
      b.addEventListener('click', () => {
        if (blocked) return;
        picked = (picked === id && pickedFree === free) ? null : id;
        pickedFree = picked ? free : false;
        say(picked ? 'Touch the lit ground at your own edge.' : '');
        render(true);
      });
      root.appendChild(b);
    };
    for (const id of p.hand) add(id, false);
    if (p.freeDeploys > 0) for (const id of p.reinforcements) add(id, true);
  }

  // ── the frame ─────────────────────────────────────────────────────
  function render(keepToast) {
    const mover = game.current;
    $('who').textContent = `${game.players[mover].name} · turn ${game.turn}` +
      (aiBusy && game.winner === null ? ' · moving' : '');
    $('who').className = 'who p' + mover;
    const bar = $('phaseBar');
    bar.innerHTML = '';
    for (const ph of PHASES) bar.appendChild(el('span', 'ph' + (game.phase === ph ? ' on' : ''), PHASE_NAME[ph]));
    const m = $('musterNow');
    m.innerHTML = '';
    const have = game.players[mover].muster;
    for (let i = 0; i < Math.min(MUSTER_MAX, 10); i++) {
      m.appendChild(el('span', 'pip' + (i < have ? ' on' : '')));
    }
    m.appendChild(el('span', null, ` ${have}`));
    $('btnNext').textContent = game.phase === 'end' ? 'End turn' : 'Next';
    $('btnNext').disabled = !yourTurn();
    $('btnNodes').classList.toggle('on', showNodes);
    drawBoard();
    drawHand();
    if (!keepToast && !aiBusy) {
      const tips = { main: 'Choose a card, then the lit ground.',
        move: 'Touch a character to advance it.',
        action: 'Touch a character to see what it can strike.',
        end: 'Nothing left but to pass.', draw: '' };
      say(tips[game.phase] || '');
    }
    if (game.winner !== null) {
      $('verdict').hidden = false;
      $('verdictName').textContent = `${game.players[game.winner].name} has taken the Citadel`;
      $('verdictNote').textContent = `It fell on turn ${game.turn}.`;
    }
  }

  async function aiTurn() {
    if (aiSide === null || game.current !== aiSide || game.winner !== null) return;
    aiBusy = true; render(true); say('The Keep is moving.');
    while (game.current === aiSide && game.winner === null) {
      await pause(430);
      playPhase(game, aiSide);
      advance(game);
      aiBusy = game.current === aiSide;
      render(true);
    }
    aiBusy = false; render();
  }

  function begin(against) {
    aiSide = against;
    game = newGame({ seed: Math.floor(Math.random() * 1e9) || 1, armies,
      names: against === null ? ['Near Host', 'Far Host'] : NAMES });
    picked = null; selected = null; aiBusy = false; showNodes = false;
    $('setupScreen').hidden = true;
    $('battleScreen').hidden = false;
    $('verdict').hidden = true;
    // Laid out straight away rather than inside an animation frame: a tab in
    // the background never gets a frame, and the board would stay empty.
    // The camera bar and the hand are drawn first, because they take height
    // from the viewport. Fitting the painting before they exist measures a
    // taller screen than the one the player ends up with, and the top and
    // bottom of the battlefield fall off the edge.
    drawCam();
    render();
    layoutStage();
    const z = fitZoom();
    // a phone opens on your own end, where you deploy; a wide screen already
    // sees the whole field at once
    if (z > 1.15) { view = 'mine'; lookAt(0.5, 0.72, z); }
    else { view = 'all'; lookAt(0.5, 0.5, z); }
    drawCam();
  }

  $('btnSkirmish').addEventListener('click', () => { armies = [blankArmy(), blankArmy()]; begin(1); });
  $('btnQuick').addEventListener('click', () => { armies = [blankArmy(), blankArmy()]; drawSetup(); });
  $('btnStart').addEventListener('click', () => begin(null));
  $('btnNodes').addEventListener('click', () => { showNodes = !showNodes; render(true); });
  $('btnLeave').addEventListener('click', () => {
    $('battleScreen').hidden = true; $('setupScreen').hidden = false;
    aiSide = null; aiBusy = false; armies = [null, null]; drawSetup();
  });
  $('btnAgain').addEventListener('click', () => {
    $('verdict').hidden = true;
    armies = [blankArmy(), blankArmy()];
    begin(aiSide);
  });
  $('btnNext').addEventListener('click', () => {
    if (!yourTurn()) return;
    picked = null; selected = null;
    advance(game);
    render();
    if (aiSide !== null && game.current === aiSide) aiTurn();
  });

  window.addEventListener('resize', () => { if (game) { layoutStage(); render(true); } });
  // The tray and the camera bar are built after the battle screen appears,
  // so the viewport is shorter than it was a moment earlier. Watching it is
  // more reliable than measuring once and hoping.
  if (window.ResizeObserver) {
    let last = '';
    new ResizeObserver(() => {
      const vp = $('viewport');
      const size = `${vp.clientWidth}x${vp.clientHeight}`;
      if (!game || size === last || !vp.clientHeight) return;
      last = size;
      layoutStage();
      const v = VIEWS.find((x) => x.id === view) || VIEWS[0];
      lookAt(v.to.fx, v.to.fy, v.to.z === null ? fitZoom() : v.to.z);
    }).observe($('viewport'));
  }
  wireDrag();
  drawSetup();
</script>
</body>
</html>
