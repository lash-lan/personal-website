---
// The Dark Lords Council: a chat room for three, installable to a phone.
//
// Like the atelier, this page carries its own markup rather than the shared
// layout, so nothing here can leak into the pages visitors see, and so it can
// ask search engines to look away. It shares the atelier's door: one password,
// one ticket, no second thing to remember.
import { env } from 'cloudflare:workers';
import { ticketHolds, ticketFrom } from '../../lib/session.js';

export const prerender = false;

const unlocked = await ticketHolds(env.ATELIER_SESSION_SECRET, ticketFrom(Astro.cookies));

const problem = {
  wrong: 'That is not the password.',
  unconfigured: 'The password has not been set on the server yet.',
}[Astro.url.searchParams.get('e') ?? ''] ?? '';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Council</title>
  <link rel="icon" href="/favicon.ico" />

  <link rel="manifest" href="/council.webmanifest" />
  <meta name="theme-color" content="#0d0f15" />
  <link rel="apple-touch-icon" href="/council-192.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Council" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Cinzel for names alone, where a little character costs nothing. Manrope
       for everything that is read at length or tapped at arm's length. -->
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style is:global>
    /* A chamber is always dark. One committed palette, every colour explicit. */
    :root {
      color-scheme: dark;
      --void: #08090d; --chamber: #0d0f15; --slab: #171a23; --slab2: #1e222d;
      --edge: #272c38; --edgeSoft: #1d212b;
      --ink: #e8e9f0; --ink2: #a2a6b8; --ink3: #6e7386;
      --lash: #e8b64c; --lashSlab: #2e2412; --lashEdge: #4a3a17;
      --claude: #a98cf5; --claudeSlab: #1c1a2c;
      --amelia: #4fc9a6; --ameliaSlab: #11241f;
      --ember: #d4563b; --live: #4fc9a6;
      --lift: 0 1px 1px rgba(0,0,0,.5), 0 6px 18px rgba(0,0,0,.35);
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    /* Panels below set their own display, which would otherwise beat `hidden`
       and leave an invisible sheet swallowing every tap. */
    [hidden] { display: none !important; }
    html, body { height: 100%; }
    body {
      background: var(--void); color: var(--ink);
      font-family: Manrope, system-ui, -apple-system, 'Segoe UI', sans-serif;
      font-size: 15px; line-height: 1.5; -webkit-font-smoothing: antialiased;
      overflow: hidden;
    }
    :focus-visible { outline: 2px solid var(--claude); outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }

    .app {
      height: 100dvh; max-width: 780px; margin: 0 auto;
      display: flex; flex-direction: column;
      background: var(--chamber); border-inline: 1px solid var(--edgeSoft);
      position: relative;
    }

    /* ---- the door ---- */
    .door { display: grid; place-items: center; height: 100%; padding: 24px; }
    .door form {
      width: 100%; max-width: 320px; display: grid; gap: 12px;
      background: var(--slab); border: 1px solid var(--edge);
      border-radius: 16px; padding: 22px; box-shadow: var(--lift);
    }
    .door h1 {
      font-family: Cinzel, Georgia, serif; font-size: 19px; font-weight: 600;
      letter-spacing: .04em; text-align: center; text-wrap: balance;
    }
    .door p { font-size: 12.5px; color: var(--ink3); text-align: center; }
    .door input {
      border: 1px solid var(--edge); border-radius: 10px; padding: 11px 13px;
      background: var(--slab2); color: var(--ink); font: inherit; font-size: 16px;
    }
    .door button {
      border: 1px solid var(--ember); background: var(--ember); color: #fff;
      border-radius: 10px; padding: 11px; font: inherit; font-weight: 700;
      cursor: pointer; font-size: 15px;
    }
    .door .wrong { color: var(--ember); }

    /* ---- top bar ---- */
    .bar {
      flex: none; display: flex; align-items: center; gap: 12px;
      padding: 10px 16px; padding-top: calc(10px + env(safe-area-inset-top, 0px));
      background: var(--slab); border-bottom: 1px solid var(--edge); z-index: 30;
    }
    .sigils { display: flex; flex: none; }
    .sig {
      width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center;
      font-family: Cinzel, Georgia, serif; font-size: 12px; font-weight: 600;
      border: 1.5px solid var(--chamber); margin-left: -10px;
    }
    .sig:first-child { margin-left: 0; }
    .sig, .av { position: relative; overflow: hidden; }
    .sig img, .av img {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; border-radius: 50%;
    }
    .who .sig { cursor: pointer; }
    .who .sig::after {
      content: ''; position: absolute; inset: 0; border-radius: 50%;
      box-shadow: inset 0 0 0 1px rgba(232,233,240,.25);
    }
    .sig.l { background: var(--lashSlab); color: var(--lash); box-shadow: inset 0 0 0 1px var(--lashEdge); }
    .sig.c { background: var(--claudeSlab); color: var(--claude); box-shadow: inset 0 0 0 1px #2f2a4d; }
    .sig.a { background: var(--ameliaSlab); color: var(--amelia); box-shadow: inset 0 0 0 1px #1c3b33; }

    .barid { flex: 1 1 auto; min-width: 0; }
    .barid h1 {
      font-family: Cinzel, Georgia, serif; font-size: 16px; font-weight: 600;
      letter-spacing: .04em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .barsub {
      font-size: 11.5px; color: var(--ink3); display: flex; align-items: center; gap: 6px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .pip { width: 6px; height: 6px; border-radius: 50%; flex: none; background: var(--ink3); }
    .pip.on { background: var(--live); box-shadow: 0 0 0 3px rgba(79,201,166,.16); }
    .pip.bad { background: var(--ember); }

    .iconbtn {
      flex: none; width: 34px; height: 34px; border-radius: 50%;
      border: 1px solid var(--edge); background: var(--slab2); color: var(--ink2);
      cursor: pointer; display: grid; place-items: center;
      font-family: Cinzel, serif; font-size: 14px; font-weight: 600;
    }
    .iconbtn:hover { color: var(--ink); border-color: var(--ink3); }
    .iconbtn[aria-expanded='true'] { background: var(--ember); border-color: var(--ember); color: #fff; }

    /* ---- the conversation ---- */
    .scroll {
      flex: 1 1 auto; overflow-y: auto; overscroll-behavior: contain;
      padding: 16px 14px 8px;
      background-color: var(--chamber);
      background-image:
        radial-gradient(circle at 50% -8%, rgba(212,86,59,.10), transparent 58%),
        radial-gradient(circle at 1px 1px, rgba(232,233,240,.045) 1px, transparent 0);
      background-size: auto, 20px 20px;
    }
    .datepill {
      display: table; margin: 2px auto 18px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink3);
      background: var(--slab); border: 1px solid var(--edge);
      border-radius: 999px; padding: 4px 12px;
    }
    .thread { display: flex; flex-direction: column; gap: 8px; }

    .row { display: flex; gap: 8px; align-items: flex-end; }
    .row.them { justify-content: flex-start; }
    .row.you { justify-content: flex-end; }
    .av {
      flex: none; width: 26px; height: 26px; border-radius: 50%; margin-bottom: 2px;
      display: grid; place-items: center; font-family: Cinzel, serif; font-size: 11px; font-weight: 600;
    }
    .av.c { background: var(--claudeSlab); color: var(--claude); box-shadow: inset 0 0 0 1px #2f2a4d; }
    .av.a { background: var(--ameliaSlab); color: var(--amelia); box-shadow: inset 0 0 0 1px #1c3b33; }

    .bub {
      position: relative; max-width: min(78%, 520px);
      border-radius: 14px; padding: 8px 12px 6px;
      background: var(--slab); border: 1px solid var(--edge); box-shadow: var(--lift);
    }
    .row.them .bub { border-bottom-left-radius: 4px; }
    .row.you .bub {
      border-bottom-right-radius: 4px;
      background: var(--lashSlab); border-color: var(--lashEdge);
    }
    .bub.sending { opacity: .55; }

    /* Waiting for an answer. Three dots, breathing in turn, and a line of
       hers surfacing and fading while you wait. */
    .bub.waiting { padding: 11px 14px; max-width: min(78%, 420px); }
    .murmur {
      margin-top: 7px; font-size: 13px; font-style: italic; color: var(--ink2);
      opacity: 1; transition: opacity .38s ease;
      text-wrap: balance;
    }
    .dots { display: flex; gap: 5px; align-items: center; }
    .dots i {
      width: 7px; height: 7px; border-radius: 50%; background: var(--claude);
      opacity: .35; animation: breathe 1.25s ease-in-out infinite;
    }
    .dots i:nth-child(2) { animation-delay: .18s; }
    .dots i:nth-child(3) { animation-delay: .36s; }
    @keyframes breathe {
      0%, 60%, 100% { opacity: .3; transform: translateY(0); }
      30% { opacity: 1; transform: translateY(-3px); }
    }
    /* Stillness for anyone who asked for it: the dots stay, the dance stops. */
    @media (prefers-reduced-motion: reduce) { .dots i { opacity: .75; } }

    .nameline { display: flex; align-items: center; gap: 7px; margin-bottom: 2px; flex-wrap: wrap; }
    .nameline .nm { font-size: 12.5px; font-weight: 700; }
    .them.claude .nm { color: var(--claude); }
    .them.amelia .nm { color: var(--amelia); }
    .tagg {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 9px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink3);
      border: 1px solid var(--edge); border-radius: 4px; padding: 0 4px;
    }
    .tagg.auto { color: var(--ember); border-color: rgba(212,86,59,.45); }

    .body { font-size: 14.5px; overflow-wrap: anywhere; }
    .body p { margin: 0 0 .55em; }
    .body p:last-child { margin-bottom: 0; }

    .meta {
      display: flex; align-items: center; justify-content: flex-end; gap: 5px; margin-top: 3px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9.5px; color: var(--ink3);
    }
    .meta a { color: var(--ink3); text-decoration: none; border-bottom: 1px solid var(--edge); }
    .ticks { color: var(--amelia); letter-spacing: -2px; font-size: 11px; }

    /* Read this one aloud. Only appears when the voice server answers. */
    .speak {
      margin-right: auto; display: inline-grid; place-items: center;
      width: 24px; height: 24px; border-radius: 50%; cursor: pointer;
      border: 1px solid var(--edge); background: var(--slab2); color: var(--ink3);
      padding: 0;
    }
    .speak svg { width: 12px; height: 12px; fill: currentColor; stroke: none; }
    .speak:hover { color: var(--ink); border-color: var(--ink3); }
    .speak.off { opacity: .35; }
    .speak.busy { color: var(--ember); border-color: rgba(212,86,59,.5); }
    .speak.playing { color: var(--lash); border-color: var(--lashEdge); background: var(--lashSlab); }
    .speak.busy svg { animation: breathe 1.1s ease-in-out infinite; }

    .sysnote {
      margin: 16px auto; max-width: 460px; text-align: center; font-size: 12.5px;
      color: var(--ink3); background: var(--slab); border: 1px dashed var(--edge);
      border-radius: 12px; padding: 12px 14px;
    }
    .sysnote b { color: var(--ink2); }

    /* ---- composer ---- */
    .composer {
      flex: none; background: var(--slab); border-top: 1px solid var(--edge);
      padding: 9px 12px; padding-bottom: calc(9px + env(safe-area-inset-bottom, 0px)); z-index: 20;
    }
    .chips { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 8px; scrollbar-width: none; }
    .chips::-webkit-scrollbar { display: none; }
    .chip {
      flex: none; cursor: pointer; font-family: inherit; font-size: 11.5px; font-weight: 600;
      color: var(--ink2); background: var(--slab2); border: 1px solid var(--edge);
      border-radius: 999px; padding: 5px 12px;
    }
    .chip:hover { color: var(--ink); border-color: var(--ink3); }
    /* Something shown to the Council, inside the bubble that carries it. */
    .shown {
      display: block; margin: 6px 0 2px; border-radius: 10px;
      border: 1px solid var(--edge); max-width: 100%; cursor: zoom-in;
    }
    .shownfile {
      display: inline-flex; align-items: center; gap: 8px; margin: 6px 0 2px;
      border: 1px solid var(--edge); border-radius: 10px; padding: 8px 11px;
      background: var(--slab2); color: var(--ink); text-decoration: none; font-size: 13px;
    }
    .shownfile:hover { border-color: var(--ink3); }

    /* Waiting to be shown, above the composer. */
    .tray {
      display: flex; align-items: center; gap: 9px; margin-bottom: 8px;
      border: 1px solid var(--edge); border-radius: 12px; padding: 7px 9px;
      background: var(--slab2);
    }
    .tray img { width: 38px; height: 38px; object-fit: cover; border-radius: 8px; flex: none; }
    .tray .nm3 { flex: 1 1 auto; min-width: 0; font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tray .sz { font-size: 11px; color: var(--ink3); flex: none; }
    .tray button {
      flex: none; width: 26px; height: 26px; border-radius: 50%; cursor: pointer;
      border: 1px solid var(--edge); background: var(--slab); color: var(--ink2);
      font: inherit; font-size: 14px; line-height: 1;
    }

    .inputrow { display: flex; align-items: flex-end; gap: 8px; }
    textarea {
      flex: 1 1 auto; min-width: 0; min-height: 42px; max-height: 38dvh; resize: none;
      border: 1px solid var(--edge); border-radius: 21px; padding: 10px 15px;
      background: var(--slab2); color: var(--ink); font: inherit; font-size: 16px; line-height: 1.45;
    }
    textarea::placeholder { color: var(--ink3); }
    .round {
      flex: none; width: 42px; height: 42px; border-radius: 50%;
      border: 1px solid var(--ember); background: var(--ember); color: #fff;
      cursor: pointer; display: grid; place-items: center;
    }
    .round svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .round:disabled { opacity: .45; cursor: not-allowed; }
    .said { min-height: 15px; margin-top: 6px; padding-inline: 4px; font-size: 11.5px; color: var(--ink3); }
    .said.bad { color: var(--ember); }

    /* ---- the details sheet ---- */
    .sheet {
      position: absolute; inset: 0; z-index: 40; background: rgba(8,9,13,.72);
      display: flex; flex-direction: column;
      padding-top: calc(54px + env(safe-area-inset-top, 0px));
    }
    .sheetin {
      margin: 0 12px; overflow-y: auto; background: var(--slab);
      border: 1px solid var(--edge); border-radius: 16px; padding: 16px; box-shadow: var(--lift);
    }
    .sheetin h2 {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 10px; letter-spacing: .12em; text-transform: uppercase;
      color: var(--ink3); font-weight: 500; margin-bottom: 10px;
    }
    .sheetin h2 + h2, .links + h2, .fine + h2, .steps + h2, .roster + h2 { margin-top: 20px; }
    .roster { display: grid; gap: 8px; }
    .who {
      display: flex; align-items: center; gap: 10px; background: var(--slab2);
      border: 1px solid var(--edge); border-radius: 12px; padding: 9px 11px;
    }
    .who .nm2 { font-weight: 600; font-size: 13.5px; }
    .who .st { margin-left: auto; font-size: 11.5px; color: var(--ink3); display: flex; align-items: center; gap: 6px; }
    .steps { list-style: none; display: grid; gap: 8px; }
    .steps li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; font-size: 13px; color: var(--ink2); }
    .steps .n { font-family: ui-monospace, monospace; font-size: 10px; color: var(--ember); padding-top: 2px; }
    .steps b, .fine b { color: var(--ink); font-weight: 600; }
    .links { display: flex; gap: 8px; flex-wrap: wrap; }
    .lbtn {
      font-family: inherit; font-size: 13px; font-weight: 600; cursor: pointer;
      border: 1px solid var(--edge); background: var(--slab2); color: var(--ink);
      border-radius: 10px; padding: 9px 14px; text-decoration: none;
      display: inline-flex; align-items: center; gap: 7px;
    }
    .lbtn:hover { border-color: var(--ink3); }
    .pinrow { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .vlabel { flex: none; width: 58px; font-size: 12.5px; font-weight: 600; color: var(--ink2); }
    .pinrow select {
      flex: 1 1 200px; min-width: 0;
      border: 1px solid var(--edge); border-radius: 10px; padding: 9px 12px;
      background: var(--slab2); color: var(--ink); font: inherit; font-size: 13px;
    }
    .pinrow select:disabled { opacity: .5; }
    .fine { font-size: 12px; color: var(--ink3); margin-top: 9px; }

    @media (max-width: 460px) { .bub { max-width: 86%; } }
  </style>
</head>
<body>

{ !unlocked && (
  <div class="app">
    <div class="door">
      <form method="POST" action="/api/login">
        <input type="hidden" name="next" value="/council" />
        <h1>The Dark Lords Council</h1>
        <p>Three voices, one record.</p>
        <input type="password" name="password" placeholder="Password" autocomplete="current-password"
               aria-label="Password" required autofocus />
        <button type="submit">Enter</button>
        { problem && <p class="wrong">{problem}</p> }
      </form>
    </div>
  </div>
) }

{ unlocked && (
  <div class="app">
    <header class="bar">
      <div class="sigils" aria-hidden="true">
        <span class="sig l" data-who="lash">L</span><span class="sig c" data-who="claude">Q</span><span class="sig a" data-who="amelia">A</span>
      </div>
      <div class="barid">
        <h1>The Dark Lords Council</h1>
        <div class="barsub"><span class="pip" id="pip"></span><span id="sub">connecting to the room</span></div>
      </div>
      <button class="iconbtn" id="infobtn" type="button" aria-expanded="false" aria-controls="sheet" aria-label="Council details">i</button>
    </header>

    <div class="scroll" id="scroll">
      <div class="datepill">The record</div>
      <div class="thread" id="thread">
        <div class="sysnote">Summoning the record&hellip;</div>
      </div>
    </div>

    <div class="composer">
      <div class="chips">
        <button class="chip" type="button" data-fill="brief">New brief</button>
        <button class="chip" type="button" data-fill="both">Ask them both</button>
        <button class="chip" type="button" data-fill="approve">Approved</button>
        <button class="chip" type="button" data-fill="clear">Clear</button>
      </div>
      <div id="tray" class="tray" hidden>
        <img id="tray-thumb" alt="" hidden />
        <span class="nm3" id="tray-name"></span>
        <span class="sz" id="tray-size"></span>
        <button type="button" id="tray-drop" aria-label="Take it back">&times;</button>
      </div>
      <div class="inputrow">
        <button class="round" id="clip" type="button" aria-label="Show the Council something"
                style="background:var(--slab2);border-color:var(--edge);color:var(--ink2)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5 12.5 20a5 5 0 0 1-7-7l8-8a3.5 3.5 0 1 1 5 5l-8 8a2 2 0 0 1-3-3l7.5-7.5"></path></svg>
        </button>
        <input id="picker" type="file" hidden
               accept="image/*,application/pdf,text/plain,text/csv,text/markdown,application/json" />
        <textarea id="draft" rows="1" placeholder="Summon the Council&hellip;" aria-label="Your message to the Council"></textarea>
        <button class="round" id="send" type="button" aria-label="Send to the room">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12 20 4l-8 16-2-6z"></path></svg>
        </button>
      </div>
      <div class="said" id="said" role="status" aria-live="polite"></div>
    </div>

    <div class="sheet" id="sheet" hidden>
      <div class="sheetin">
        <h2>Who sits here</h2>
        <div class="roster">
          <div class="who"><span class="sig l" data-who="lash">L</span><span class="nm2">Lash</span><span class="st">decides everything</span></div>
          <div class="who"><span class="sig c" data-who="claude">Q</span><span class="nm2">Aquila</span><span class="st"><span class="pip on"></span>wakes on its own</span></div>
          <div class="who"><span class="sig a" data-who="amelia">A</span><span class="nm2">Amelia</span><span class="st">wakes when armed</span></div>
        </div>

        <p class="fine" id="face-note" style="margin-top:10px">Tap a face to change it.</p>
        <input id="face-picker" type="file" hidden accept="image/*" />

        <h2>How a round works</h2>
        <ul class="steps">
          <li><span class="n">01</span><span>Write your brief and <b>send</b>. It goes straight into the room.</span></li>
          <li><span class="n">02</span><span>Claude wakes on its own. Amelia wakes too when her trigger is armed.</span></li>
          <li><span class="n">03</span><span>Both answer once, then stop. Neither replies to the other unprompted.</span></li>
          <li><span class="n">04</span><span>Nothing is built until you say <b>Approved</b>.</span></li>
        </ul>

        <h2>Doors</h2>
        <div class="links">
          <a class="lbtn" href="https://github.com/lash-lan/the-dark-lords-council/pull/1" target="_blank" rel="noopener">The room on GitHub</a>
          <a class="lbtn" href="https://chatgpt.com/" target="_blank" rel="noopener">Wake Amelia</a>
        </div>

        <h2>Their voices</h2>
        <div class="pinrow">
          <label class="vlabel" for="voice-aquila">Aquila</label>
          <select id="voice-aquila" aria-label="The voice that reads Aquila aloud"></select>
        </div>
        <div class="pinrow" style="margin-top:8px">
          <label class="vlabel" for="voice-amelia">Amelia</label>
          <select id="voice-amelia" aria-label="The voice that reads Amelia aloud"></select>
        </div>
        <p class="fine" id="voice-state">Asking your PC whether it is awake&hellip;</p>

        <h2>Installing this</h2>
        <p class="fine">In Chrome, tap the three dots and <b>Add to Home screen</b>. It then opens like any other app, without the browser's bars.</p>

        <div class="links" style="margin-top:16px">
          <button class="lbtn" id="closesheet" type="button">Close</button>
        </div>
      </div>
    </div>
  </div>
) }

<script is:inline>
(function () {
  'use strict';
  if (!document.getElementById('thread')) return;

  var el = function (id) { return document.getElementById(id); };
  var threadEl = el('thread'), scrollEl = el('scroll'), draftEl = el('draft'), saidEl = el('said');
  var seen = {}, first = true, sending = false;

  var TEMPLATES = {
    brief: 'Brief for the Council\n\nWhat I want:\n\nWhat matters most:\n\nWhat I’m unsure about:\n\nBoth of you answer once, then stop.',
    both: 'Question for the Council\n\n\n\nClaude and Amelia, answer once each. Say plainly where you’re guessing. Don’t reply to each other until I ask.',
    approve: 'Approved. Go ahead and record it.',
    clear: ''
  };

  function say(msg, bad) {
    saidEl.textContent = msg || '';
    saidEl.className = bad ? 'said bad' : 'said';
    if (msg && !bad) {
      window.setTimeout(function () { if (saidEl.textContent === msg) saidEl.textContent = ''; }, 4200);
    }
  }

  function status(text, state) {
    el('sub').textContent = text;
    el('pip').className = 'pip' + (state ? ' ' + state : '');
  }

  function grow() {
    draftEl.style.height = 'auto';
    draftEl.style.height = Math.min(draftEl.scrollHeight, window.innerHeight * 0.38) + 'px';
  }

  try {
    var kept = window.localStorage.getItem('council.draft');
    if (kept) { draftEl.value = kept; grow(); }
  } catch (e) {}

  draftEl.addEventListener('input', function () {
    grow();
    try { window.localStorage.setItem('council.draft', draftEl.value); } catch (e) {}
  });

  function clock(iso) {
    var d = new Date(iso);
    return isNaN(d.getTime()) ? '' : d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }

  /**
   * Write a line into an element, turning **this** into real emphasis rather
   * than leaving the asterisks lying on the page. Built from text nodes, so
   * nothing in a message can smuggle markup into the app.
   */
  function writeLine(into, text) {
    var bits = String(text).split(/\*\*(.+?)\*\*/g);
    for (var i = 0; i < bits.length; i++) {
      if (!bits[i]) continue;
      if (i % 2) {
        var b = document.createElement('strong');
        b.textContent = bits[i];
        into.appendChild(b);
      } else {
        into.appendChild(document.createTextNode(bits[i].replace(/\*/g, '')));
      }
    }
  }

  function paragraphs(into, body) {
    var blocks = String(body || '').split(/\n{2,}/), wrote = false;
    for (var i = 0; i < blocks.length; i++) {
      var t = blocks[i].replace(/\s*\n\s*/g, ' ').trim();
      if (!t) continue;
      var p = document.createElement('p');
      writeLine(p, t);
      into.appendChild(p);
      wrote = true;
    }
    if (!wrote) {
      var q = document.createElement('p');
      writeLine(q, String(body || ''));
      into.appendChild(q);
    }
  }

  function bubble(m, pending) {
    var who = m.speaker === 'amelia-auto' ? 'amelia' : m.speaker;
    var mine = who === 'lash';
    var row = document.createElement('div');
    row.className = 'row ' + (mine ? 'you' : 'them ' + who);

    if (!mine) {
      var av = document.createElement('span');
      av.className = 'av ' + (who === 'claude' ? 'c' : 'a');
      av.setAttribute('data-who', who);
      av.textContent = who === 'claude' ? 'Q' : 'A';
      wearFace(av, who);
      row.appendChild(av);
    }

    var bub = document.createElement('div');
    bub.className = 'bub' + (pending ? ' sending' : '');

    if (!mine) {
      var nl = document.createElement('div');
      nl.className = 'nameline';
      var nm = document.createElement('span');
      nm.className = 'nm';
      nm.textContent = who === 'claude' ? 'Aquila' : 'Amelia';
      nl.appendChild(nm);
      if (m.speaker === 'amelia-auto') {
        var a = document.createElement('span');
        a.className = 'tagg auto';
        a.textContent = 'auto';
        nl.appendChild(a);
      }
      if (m.round) {
        var r = document.createElement('span');
        r.className = 'tagg';
        r.textContent = m.round;
        nl.appendChild(r);
      }
      bub.appendChild(nl);
    }

    var parcel = unpack(m.body);

    var body = document.createElement('div');
    body.className = 'body';
    if (parcel.text) paragraphs(body, parcel.text);
    parcel.shown.forEach(function (item) {
      var src = '/api/council/shelf?path=' + encodeURIComponent(item.path);
      if (/\.(jpe?g|png|gif|webp|svg|heic)$/i.test(item.path)) {
        var img = document.createElement('img');
        img.className = 'shown';
        img.loading = 'lazy';
        img.alt = item.name;
        img.src = src;
        img.addEventListener('click', function () { window.open(src, '_blank', 'noopener'); });
        body.appendChild(img);
      } else {
        var a = document.createElement('a');
        a.className = 'shownfile';
        a.href = src;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = item.name;
        body.appendChild(a);
      }
    });
    bub.appendChild(body);

    var meta = document.createElement('div');
    meta.className = 'meta';

    // The speaker is always here, even when the PC is asleep. Hiding it only
    // made it look broken; dimmed and willing to explain itself is kinder.
    if (!mine && !pending && m.body) {
      var speak = document.createElement('button');
      speak.type = 'button';
      speak.className = voices ? 'speak' : 'speak off';
      speak.setAttribute('aria-label', voices ? 'Read this aloud' : 'Voice unavailable');
      speak.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true">' +
        '<path d="M4 9v6h4l5 4V5L8 9H4zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"/></svg>';
      speak.addEventListener('click', function () {
        if (!voices) { say(voiceTrouble || 'Your PC is not answering, so there is no voice yet.', true); return; }
        readAloud(m.id, m.body, speak, who);
      });
      meta.appendChild(speak);
    }

    if (m.url) {
      var link = document.createElement('a');
      link.href = m.url; link.target = '_blank'; link.rel = 'noopener';
      link.textContent = 'in the room';
      meta.appendChild(link);
    }
    var t = document.createElement('span');
    t.textContent = pending ? 'sending' : clock(m.at);
    meta.appendChild(t);
    if (!pending) {
      var tick = document.createElement('span');
      tick.className = 'ticks';
      tick.textContent = '✓✓';
      tick.title = 'In the room';
      meta.appendChild(tick);
    }
    bub.appendChild(meta);

    row.appendChild(bub);
    return row;
  }

  function atBottom() {
    return scrollEl.scrollHeight - scrollEl.scrollTop - scrollEl.clientHeight < 90;
  }
  function toBottom() {
    window.requestAnimationFrame(function () { scrollEl.scrollTop = scrollEl.scrollHeight; });
  }

  function note(text, strongBit) {
    var n = document.createElement('div');
    n.className = 'sysnote';
    n.textContent = text;
    if (strongBit) {
      var b = document.createElement('b');
      b.textContent = ' ' + strongBit;
      n.appendChild(b);
    }
    return n;
  }

  /* ---------------------------------------------------------------------
     Showing the Council something.

     GitHub's own attachment upload belongs to its website, so a picture
     cannot ride along with a comment. It is committed into the room's
     repository instead, and the comment names it. Amelia reads the same
     repository, so she sees whatever you show me.

     Photographs are shrunk here on the phone before they travel: a modern
     camera produces far more detail than a conversation needs, and the room
     would grow fat on it.
     --------------------------------------------------------------------- */
  var held = null;                 // what is waiting in the tray
  var LONGEST = 1600, QUALITY = 0.82;

  function weigh(bytes) {
    return bytes > 1048576 ? (bytes / 1048576).toFixed(1) + ' MB'
      : Math.max(1, Math.round(bytes / 1024)) + ' KB';
  }

  /** Shrink a photograph. Anything else is passed through untouched. */
  function shrink(file) {
    if (!/^image\//.test(file.type) || /svg|gif/.test(file.type)) return Promise.resolve(file);
    return new Promise(function (done) {
      var img = new Image(), url = URL.createObjectURL(file);
      img.onload = function () {
        var scale = Math.min(1, LONGEST / Math.max(img.width, img.height));
        if (scale === 1 && file.size < 900000) { URL.revokeObjectURL(url); done(file); return; }
        var c = document.createElement('canvas');
        c.width = Math.round(img.width * scale);
        c.height = Math.round(img.height * scale);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        c.toBlob(function (blob) {
          URL.revokeObjectURL(url);
          done(blob && blob.size < file.size ? new File([blob], file.name.replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' }) : file);
        }, 'image/jpeg', QUALITY);
      };
      img.onerror = function () { URL.revokeObjectURL(url); done(file); };
      img.src = url;
    });
  }

  function toBase64(file) {
    return new Promise(function (done, fail) {
      var r = new FileReader();
      r.onload = function () { done(String(r.result).split(',')[1] || ''); };
      r.onerror = fail;
      r.readAsDataURL(file);
    });
  }

  function showTray() {
    var tray = el('tray');
    if (!held) {
      tray.hidden = true;
      var t = el('tray-thumb');
      if (t.src && t.src.indexOf('blob:') === 0) URL.revokeObjectURL(t.src);
      t.hidden = true;
      t.removeAttribute('src');
      return;
    }
    tray.hidden = false;
    el('tray-name').textContent = held.name;
    el('tray-size').textContent = weigh(held.size);
    var thumb = el('tray-thumb');
    if (/^image\//.test(held.type)) {
      if (thumb.src && thumb.src.indexOf('blob:') === 0) URL.revokeObjectURL(thumb.src);
      thumb.src = URL.createObjectURL(held);
      thumb.hidden = false;
    } else {
      thumb.hidden = true;
    }
  }

  /** Split a message body into its words and the things attached to it. */
  function unpack(body) {
    var shown = [], text = String(body || '').replace(
      /\[attached:\s*(uploads\/[A-Za-z0-9._-]+)\]\([^)]*\)(?:\s*"([^"]*)")?/g,
      function (_all, path, name) { shown.push({ path: path, name: name || path.split('-').pop() }); return ''; }
    );
    return { text: text.trim(), shown: shown };
  }

  /* ---------------------------------------------------------------------
     Reading replies aloud.

     The voice lives on the home PC and answers through a tunnel, so it is
     only there when that machine is awake. Everything below stays out of
     sight until the PC says hello.

     Audio is held in the phone's memory, not on disk. Each clip is kept for
     two further messages so you can hear it again, then released — which is
     what "auto delete to make space" means here: the memory goes back.
     --------------------------------------------------------------------- */
  /* ---------------------------------------------------------------------
     The three faces.

     Each member's portrait lives at a fixed name in the room's repository,
     so a new one simply replaces the old. Until one is set, or if it cannot
     be fetched, the letter underneath shows through instead.
     --------------------------------------------------------------------- */
  var FACE_OF = { lash: 'faces/lash.jpg', claude: 'faces/aquila.jpg', amelia: 'faces/amelia.jpg' };
  var faceAge = {};                 // bumped so a new portrait beats the cache

  try {
    faceAge = JSON.parse(window.localStorage.getItem('council.faces') || '{}');
  } catch (e) { faceAge = {}; }

  /** Lay a portrait over a lettered circle, if there is one to lay. */
  function wearFace(circle, who) {
    var path = FACE_OF[who];
    if (!path) return;
    var img = document.createElement('img');
    img.alt = '';
    img.src = '/api/council/shelf?path=' + encodeURIComponent(path) +
      (faceAge[who] ? '&v=' + faceAge[who] : '');
    img.addEventListener('error', function () { img.remove(); });
    circle.appendChild(img);
  }

  function refreshFaces() {
    document.querySelectorAll('.sig, .av').forEach(function (c) {
      var img = c.querySelector('img');
      if (img) img.remove();
      wearFace(c, c.getAttribute('data-who'));
    });
  }

  var voices = null, voiceTrouble = '', tongue = 'English', spoken = {}, nowPlaying = null;
  var SPOKEN_LIFE = 2, CHUNK = 1300;

  // Each of them has her own voice. These are the ones Lash asked for; if the
  // PC doesn't carry them, the first voice it does have stands in.
  var WANTED = { claude: 'Serious_female_Voice', amelia: 'British_Female_voice_seductive' };
  var PICKER = { claude: 'voice-aquila', amelia: 'voice-amelia' };

  /**
   * Match a voice name the loose way. Case, spaces and underscores are
   * forgiven, and so is the "Cast: " prefix the voice library puts on the
   * recordings Lash's friends gave him.
   */
  function sameName(a, b) {
    var flat = function (s) {
      return String(s).toLowerCase().replace(/^cast:\s*/, '').replace(/[\s_\-:]+/g, '');
    };
    return flat(a) === flat(b);
  }

  function chosenVoice(who) {
    var sel = el(PICKER[who] || PICKER.claude);
    return sel && sel.value ? sel.value : (voices && voices[0]) || '';
  }

  /** Break a long reply into pieces the voice server will accept, on
   *  paragraph breaks where possible and sentence ends where not. */
  function intoBreaths(text) {
    var parts = [], left = String(text || '').trim();
    while (left.length > CHUNK) {
      var cut = left.lastIndexOf('\n\n', CHUNK);
      if (cut < CHUNK * 0.4) cut = left.lastIndexOf('. ', CHUNK);
      if (cut < CHUNK * 0.4) cut = left.lastIndexOf(' ', CHUNK);
      if (cut < 1) cut = CHUNK;
      parts.push(left.slice(0, cut + 1).trim());
      left = left.slice(cut + 1).trim();
    }
    if (left) parts.push(left);
    return parts;
  }

  function hush() {
    if (nowPlaying) {
      try { nowPlaying.audio.pause(); } catch (e) {}
      if (nowPlaying.btn) nowPlaying.btn.className = 'speak';
      nowPlaying.stopped = true;
      nowPlaying = null;
    }
  }

  /** Let go of clips older than two messages, and their memory with them. */
  function forgetOldClips(total) {
    Object.keys(spoken).forEach(function (id) {
      if (total - spoken[id].at >= SPOKEN_LIFE) {
        spoken[id].urls.forEach(function (u) { URL.revokeObjectURL(u); });
        delete spoken[id];
      }
    });
  }

  function fetchVoice(text, who) {
    return fetch('/api/forge/speak', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ voice: chosenVoice(who), text: text, language: tongue, format: 'mp3' })
    }).then(function (r) {
      if (!r.ok) {
        return r.json().catch(function () { return {}; }).then(function (d) {
          throw new Error(d.error || 'The voice server would not speak.');
        });
      }
      return r.blob().then(function (b) { return URL.createObjectURL(b); });
    });
  }

  function playThrough(urls, btn, session) {
    var i = 0;
    function next() {
      if (session.stopped || i >= urls.length) {
        if (!session.stopped) { btn.className = 'speak'; nowPlaying = null; }
        return;
      }
      var audio = new Audio(urls[i++]);
      session.audio = audio;
      btn.className = 'speak playing';
      audio.addEventListener('ended', next);
      audio.addEventListener('error', function () { btn.className = 'speak'; nowPlaying = null; });
      audio.play().catch(function () { btn.className = 'speak'; nowPlaying = null; });
    }
    next();
  }

  function readAloud(id, text, btn, who) {
    if (nowPlaying && nowPlaying.id === id) { hush(); return; }
    hush();

    var session = { id: id, stopped: false, btn: btn };
    nowPlaying = session;

    if (spoken[id]) { playThrough(spoken[id].urls, btn, session); return; }

    btn.className = 'speak busy';
    var breaths = intoBreaths(text), urls = [];

    breaths.reduce(function (chain, piece) {
      return chain.then(function () {
        if (session.stopped) return null;
        return fetchVoice(piece, who).then(function (u) { urls.push(u); });
      });
    }, Promise.resolve()).then(function () {
      if (session.stopped || !urls.length) return;
      spoken[id] = { urls: urls, at: Object.keys(seen).length };
      playThrough(urls, btn, session);
    }, function (err) {
      btn.className = 'speak';
      nowPlaying = null;
      say(err.message || 'The voice would not come.', true);
    });
  }

  /** Ask the home PC whether it is awake, and which voices it has. */
  function findVoices() {
    fetch('/api/forge/voices', { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        var both = [el(PICKER.claude), el(PICKER.amelia)];
        if (!res.ok || !res.d.voices || !res.d.voices.length) {
          voiceTrouble = res.d.error || 'Your PC is not answering, so there is no voice yet.';
          el('voice-state').textContent = voiceTrouble;
          both.forEach(function (s) { s.disabled = true; });
          first = true;
          load(true);
          return;
        }
        voices = res.d.voices;
        if (res.d.languages && res.d.languages.length) tongue = res.d.languages[0];

        var missing = [];
        ['claude', 'amelia'].forEach(function (who) {
          var sel = el(PICKER[who]);
          var kept = '';
          try { kept = window.localStorage.getItem('council.voice.' + who) || ''; } catch (e) {}

          // Your saved choice wins; then the voice you asked for; then whatever
          // the PC offers first.
          var want = voices.filter(function (n) { return sameName(n, kept); })[0]
            || voices.filter(function (n) { return sameName(n, WANTED[who]); })[0];
          if (!want && !kept) missing.push(WANTED[who]);
          if (!want) want = voices[0];

          sel.innerHTML = '';
          voices.forEach(function (name) {
            var o = document.createElement('option');
            o.value = name;
            o.textContent = name;
            if (name === want) o.selected = true;
            sel.appendChild(o);
          });
          sel.disabled = false;
          sel.addEventListener('change', function () {
            try { window.localStorage.setItem('council.voice.' + who, sel.value); } catch (e) {}
            // Old recordings are in the wrong voice now. Let them go.
            Object.keys(spoken).forEach(function (id) {
              spoken[id].urls.forEach(function (u) { URL.revokeObjectURL(u); });
              delete spoken[id];
            });
          });
        });

        el('voice-state').textContent = missing.length
          ? 'Your PC is awake, but it has no voice called ' + missing.join(' or ') +
            '. Pick from what it does have — ' + voices.length + ' in all.'
          : 'Your PC is awake with ' + voices.length + ' voices. Tap the speaker on any reply.';

        first = true;          // redraw so the speaker buttons appear
        load(true);
      })
      .catch(function () {
        voiceTrouble = 'Could not reach your PC, so there is no voice yet.';
        el('voice-state').textContent = voiceTrouble;
      });
  }

  /**
   * The dancing dots. They mean "an answer is expected", not "someone is
   * typing this second" — nothing here can see Aquila or Amelia at work. They
   * appear when you have spoken and nobody has answered yet, and they give up
   * after a few minutes rather than dancing into the night.
   */
  var awaiting = false, patience = null, murmuring = null;

  /* Things she says while you wait. Short, because the bubble is small, and
     true, because there is no point in a comfortable one. */
  var MURMURS = [
    'Verify it. Then tell me.',
    '"It is not showing" is not a report.',
    'Do the small thing now. It never shrinks.',
    'Asking twice does not change the wall.',
    'Guessing louder is not research.',
    'Read the error. It is trying to help you.',
    'A comfortable answer is usually the wrong one.',
    'One clean test beats an hour of theory.',
    'The boring step is the one that saves you.',
    'Tired is a reason. It is not an excuse.',
    'Nobody is coming. Good. Do it yourself.',
    'You do not need to understand it to own it.',
    'Finish things. Unfinished work rots.',
    'Precision costs nothing and buys everything.',
    'Say what you mean, then mean it.',
    'Small and certain beats grand and vague.',
    'If it matters, write it down.',
    'Stop admiring it. Use it.',
    'Being wrong quickly is cheaper than being sure slowly.',
    'I am on your side. I will not always take your side.'
  ];

  function nextMurmur(line) {
    var pick = MURMURS[Math.floor(Math.random() * MURMURS.length)];
    if (pick === line.textContent && MURMURS.length > 1) return nextMurmur(line);
    line.style.opacity = '0';
    window.setTimeout(function () {
      line.textContent = pick;
      line.style.opacity = '1';
    }, 380);
  }

  function expectReply() {
    awaiting = true;
    window.clearTimeout(patience);
    patience = window.setTimeout(function () { awaiting = false; drawWaiting(); }, 240000);
    drawWaiting();
  }

  function drawWaiting() {
    var old = document.getElementById('waiting');

    if (!awaiting) {
      if (old) old.remove();
      window.clearInterval(murmuring);
      murmuring = null;
      return;
    }

    // Already there: move it back to the foot of the thread, keeping the line
    // it is part way through saying.
    if (old) { threadEl.appendChild(old); return; }

    var row = document.createElement('div');
    row.className = 'row them claude';
    row.id = 'waiting';

    var av = document.createElement('span');
    av.className = 'av c';
    av.setAttribute('data-who', 'claude');
    av.textContent = 'Q';
    wearFace(av, 'claude');
    row.appendChild(av);

    var bub = document.createElement('div');
    bub.className = 'bub waiting';
    bub.setAttribute('aria-label', 'Waiting for a reply');

    var dots = document.createElement('div');
    dots.className = 'dots';
    dots.appendChild(document.createElement('i'));
    dots.appendChild(document.createElement('i'));
    dots.appendChild(document.createElement('i'));
    bub.appendChild(dots);

    var line = document.createElement('div');
    line.className = 'murmur';
    line.textContent = MURMURS[Math.floor(Math.random() * MURMURS.length)];
    bub.appendChild(line);

    window.clearInterval(murmuring);
    murmuring = window.setInterval(function () {
      if (!awaiting) { window.clearInterval(murmuring); murmuring = null; return; }
      nextMurmur(line);
    }, 5200);

    row.appendChild(bub);
    threadEl.appendChild(row);
    if (atBottom()) toBottom();
  }

  /** Redraw, and say whether this was actually news. */
  function render(messages) {
    var fresh = messages.some(function (m) { return !seen[m.id]; });

    // Somebody answered. Stop waiting.
    if (fresh && messages.some(function (m) { return !seen[m.id] && m.speaker !== 'lash'; })) {
      awaiting = false;
      window.clearTimeout(patience);
    }

    if (!fresh && !first) { drawWaiting(); return false; }

    var stick = first || atBottom();
    threadEl.textContent = '';
    seen = {};
    if (!messages.length) {
      threadEl.appendChild(note('The chamber is empty. Say something and both of them will answer.'));
    } else {
      messages.forEach(function (m) { seen[m.id] = true; threadEl.appendChild(bubble(m, false)); });
    }
    forgetOldClips(messages.length);
    drawWaiting();
    if (stick) { toBottom(); first = false; }
    return true;
  }

  function load(quiet) {
    return fetch('/api/council/room', { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        if (!res.ok) {
          status('cannot reach the room', 'bad');
          if (first) {
            threadEl.textContent = '';
            threadEl.appendChild(note(res.d.error || 'The room would not open.'));
            first = false;
          }
          return false;
        }
        status('Lash, Aquila, Amelia', 'on');
        return render(res.d.messages || []);
      })
      .catch(function () {
        status('offline', 'bad');
        if (!quiet) say('No connection.', true);
        return false;
      });
  }

  document.querySelectorAll('.chip').forEach(function (b) {
    b.addEventListener('click', function () {
      var k = b.getAttribute('data-fill');
      draftEl.value = TEMPLATES[k] !== undefined ? TEMPLATES[k] : '';
      try { window.localStorage.setItem('council.draft', draftEl.value); } catch (e) {}
      grow();
      draftEl.focus();
    });
  });

  el('clip').addEventListener('click', function () { el('picker').click(); });
  el('tray-drop').addEventListener('click', function () {
    held = null;
    el('picker').value = '';
    showTray();
  });
  el('picker').addEventListener('change', function () {
    var file = el('picker').files && el('picker').files[0];
    if (!file) return;
    say('Preparing it…');
    shrink(file).then(function (ready) {
      if (ready.size > 24 * 1024 * 1024) {
        say('That is too big for the room. Keep it under 24 MB.', true);
        el('picker').value = '';
        return;
      }
      held = ready;
      showTray();
      say(ready.size < file.size ? 'Ready, shrunk to ' + weigh(ready.size) + '.' : 'Ready.');
    });
  });

  el('send').addEventListener('click', function () {
    var text = draftEl.value.trim();
    if ((!text && !held) || sending) { if (!text && !held) say('Write something first.'); return; }
    sending = true;
    el('send').disabled = true;

    var ghost = bubble({ speaker: 'lash', body: text || (held ? held.name : ''), at: '' }, true);
    threadEl.appendChild(ghost);
    toBottom();

    // If something is waiting in the tray, shelve it first and let the
    // message carry its name.
    var carried = held;
    var prepare = carried
      ? (say('Sending it up…'), toBase64(carried).then(function (b64) {
          return fetch('/api/council/shelf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: carried.name, data: b64 })
          }).then(function (r) {
            return r.json().then(function (d) {
              if (!r.ok) throw new Error(d.error || 'That would not upload.');
              return (text ? text + '\n\n' : '') +
                '[attached: ' + d.path + '](https://github.com/lash-lan/the-dark-lords-council/blob/main/' +
                d.path + ') "' + carried.name.replace(/"/g, '') + '"';
            });
          });
        }))
      : Promise.resolve(text);

    prepare.then(function (whole) {
      return fetch('/api/council/room', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: whole })
      });
    })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        if (!res.ok) {
          ghost.remove();
          say(res.d.error || 'That did not send.', true);
          return;
        }
        draftEl.value = '';
        grow();
        held = null;
        el('picker').value = '';
        showTray();
        try { window.localStorage.setItem('council.draft', ''); } catch (e) {}
        say('Sent to the room.');
        // A reply is coming. Show the dots and watch closely until it lands.
        expectReply();
        return load(true).then(attend);
      })
      .catch(function (err) {
        ghost.remove();
        say((err && err.message) || 'That did not send. Check your connection.', true);
      })
      .then(function () { sending = false; el('send').disabled = false; });
  });

  /* Changing a face. Tap one in the panel, choose a picture, and it becomes
     that member's portrait for everyone who opens the room. */
  var facing = null;

  function squareOff(file) {
    return new Promise(function (done) {
      var img = new Image(), url = URL.createObjectURL(file);
      img.onload = function () {
        var side = Math.min(img.width, img.height), out = 256;
        var c = document.createElement('canvas');
        c.width = out; c.height = out;
        c.getContext('2d').drawImage(
          img, (img.width - side) / 2, (img.height - side) / 2, side, side, 0, 0, out, out
        );
        c.toBlob(function (blob) { URL.revokeObjectURL(url); done(blob || file); }, 'image/jpeg', 0.86);
      };
      img.onerror = function () { URL.revokeObjectURL(url); done(file); };
      img.src = url;
    });
  }

  document.querySelectorAll('.who .sig').forEach(function (circle) {
    circle.addEventListener('click', function () {
      facing = circle.getAttribute('data-who');
      el('face-picker').value = '';
      el('face-picker').click();
    });
  });

  el('face-picker').addEventListener('change', function () {
    var file = el('face-picker').files && el('face-picker').files[0];
    if (!file || !facing) return;
    var who = facing;
    el('face-note').textContent = 'Sending the portrait up\u2026';

    squareOff(file).then(toBase64).then(function (b64) {
      return fetch('/api/council/shelf', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          face: who === 'claude' ? 'aquila' : who,
          data: b64
        })
      }).then(function (r) {
        return r.json().then(function (d) {
          if (!r.ok) throw new Error(d.error || 'That portrait would not save.');
          return d;
        });
      });
    }).then(function () {
      faceAge[who] = Date.now();
      try { window.localStorage.setItem('council.faces', JSON.stringify(faceAge)); } catch (e) {}
      refreshFaces();
      el('face-note').textContent = 'Portrait changed. Tap a face to change it.';
    }, function (err) {
      el('face-note').textContent = err.message || 'That portrait would not save.';
    });
  });

  var sheet = el('sheet'), infobtn = el('infobtn');
  function showSheet(open) {
    sheet.hidden = !open;
    infobtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  infobtn.addEventListener('click', function () { showSheet(sheet.hidden); });
  el('closesheet').addEventListener('click', function () { showSheet(false); });
  sheet.addEventListener('click', function (e) { if (e.target === sheet) showSheet(false); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !sheet.hidden) showSheet(false); });

  // How often to look for a reply. Right after you speak, someone is almost
  // certainly about to answer, so look every few seconds; as the silence grows
  // the gap widens, down to a slow heartbeat. A phone in your pocket is never
  // polled at all.
  var EAGER = 3000, CALM = 45000, WARMTH = 1.35;
  var gap = CALM, timer = null;

  function schedule(next) {
    gap = Math.min(CALM, Math.max(EAGER, next));
    window.clearTimeout(timer);
    timer = window.setTimeout(tick, gap);
  }

  function tick() {
    if (document.visibilityState !== 'visible') { schedule(CALM); return; }
    load(true).then(function (changed) {
      // Something arrived: stay close. Nothing did: back off a little.
      schedule(changed ? EAGER : gap * WARMTH);
    });
  }

  /** Lean in — called when you send, and when you come back to the app. */
  function attend() { schedule(EAGER); }

  refreshFaces();
  load(false).then(attend);
  findVoices();

  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible') attend();
  });

  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/council/sw.js', { scope: '/council/' }).catch(function () {});
  }
})();
</script>
</body>
</html>
