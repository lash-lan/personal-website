---
import SiteHeader from '../../../../components/SiteHeader.astro';
import MoodAtmosphere from '../../../../components/MoodAtmosphere.astro';
import ReadAloud from '../../../../components/ReadAloud.astro';
import { squireTracks } from '../../../../data/narration.js';
import AgeGate from '../../../../components/AgeGate.astro';
import story from '../../../../data/the-squire.json';

const BASE = '/sagas/red-rangers/the-squire';

export function getStaticPaths() {
  return story.chapters.map((c, i) => ({
    params: { chapter: c.slug },
    props: {
      chapter: c,
      index: i,
      prev: i > 0 ? story.chapters[i - 1] : null,
      next: i < story.chapters.length - 1 ? story.chapters[i + 1] : null,
    },
  }));
}

const { chapter, index, prev, next } = Astro.props;
const total = story.chapters.length;

const esc = (s) => String(s)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// The chapter is cut into mood zones. The atmosphere engine watches these as
// the reader scrolls and shifts the colour, the drifting motes and the ambient
// sound to match, which is why the sound changes as the story turns.
const zones = chapter.zones?.length
  ? chapter.zones
  : [{ mood: chapter.mood || 'dread', start: 0, end: chapter.paras.length - 1 }];

// ─── THE PLATE ───
// The artwork was named for the chapter after the one it actually shows, so
// each chapter takes the next one's picture: chapter one gets the gate scene
// it was always of. The final chapter has none left and closes on the closing
// plate instead.
const plate = story.chapters[index + 1]?.plate ?? null;

// The picture belongs where the scene happens, not stacked above the title.
// Chapters name their moment; the rest fall at their first turn of mood,
// which is where the telling changes anyway.
const PLATE_AFTER = {
  'the-verdant-gate': 35,   // he steps into the mud and every ranger looks up
};
function plateAfter() {
  if (PLATE_AFTER[chapter.slug] != null) return PLATE_AFTER[chapter.slug];
  const n = chapter.paras.length;
  const turn = zones.length > 1 ? zones[1].start : Math.round(n * 0.34);
  return Math.min(Math.max(turn, Math.round(n * 0.18)), Math.round(n * 0.55));
}
const at = plate ? plateAfter() : -1;

const figure = plate
  ? `<figure class="scene" aria-label="${esc(`Plate for ${chapter.title}`)}">` +
    `<img src="/images/sagas/the-squire/${plate}" alt="" loading="lazy" decoding="async" />` +
    `</figure>`
  : '';

const body = zones.map((z) => {
  const inner = chapter.paras.slice(z.start, z.end + 1)
    .map((p, k) => {
      const i = z.start + k;
      return `<p>${esc(p.x)}</p>` + (i === at ? figure : '');
    }).join('');
  return `<section class="zone" data-mood="${z.mood}">${inner}</section>`;
}).join('');

const openingMood = zones[0].mood;
const minutes = Math.max(1, Math.round(chapter.words / 230));

// Real narration if it has been generated; otherwise the browser reads it.
const tracks = squireTracks(chapter.slug);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{chapter.title} | The Squire | LASH</title>
  <meta name="description" content={`Chapter ${chapter.numeral} of The Squire, the first telling of the Red Rangers.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Cormorant+SC:wght@300;400&display=swap" rel="stylesheet" />

  <style is:global>
    /* The prose. MoodAtmosphere supplies the colour variables these use, and
       swaps them as the reader passes from one zone into the next. */
    body {
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 19px;
      line-height: 1.78;
      color: var(--text);
      transition: color 1400ms ease;
      overflow-x: hidden;
    }
    main { position: relative; z-index: 1; }

    .chapter { max-width: 40rem; margin: 0 auto; padding: 5.5rem 1.6rem 0; }
    .chapter-head { text-align: center; margin-bottom: 2.6rem; }
    /* ─── THE SCENE ───
       The plate stands in the story where the scene happens, shown whole
       rather than cropped into a frame, wider than the column so the telling
       opens out around it. Its edges are dissolved into the dark instead of
       being bordered, and it rises into place as the reader reaches it. */
    .scene {
      margin: 3.2rem auto;
      width: min(92vw, 34rem);
      opacity: 0;
      transform: translateY(26px) scale(1.02);
      transition: opacity 1.5s cubic-bezier(.16,.8,.24,1), transform 1.8s cubic-bezier(.16,.8,.24,1);
    }
    .scene.is-seen { opacity: 1; transform: none; }
    .scene img {
      display: block;
      width: 100%; height: auto;
      max-height: 82vh; object-fit: contain;
      filter: saturate(.82) contrast(1.03) brightness(.94);
      -webkit-mask-image: radial-gradient(118% 108% at 50% 46%, #000 62%, transparent 100%);
      mask-image: radial-gradient(118% 108% at 50% 46%, #000 62%, transparent 100%);
    }
    @media (prefers-reduced-motion: reduce) {
      .scene { opacity: 1; transform: none; transition: none; }
    }
    .chapter-num {
      font-family: 'Cormorant SC', Georgia, serif;
      font-size: .66rem; letter-spacing: .34em; text-transform: uppercase;
      color: var(--accent); display: block; margin-bottom: .7rem;
      transition: color 1400ms ease;
    }
    .chapter-title {
      font-family: 'Cinzel', Georgia, serif; font-weight: 500;
      font-size: clamp(1.5rem, 5vw, 2.3rem); line-height: 1.18;
      color: var(--text-bright); text-wrap: balance;
      transition: color 1400ms ease;
    }
    .chapter-meta {
      font-family: 'Cormorant SC', Georgia, serif;
      font-size: .6rem; letter-spacing: .24em; text-transform: uppercase;
      opacity: .55; margin-top: .8rem;
    }

    .chapter p {
      margin-bottom: 1.15rem;
      letter-spacing: var(--track);
      transition: letter-spacing var(--line-dur) ease;
    }
    .chapter .zone:first-of-type p:first-of-type::first-letter {
      font-family: 'Cinzel', Georgia, serif;
      font-size: 3.1em; float: left; line-height: .82;
      padding: .06em .1em 0 0; color: var(--text-bright);
    }

    .closing-plate {
      margin: 3.5rem auto 0;
      width: min(92vw, 34rem);
    }
    .closing-plate img {
      display: block; width: 100%; height: auto;
      max-height: 82vh; object-fit: contain;
      filter: saturate(.82) contrast(1.03) brightness(.94);
      -webkit-mask-image: radial-gradient(118% 108% at 50% 46%, #000 62%, transparent 100%);
      mask-image: radial-gradient(118% 108% at 50% 46%, #000 62%, transparent 100%);
    }

    .chapter-nav {
      max-width: 40rem; margin: 4rem auto 0; padding: 2.2rem 1.6rem 5rem;
      border-top: 1px solid rgba(180, 69, 63, .2);
      display: flex; flex-wrap: wrap; gap: .7rem; align-items: center;
    }
    .chapter-nav a, .chapter-nav span {
      font-family: 'Cormorant SC', Georgia, serif;
      font-size: .62rem; letter-spacing: .2em; text-transform: uppercase;
      padding: .7rem 1.2rem; border-radius: 999px;
      border: 1px solid rgba(180, 69, 63, .3);
      color: var(--text); text-decoration: none;
      transition: color .25s, border-color .25s;
    }
    .chapter-nav a:hover { color: var(--text-bright); border-color: rgba(180, 69, 63, .75); }
    .chapter-nav .spacer { flex: 1; border: none; padding: 0; }

    @media (max-width: 640px) {
      body { font-size: 18px; }
      .chapter { padding-left: 1.3rem; padding-right: 1.3rem; }
      .closing-plate { width: calc(100% - 2.6rem); }
    }
  </style>
</head>
<body>

<AgeGate returnTo={BASE} />

<MoodAtmosphere initial={openingMood} />

<SiteHeader back={{ href: BASE, label: "The Squire" }} current="sagas"
  accent="#b4453f" dim="#7d5a54" bright="#f2ded6" bg="rgba(11,5,5,0.82)" />

<!-- Scoped to the zones, not to .chapter p. The header carries a metadata
     line that is also a paragraph, and the reader would speak it aloud. -->
<ReadAloud selector=".chapter .zone p" title={chapter.title} tracks={tracks} />

<main>
  <article class="chapter">
    <header class="chapter-head">
      <span class="chapter-num">Chapter {chapter.numeral} of {total}</span>
      <h1 class="chapter-title">{chapter.title}</h1>
      <p class="chapter-meta">The Squire &middot; Red Rangers &middot; about {minutes} min</p>
    </header>

    <Fragment set:html={body} />
  </article>

  {!next && story.closingPlate && (
    <figure class="closing-plate scene" aria-label="The closing plate of The Squire">
      <img src={`/images/sagas/the-squire/${story.closingPlate}`} alt="" loading="lazy" decoding="async" />
    </figure>
  )}

  <nav class="chapter-nav" aria-label="Chapters">
    {prev
      ? <a href={`${BASE}/${prev.slug}`} title={prev.title}
           aria-label={`Previous chapter: ${prev.title}`}>&larr; Previous Chapter</a>
      : <a href={BASE}>&larr; Contents</a>}
    <span class="spacer"></span>
    <a href={BASE}>All chapters</a>
    {next && <a href={`${BASE}/${next.slug}`} title={next.title}
                aria-label={`Next chapter: ${next.title}`}>Next Chapter &rarr;</a>}
  </nav>
</main>

<script>
  // The plate rises out of the dark as the reader arrives at its scene, once.
  const scenes = document.querySelectorAll('.scene');
  if (!('IntersectionObserver' in window)) {
    scenes.forEach((s) => s.classList.add('is-seen'));
  } else {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        en.target.classList.add('is-seen');
        io.unobserve(en.target);
      }
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    scenes.forEach((s) => io.observe(s));
  }
</script>

</body>
</html>
