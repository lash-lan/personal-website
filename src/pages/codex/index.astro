---
import SectionLayout from '../../layouts/SectionLayout.astro';
import { AGES, AGE_ART } from '../../data/content.js';

// Only the Foundation Age chronicle has been compiled so far.
const COMPILED = new Set(['foundation-age']);
---
<SectionLayout
  title="Codex | LASH"
  description="The historical chronicle of the LASH universe, recorded age by age."
  theme="codex"
  current="codex"
  eyebrow="Historical Chronicle"
  heading="Codex"
  tagline="A record kept where fire cannot reach. Titans, mortals, realms, and relics, age by age."
>
  <div class="wrap">
    <div class="grid grid-3">
      {AGES.map((age) => {
        const compiled = COMPILED.has(age.slug);
        return (
          <a
            href={`/codex/${age.slug}`}
            class:list={['tile', 'hall', 'reveal', { 'is-soon': !compiled, 'no-art': !AGE_ART[age.slug] }]}
          >
            {AGE_ART[age.slug] && (
              <span class="hall-plate">
                <img src={AGE_ART[age.slug]} alt="" loading="lazy" decoding="async" width="640" height="480" />
              </span>
            )}
            <span class="hall-caption">
              <span class="tile-eyebrow">Book {age.numeral}</span>
              <span class="tile-title">{age.name}</span>
            </span>
            {age.blurb && <p class="tile-blurb">{age.blurb}</p>}
            <span class="tile-meta">
              {compiled ? 'Compiled' : age.comingSoon ? 'Coming Soon' : 'Not yet compiled'}
            </span>
          </a>
        );
      })}
    </div>
  </div>
</SectionLayout>
