---
import SectionLayout from '../../../layouts/SectionLayout.astro';
import { CARDS, TIERS, TIER_ORDER, KEYWORDS, artOf, numberOf } from '../../../data/cards.js';

// Every card is rendered at build time and the filters only hide and show
// them. Nothing here is built by a script, so the scoped styles below reach
// all of it — which is the trap the battlefield fell into.
const order = { character: 0, spell: 1 };
const cards = [...CARDS].sort((a, b) =>
  TIER_ORDER.indexOf(a.tier) - TIER_ORDER.indexOf(b.tier)
  || order[a.type] - order[b.type]
  || (a.cost - b.cost)
  || a.name.localeCompare(b.name));

const counts = TIER_ORDER.map((t) => ({ ...TIERS[t], n: CARDS.filter((c) => c.tier === t).length }));
const factions = Object.entries(
  CARDS.reduce((acc, c) => {
    for (const t of c.tags || []) if (t !== 'Token') acc[t] = (acc[t] || 0) + 1;
    return acc;
  }, {}),
).filter(([, n]) => n >= 4).sort((a, b) => b[1] - a[1]);

const painted = CARDS.filter((c) => artOf(c)).length;
---
<SectionLayout
  title="The Collection | Blood of Icetear"
  description="Every card in Blood of Icetear: characters, spells and relics of the world."
  theme="codex"
  eyebrow="Blood of Icetear"
  heading="The Collection"
  tagline="Every card in the set. One number does the fighting: Power."
  compact={true}
>
  <div class="wrap">

    <!-- ── what a card says ─────────────────────────────────────────────── -->
    <section class="primer">
      <h2>How to read a card</h2>
      <p>
        A character has one number, <strong>Power</strong>, in the shield at
        the bottom. When two characters fight, each takes the other’s Power
        off its own; at nought or less it dies. The number in the ring at the
        top is <strong>Cost</strong> — the Muster you pay to put it in the
        arena. Cost is always Power divided by three, rounded up, plus a
        little for a strong ability.
      </p>
      <dl class="keys">
        {Object.entries(KEYWORDS).map(([word, meaning]) => (
          <div><dt>{word}</dt><dd>{meaning}</dd></div>
        ))}
      </dl>
    </section>

    <!-- ── the shape of the set ─────────────────────────────────────────── -->
    <section class="tally">
      <p class="tally-line">
        <strong>{CARDS.length}</strong> cards ·
        <strong>{CARDS.filter((c) => c.type === 'character').length}</strong> characters ·
        <strong>{CARDS.filter((c) => c.type === 'spell').length}</strong> spells ·
        <strong>{painted}</strong> painted, {CARDS.length - painted} still waiting on art
      </p>
      <ul class="bars">
        {counts.map((t) => (
          <li>
            <span class="bar-name">{t.name}</span>
            <span class="bar" data-tier={t.id} style={`--w:${(t.n / Math.max(...counts.map((x) => x.n))) * 100}%`}></span>
            <span class="bar-n">{t.n}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── filters ──────────────────────────────────────────────────────── -->
    <section class="filters" id="filters">
      <div class="fgroup">
        <span class="flabel">Rarity</span>
        <button class="chip is-on" data-filter="tier" data-value="">All</button>
        {TIER_ORDER.map((t) => (
          <button class="chip" data-filter="tier" data-value={t} data-tier={t}>{TIERS[t].name}</button>
        ))}
      </div>
      <div class="fgroup">
        <span class="flabel">Kind</span>
        <button class="chip is-on" data-filter="type" data-value="">All</button>
        <button class="chip" data-filter="type" data-value="character">Characters</button>
        <button class="chip" data-filter="type" data-value="spell">Spells</button>
      </div>
      <div class="fgroup">
        <span class="flabel">Allegiance</span>
        <button class="chip is-on" data-filter="tag" data-value="">All</button>
        {factions.map(([t, n]) => (
          <button class="chip" data-filter="tag" data-value={t}>{t} <em>{n}</em></button>
        ))}
      </div>
      <p class="shown" id="shown">Tap any card to open it. <span class="nowrap">Tap again to zoom in.</span></p>
    </section>

    <!-- ── the cards ────────────────────────────────────────────────────── -->
    <div class="sheet" id="sheet">
      {cards.map((c, i) => {
        const art = artOf(c);
        // The type line reads "[Rarity] — [Type] ([Race])", as on the
        // prototype. A spell has no race, so it prints its kind alone.
        const kind = c.type === 'spell'
          ? (c.instant ? 'Instant Spell' : 'Spell')
          : `Character (${c.line})`;
        return (
          <button
            class="tok"
            type="button"
            data-i={i}
            data-tier={c.tier}
            data-type={c.type}
            data-tags={(c.tags || []).join('|')}
            aria-label={`${c.name}. ${TIERS[c.tier].name} ${kind}.`}
          >
            {art
              ? <img class="tok-art" src={art} alt="" loading="lazy" decoding="async" />
              : <span class="tok-art tok-blank"><em>Awaiting art</em></span>}

            <span class="tok-frame">
              <span class="tok-head">
                <span class="tok-name">{c.name}</span>
                <span class="tok-cost">{c.cost}</span>
              </span>

              <span class="tok-body">
                <span class="tok-line">{TIERS[c.tier].name} — {kind}</span>
                <span class="tok-text">{c.text || <em>No ability. It simply fights.</em>}</span>
                <span class="tok-foot">
                  <span class="tok-no">{numberOf(c)} · {TIERS[c.tier].letter} · LASH</span>
                  {c.type === 'character' && <span class="tok-power">{c.power}</span>}
                </span>
              </span>
            </span>
          </button>
        );
      })}
    </div>

    <p class="foot-note">
      Cards numbered <code>LAH</code> are the ones already designed in the
      Canva prototype, and keep the number printed on them. Cards numbered
      <code>BOI</code> are new, drawn from the Foundation Age codex, the
      bestiary and the stories. The letter after the number is the rarity.
    </p>
  </div>

  <!-- ── the lightbox ───────────────────────────────────────────────────── -->
  <div class="lb" id="lb" hidden>
    <div class="lb-scroll" id="lbScroll">
      <div class="lb-stage" id="lbStage"></div>
    </div>
    <button class="lb-x" id="lbClose" type="button" aria-label="Close">&times;</button>
    <button class="lb-nav lb-prev" id="lbPrev" type="button" aria-label="Previous card">&#8249;</button>
    <button class="lb-nav lb-next" id="lbNext" type="button" aria-label="Next card">&#8250;</button>
    <p class="lb-hint" id="lbHint"></p>
  </div>
</SectionLayout>

<style is:global>
  /* While a card is open the page behind it is frozen and the site header is
     taken away, so nothing paints over the card or scrolls underneath it. */
  body.lb-open { overflow: hidden; }
  body.lb-open .site-header { display: none; }
</style>

<style>
  .wrap { max-width: 1240px; margin: 0 auto; padding: 0 1.25rem 5rem; }
  .nowrap { white-space: nowrap; }

  /* ── primer ── */
  .primer { border: 1px solid var(--line); background: var(--card); border-radius: 14px;
            padding: 1.5rem 1.6rem; margin-bottom: 1.5rem; }
  .primer h2 { margin: 0 0 .6rem; font-size: 1.05rem; letter-spacing: .04em;
               text-transform: uppercase; color: var(--accentLight); }
  .primer p { margin: 0 0 1.1rem; color: var(--text); line-height: 1.7; max-width: 62ch; }
  .keys { display: grid; gap: .5rem 1.6rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin: 0; }
  .keys div { display: flex; gap: .55rem; align-items: baseline; }
  .keys dt { font-weight: 700; color: var(--accentLight); white-space: nowrap; }
  .keys dd { margin: 0; color: var(--textDim); font-size: .88rem; line-height: 1.5; }

  /* ── tally ── */
  .tally { margin-bottom: 1.5rem; }
  .tally-line { color: var(--textDim); margin: 0 0 .9rem; font-size: .95rem; }
  .tally-line strong { color: var(--textBright); }
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: .3rem; max-width: 420px; }
  .bars li { display: grid; grid-template-columns: 5.5rem 1fr 2rem; align-items: center; gap: .6rem;
             font-size: .82rem; color: var(--textDim); }
  .bar { height: 9px; border-radius: 5px; background: var(--line); position: relative; }
  .bar::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--w);
                border-radius: 5px; background: var(--tier, var(--accent)); }
  .bar-n { text-align: right; font-variant-numeric: tabular-nums; }

  /* ── filters ── */
  .filters { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
             padding: 1rem 0 .9rem; margin-bottom: 1.75rem; display: grid; gap: .7rem; }
  .fgroup { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
  .flabel { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase;
            color: var(--textDim); width: 5.5rem; flex: none; }
  .chip { font: inherit; font-size: .8rem; cursor: pointer; color: var(--textDim);
          background: transparent; border: 1px solid var(--line); border-radius: 999px;
          padding: .28rem .7rem; transition: color .15s, border-color .15s, background .15s; }
  .chip em { font-style: normal; opacity: .5; font-size: .72em; margin-left: .25rem; }
  .chip:hover { color: var(--textBright); border-color: var(--accentDim); }
  .chip.is-on { color: #10100f; background: var(--accentLight); border-color: var(--accentLight); font-weight: 600; }
  .chip.is-on em { opacity: .55; }
  .shown { margin: .2rem 0 0; font-size: .8rem; color: var(--textDim); }

  /* ═══════════════════════ THE CARD ═══════════════════════
     Full art: the painting is the whole card, and the name and the rules sit
     on plates over it. Every size inside a card is in em, and the card's own
     font-size is a share of its width, so one card design works at a
     thumbnail in the grid and at full size in the lightbox.               */
  .sheet { display: grid; gap: 1.05rem;
           grid-template-columns: repeat(auto-fill, minmax(206px, 1fr)); }

  .tok {
    --tier: var(--accent);
    all: unset;                      /* it is a button; it should not look like one */
    position: relative; display: block; cursor: zoom-in;
    aspect-ratio: 378 / 528; border-radius: 3.6%; overflow: hidden;
    background: #0a0a09;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .09), 0 0 0 2px rgba(0, 0, 0, .8),
                0 8px 22px rgba(0, 0, 0, .55);
    container-type: inline-size;
    /* 195 cards is a tall page; the ones off screen are not laid out at all. */
    content-visibility: auto; contain-intrinsic-size: auto 300px;
    transition: transform .16s ease, box-shadow .16s ease;
  }
  .tok[hidden] { display: none; }
  .tok:hover, .tok:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 0 0 1px var(--tier), 0 0 0 2px rgba(0, 0, 0, .8),
                0 14px 30px rgba(0, 0, 0, .65);
  }

  /* the painting */
  .tok-art { position: absolute; inset: 0; width: 100%; height: 100%;
             object-fit: cover; display: block; }
  .tok-blank { display: grid; place-items: center; font-size: 5.35cqw;
               background: repeating-linear-gradient(45deg, #0d0d0b 0 10px, #121210 10px 20px); }
  .tok-blank em { font-style: normal; font-size: .62em; letter-spacing: .18em;
                  text-transform: uppercase; color: rgba(255, 255, 255, .2); }

  /* everything that sits on top of the painting */
  /* The one number every other size on the card follows. It is a share of
     the card's width, so a single design works at a thumbnail in the grid and
     at full size in the lightbox. */
  .tok-frame { position: absolute; inset: 0; display: flex; flex-direction: column;
               font-size: 5.35cqw; padding: .55em; gap: .5em; }
  .tok-body { position: relative; }   /* the Power shield hangs off this corner */

  .tok-head { display: flex; align-items: center; gap: .45em; flex: none;
              padding: .34em .5em .34em .62em; border-radius: .42em;
              background: linear-gradient(180deg, rgba(10, 10, 12, .9), rgba(10, 10, 12, .74));
              border: 1px solid rgba(255, 255, 255, .13);
              border-bottom: 1.5px solid var(--tier);
              box-shadow: 0 2px 10px rgba(0, 0, 0, .5); }
  .tok-name { flex: 1 1 auto; min-width: 0; font-size: 1.02em; line-height: 1.12;
              font-weight: 600; color: #f2ece2; letter-spacing: .005em;
              text-shadow: 0 1px 2px rgba(0, 0, 0, .9); }
  .tok-cost { flex: none; display: grid; place-items: center;
              width: 1.85em; height: 1.85em; border-radius: 50%;
              background: radial-gradient(circle at 34% 28%, #fff6, transparent 58%), var(--tier);
              color: #0d0c0a; font-size: .95em; font-weight: 700;
              font-variant-numeric: tabular-nums;
              box-shadow: inset 0 -1px 2px rgba(0, 0, 0, .45), 0 1px 4px rgba(0, 0, 0, .6); }

  /* the rules plate, pushed to the foot of the card */
  .tok-body { margin-top: auto; display: flex; flex-direction: column; gap: .3em;
              padding: .48em .62em .46em; border-radius: .42em;
              background: linear-gradient(180deg, rgba(8, 8, 10, .82), rgba(8, 8, 10, .93));
              border: 1px solid rgba(255, 255, 255, .1);
              box-shadow: 0 2px 12px rgba(0, 0, 0, .6); }
  .tok-line { font-size: .64em; letter-spacing: .03em; color: var(--tier);
              text-shadow: 0 1px 2px rgba(0, 0, 0, .8); }
  .tok-text { font-size: .7em; line-height: 1.34; color: rgba(255, 255, 255, .84);
              min-height: 4.1em; }
  .tok-text em { color: rgba(255, 255, 255, .34); font-style: italic; }

  .tok-foot { display: flex; align-items: flex-end; margin-top: .12em;
              padding-right: 2.6em; }   /* room for the Power shield */
  .tok-no { font-size: .52em; letter-spacing: .07em; color: rgba(255, 255, 255, .38);
            font-variant-numeric: tabular-nums; }

  /* Power sits in a shield overhanging the corner of the card, the way a
     fighting number should — big enough to read across a table. */
  .tok-power { position: absolute; right: .3em; bottom: .32em;
               display: grid; place-items: center;
               min-width: 2.15em; padding: .08em .3em .16em;
               border-radius: .26em .26em .5em .26em;
               background: linear-gradient(170deg, var(--tier) 30%, rgba(0, 0, 0, .45));
               color: #0f0e0b; font-size: 1.42em; font-weight: 800; line-height: 1.16;
               font-variant-numeric: tabular-nums;
               text-shadow: 0 1px 0 rgba(255, 255, 255, .3);
               box-shadow: inset 0 1px 0 rgba(255, 255, 255, .35),
                           0 0 0 1px rgba(0, 0, 0, .75), 0 2px 8px rgba(0, 0, 0, .8); }

  /* Rarity colours. The one place a tier's look is decided. */
  [data-tier='tier_1'] { --tier: #9aa3a8; }
  [data-tier='tier_2'] { --tier: #7fae82; }
  [data-tier='tier_3'] { --tier: #6f9dc9; }
  [data-tier='tier_4'] { --tier: #a988d0; }
  [data-tier='tier_5'] { --tier: #d8a054; }
  [data-tier='tier_6'] { --tier: #d4685e; }

  .foot-note { margin: 2.5rem 0 0; font-size: .85rem; line-height: 1.7;
               color: var(--textDim); max-width: 70ch; }
  .foot-note code { font-size: .95em; color: var(--accentLight); }

  /* ═══════════════════════ THE LIGHTBOX ═══════════════════════ */
  .lb { position: fixed; inset: 0; z-index: 2000; background: rgba(4, 4, 6, .93);
        backdrop-filter: blur(6px); }
  .lb[hidden] { display: none; }
  .lb-scroll { position: absolute; inset: 0; overflow: auto; overscroll-behavior: contain;
               display: grid; place-content: safe center; padding: clamp(.6rem, 3vw, 2.5rem); }
  .lb-stage { display: grid; place-items: center; }

  /* The opened card. --z is the zoom: 1 fits the screen, more overflows and
     the layer above scrolls, so zooming in can be panned around. */
  .lb { --z: 1; }
  .lb .tok {
    content-visibility: visible; contain-intrinsic-size: none;
    cursor: zoom-in; transform: none !important;
    width: calc(min(64vw, 620px, 80vh * 0.716) * var(--z));
    height: auto;
    box-shadow: 0 0 0 1px var(--tier), 0 0 0 3px rgba(0, 0, 0, .9),
                0 30px 70px rgba(0, 0, 0, .8);
  }
  .lb.is-zoom { --z: 2.4; }
  .lb.is-zoom .tok { cursor: zoom-out; }
  /* Zoomed in, a drag pans the painting rather than turning the page, so the
     arrows and the hint would only be in the way. */
  .lb.is-zoom .lb-nav, .lb.is-zoom .lb-hint { display: none; }
  .lb .tok-text { min-height: 0; }

  .lb-x, .lb-nav { position: absolute; z-index: 2; font: inherit; cursor: pointer;
                   color: rgba(255, 255, 255, .72); background: rgba(16, 16, 20, .8);
                   border: 1px solid rgba(255, 255, 255, .16); border-radius: 999px;
                   display: grid; place-items: center; line-height: 1;
                   transition: color .15s, background .15s, border-color .15s; }
  .lb-x:hover, .lb-nav:hover { color: #fff; background: rgba(40, 40, 48, .95);
                               border-color: rgba(255, 255, 255, .4); }
  .lb-x { top: max(.7rem, env(safe-area-inset-top)); right: .7rem;
          width: 2.4rem; height: 2.4rem; font-size: 1.6rem; padding-bottom: .16em; }
  .lb-nav { top: 50%; transform: translateY(-50%); width: 2.6rem; height: 3.6rem;
            font-size: 1.9rem; padding-bottom: .1em; }
  .lb-prev { left: .5rem; } .lb-next { right: .5rem; }
  .lb-hint { position: absolute; left: 0; right: 0; bottom: max(.55rem, env(safe-area-inset-bottom));
             margin: 0; text-align: center; font-size: .74rem; letter-spacing: .04em;
             color: rgba(255, 255, 255, .42); pointer-events: none; }

  @media (max-width: 560px) {
    .sheet { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .65rem; }
    .flabel { width: 100%; }
    /* On a phone the card fills the width, so the arrows move off the art
       and sit either side of the hint at the foot of the screen. */
    .lb .tok { width: calc(min(92vw, 74vh * 0.716) * var(--z)); }
    .lb-scroll { padding: 3.2rem .5rem 4.2rem; }
    .lb-nav { top: auto; transform: none; width: 3rem; height: 2.6rem; font-size: 1.6rem;
              bottom: max(2.1rem, calc(env(safe-area-inset-bottom) + 1.6rem)); }
    .lb-prev { left: 1.1rem; } .lb-next { right: 1.1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tok { transition: none; }
    .tok:hover, .tok:focus-visible { transform: none; }
  }
</style>

<script>
  // ── filtering ────────────────────────────────────────────────────────────
  // The cards are already in the page; the filters only hide and show them.
  const sheet = document.getElementById('sheet');
  const shown = document.getElementById('shown');
  const toks = [...sheet.querySelectorAll('.tok')];
  const pick = { tier: '', type: '', tag: '' };
  const HINT = 'Tap any card to open it. <span class="nowrap">Tap again to zoom in.</span>';

  function visible() { return toks.filter((t) => !t.hidden); }

  function apply() {
    for (const t of toks) {
      t.hidden = !(
        (!pick.tier || t.dataset.tier === pick.tier) &&
        (!pick.type || t.dataset.type === pick.type) &&
        (!pick.tag || t.dataset.tags.split('|').includes(pick.tag))
      );
    }
    const n = visible().length;
    shown.innerHTML = Object.values(pick).every((v) => !v)
      ? HINT
      : `Showing ${n} of ${toks.length} cards. ${HINT}`;
  }

  document.getElementById('filters').addEventListener('click', (e) => {
    const chip = e.target.closest('.chip');
    if (!chip) return;
    const { filter, value } = chip.dataset;
    pick[filter] = value;
    for (const c of document.querySelectorAll(`.chip[data-filter="${filter}"]`)) {
      c.classList.toggle('is-on', c === chip);
    }
    apply();
  });

  apply();

  // ── the lightbox ─────────────────────────────────────────────────────────
  // Opening a card clones the card that is already on the page, so the card
  // is only designed once and the big one can never drift from the small one.
  const lb = document.getElementById('lb');
  const lbScroll = document.getElementById('lbScroll');
  const lbStage = document.getElementById('lbStage');
  const lbHint = document.getElementById('lbHint');
  let list = [];
  let at = 0;
  let opener = null;

  function show(i) {
    at = (i + list.length) % list.length;
    const card = list[at].cloneNode(true);
    card.hidden = false;
    card.removeAttribute('data-i');
    card.tabIndex = -1;
    const img = card.querySelector('img');
    if (img) { img.loading = 'eager'; img.decoding = 'sync'; }
    lbStage.replaceChildren(card);
    lbScroll.scrollTo(0, 0);
    const touch = matchMedia('(hover: none)').matches;
    lbHint.textContent = touch
      ? `${at + 1} of ${list.length}  ·  tap to zoom  ·  swipe to browse`
      : `${at + 1} of ${list.length}  ·  click to zoom  ·  arrow keys to browse  ·  Esc to close`;
    card.focus({ preventScroll: true });
  }

  function open(tok) {
    list = visible();
    if (!list.length) return;
    opener = tok;
    lb.classList.remove('is-zoom');
    lb.hidden = false;
    document.body.classList.add('lb-open');
    show(list.indexOf(tok));
  }

  function close() {
    lb.hidden = true;
    lb.classList.remove('is-zoom');
    lbStage.replaceChildren();
    document.body.classList.remove('lb-open');
    if (opener) { opener.focus({ preventScroll: true }); opener = null; }
  }

  const step = (d) => { lb.classList.remove('is-zoom'); show(at + d); };

  sheet.addEventListener('click', (e) => {
    const tok = e.target.closest('.tok');
    if (tok) open(tok);
  });

  lb.addEventListener('click', (e) => {
    if (e.target.closest('#lbClose')) return close();
    if (e.target.closest('#lbPrev')) return step(-1);
    if (e.target.closest('#lbNext')) return step(1);
    // Clicking the card zooms; clicking the space around it closes.
    if (e.target.closest('.tok')) {
      const wasZoomed = lb.classList.toggle('is-zoom');
      if (wasZoomed) {
        // Keep the middle of the card in view when it grows.
        lbScroll.scrollTo({
          left: (lbScroll.scrollWidth - lbScroll.clientWidth) / 2,
          top: (lbScroll.scrollHeight - lbScroll.clientHeight) / 2,
        });
      }
      return;
    }
    close();
  });

  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') { close(); e.preventDefault(); }
    else if (e.key === 'ArrowLeft') { step(-1); e.preventDefault(); }
    else if (e.key === 'ArrowRight') { step(1); e.preventDefault(); }
  });

  // Swipe left and right to move between cards, but only when the card is not
  // zoomed in — once it is, a drag is for panning around the painting.
  let x0 = null, y0 = null;
  lbScroll.addEventListener('pointerdown', (e) => { x0 = e.clientX; y0 = e.clientY; });
  lbScroll.addEventListener('pointerup', (e) => {
    if (x0 === null || lb.classList.contains('is-zoom')) { x0 = null; return; }
    const dx = e.clientX - x0, dy = e.clientY - y0;
    x0 = null;
    if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.6) step(dx < 0 ? 1 : -1);
  });
</script>
