</section>

<section class="zone" data-mood="frost">
  <p class="line beat">The dragon opened its mouth.</p>
  <p class="line">Blue-white light filled the cavern.</p>
  <p class="line">The woman tightened her embrace.</p>
  <p class="line">And whispered one final sentence.</p>
  <p class="line struck">&quot;Will you?&quot;</p>
  <p class="line">Hadrian woke screaming.</p>
  <p class="line">The room was dark.</p>
  <p class="line">His sheets were soaked with sweat.</p>
  <p class="line">His heart slammed against his ribs.</p>
  <p class="line">For several seconds he could not remember where he was.</p>
  <p class="line">Then he felt something against his chest.</p>
  <p class="line">Cold.</p>
  <p class="line">Hadrian slowly looked down.</p>
  <p class="line">The frost amulet was glowing.</p>
  <p class="line">Blue light crawled through its crystalline veins.</p>
  <p class="line">And across his bedroom floor, beginning beneath his bed and stretching toward the door...</p>
  <p class="line">was a thin layer of frost.</p>
  <p class="line">Hadrian stared at it.</p>
  <p class="line">This had not been a dream.</p>
  <p class="line">And somewhere beyond the northern walls of Hearthwinter, something that his kingdom had tried very hard to forget...</p>
  <p class="line struck">had begun remembering them.</p>
  <div class="sep line">— ✦ —</div>
</section>

</main>

<div class="colophon">
  <div class="rule"></div>
  <div class="byline">End of Part One</div>
  <p><a href="/library/age-of-kingdoms">The Age of Kingdoms</a> · <a href="/library">The Library</a></p>
</div>

<script>
(function(){
  "use strict";

  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---------------- MOOD DEFINITIONS ----------------
     Each mood is one object. Adding a seventh mood means
     adding one entry here, nothing else changes.        */

  var MOODS = {
    hearth:{
      ground:"#0a0805", wash:"#2a1a0c", washY:"72%", spread:"66%",
      vignette:.42, text:"#a89478", bright:"#ecdcc0", accent:"#c9873f",
      track:".005em", rise:"14px", dur:"1200ms", grain:.03,
      p:{count:.55, speed:.16, dir:-1, drift:.4, size:1.7, color:"201,135,63", alpha:.5, frozen:false},
      audio:{cut:420, noise:.05, drone:.05, hz:82.41}
    },
    frost:{
      ground:"#05070c", wash:"#0d2036", washY:"58%", spread:"72%",
      vignette:.55, text:"#8b94a3", bright:"#d8dde6", accent:"#7fb3d5",
      track:".005em", rise:"14px", dur:"1100ms", grain:.035,
      p:{count:1, speed:.34, dir:1, drift:.5, size:1.5, color:"200,220,240", alpha:.45, frozen:false},
      audio:{cut:900, noise:.09, drone:.035, hz:65.41}
    },
    dread:{
      ground:"#070809", wash:"#14171c", washY:"48%", spread:"55%",
      vignette:.8, text:"#7a8088", bright:"#b9bfc7", accent:"#5a6470",
      track:".045em", rise:"18px", dur:"1900ms", grain:.055,
      p:{count:.8, speed:0, dir:1, drift:0, size:1.5, color:"170,178,188", alpha:.3, frozen:true},
      audio:{cut:180, noise:.045, drone:.075, hz:49}
    },
    wonder:{
      ground:"#04080f", wash:"#10386e", washY:"52%", spread:"88%",
      vignette:.34, text:"#9fb4c9", bright:"#e6f0fb", accent:"#4a8fd4",
      track:".012em", rise:"20px", dur:"1700ms", grain:.025,
      p:{count:1.3, speed:.2, dir:-1, drift:.75, size:2.1, color:"120,180,240", alpha:.62, frozen:false},
      audio:{cut:1500, noise:.05, drone:.085, hz:98}
    },
    wrath:{
      ground:"#0a0608", wash:"#3a1116", washY:"50%", spread:"62%",
      vignette:.66, text:"#b6a3a3", bright:"#f4e9e6", accent:"#b8443a",
      track:".005em", rise:"6px", dur:"200ms", grain:.075,
      p:{count:1.5, speed:1.9, dir:1, drift:2.6, size:1.2, color:"235,205,200", alpha:.42, frozen:false},
      audio:{cut:2400, noise:.13, drone:.06, hz:58.27}
    },
    abyss:{
      ground:"#020304", wash:"#080a0d", washY:"46%", spread:"40%",
      vignette:.94, text:"#5c636d", bright:"#8f97a2", accent:"#2b2f38",
      track:".02em", rise:"10px", dur:"2400ms", grain:.02,
      p:{count:0, speed:0, dir:1, drift:0, size:1, color:"90,96,105", alpha:.2, frozen:false},
      audio:{cut:90, noise:.02, drone:.05, hz:41.2}
    }
  };

  var root = document.documentElement;
  var current = null;

  function applyMood(name){
    var m = MOODS[name];
    if(!m || name === current) return;
    current = name;
    var s = root.style;
    s.setProperty("--ground", m.ground);
    s.setProperty("--wash", m.wash);
    s.setProperty("--wash-y", m.washY);
    s.setProperty("--wash-spread", m.spread);
    s.setProperty("--vignette", m.vignette);
    s.setProperty("--text", m.text);
    s.setProperty("--text-bright", m.bright);
    s.setProperty("--accent", m.accent);
    s.setProperty("--track", m.track);
    s.setProperty("--line-rise", m.rise);
    s.setProperty("--line-dur", m.dur);
    s.setProperty("--grain", m.grain);
    field.retune(m.p);
    Ambient.retune(m.audio);
  }

  /* ---------------- PARTICLE FIELD ----------------
     One canvas, one rAF loop, paused when the tab is hidden.
     "frozen" doesn't stop the loop, it stops the movement,
     which is the entire trick behind dread.                */

  var field = (function(){
    var cv = document.getElementById("particles");
    var ctx = cv.getContext("2d");
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var w = 0, h = 0, parts = [], cfg = MOODS.frost.p, base = 0, raf = null;

    function resize(){
      w = window.innerWidth; h = window.innerHeight;
      cv.width = w * dpr; cv.height = h * dpr;
      cv.style.width = w + "px"; cv.style.height = h + "px";
      ctx.setTransform(dpr,0,0,dpr,0,0);
      base = Math.round(Math.min(90, (w * h) / 16000));
      build();
    }
    function mk(){
      return {x:Math.random()*w, y:Math.random()*h,
              vx:(Math.random()-.5), vy:(Math.random()*.6+.4),
              r:Math.random()*.8+.5, a:Math.random()*.6+.4};
    }
    function build(){
      var want = Math.round(base * (cfg.count||0));
      while(parts.length < want) parts.push(mk());
      if(parts.length > want) parts.length = want;
    }
    function frame(){
      ctx.clearRect(0,0,w,h);
      for(var i=0;i<parts.length;i++){
        var p = parts[i];
        if(!cfg.frozen){
          p.y += p.vy * cfg.speed * cfg.dir * 3;
          p.x += p.vx * cfg.drift;
          if(p.y > h + 12){ p.y = -12; p.x = Math.random()*w; }
          if(p.y < -12){ p.y = h + 12; p.x = Math.random()*w; }
          if(p.x > w + 12) p.x = -12;
          if(p.x < -12) p.x = w + 12;
        }
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r * cfg.size, 0, 6.283);
        ctx.fillStyle = "rgba(" + cfg.color + "," + (p.a * cfg.alpha) + ")";
        ctx.fill();
      }
      raf = requestAnimationFrame(frame);
    }
    function start(){ if(!raf && !reduced) raf = requestAnimationFrame(frame); }
    function stop(){ if(raf){ cancelAnimationFrame(raf); raf = null; } }

    if(!reduced){
      resize();
      var rt; window.addEventListener("resize", function(){
        clearTimeout(rt); rt = setTimeout(resize, 180);
      });
      document.addEventListener("visibilitychange", function(){
        document.hidden ? stop() : start();
      });
      start();
    } else { cv.style.display = "none"; }

    return { retune:function(next){ cfg = next; if(!reduced) build(); } };
  })();

  /* ---------------- AMBIENT SOUND ----------------
     Synthesised, not loaded: filtered noise for wind plus two
     detuned oscillators for the drone. No audio files exist,
     so nothing to host and nothing to download.              */

  var Ambient = (function(){
    var ctxA = null, on = false, pending = null;
    var noiseGain, droneGain, filter, osc1, osc2, master;

    function build(){
      var AC = window.AudioContext || window.webkitAudioContext;
      if(!AC) return false;
      ctxA = new AC();

      var len = ctxA.sampleRate * 4;
      var buf = ctxA.createBuffer(1, len, ctxA.sampleRate);
      var d = buf.getChannelData(0), last = 0;
      for(var i=0;i<len;i++){
        var white = Math.random()*2-1;
        last = (last + 0.02*white)/1.02;
        d[i] = last * 3.2;
      }
      var src = ctxA.createBufferSource();
      src.buffer = buf; src.loop = true;

      filter = ctxA.createBiquadFilter();
      filter.type = "lowpass"; filter.frequency.value = 900; filter.Q.value = .6;

      noiseGain = ctxA.createGain(); noiseGain.gain.value = 0;
      droneGain = ctxA.createGain(); droneGain.gain.value = 0;
      master = ctxA.createGain(); master.gain.value = 0;

      osc1 = ctxA.createOscillator(); osc1.type = "sine"; osc1.frequency.value = 65.41;
      osc2 = ctxA.createOscillator(); osc2.type = "sine"; osc2.frequency.value = 65.85;

      src.connect(filter); filter.connect(noiseGain); noiseGain.connect(master);
      osc1.connect(droneGain); osc2.connect(droneGain); droneGain.connect(master);
      master.connect(ctxA.destination);

      src.start(); osc1.start(); osc2.start();
      return true;
    }

    function glide(param, value, secs){
      if(!ctxA) return;
      param.cancelScheduledValues(ctxA.currentTime);
      param.setValueAtTime(param.value, ctxA.currentTime);
      param.linearRampToValueAtTime(value, ctxA.currentTime + (secs || 2.4));
    }

    return {
      toggle:function(){
        if(!ctxA && !build()) return false;
        if(ctxA.state === "suspended") ctxA.resume();
        on = !on;
        glide(master.gain, on ? 1 : 0, on ? 2.5 : 1.2);
        if(on && pending) this.retune(pending);
        return on;
      },
      retune:function(a){
        pending = a;
        if(!ctxA || !on) return;
        glide(filter.frequency, a.cut, 3);
        glide(noiseGain.gain, a.noise, 3);
        glide(droneGain.gain, a.drone, 3);
        glide(osc1.frequency, a.hz, 3);
        glide(osc2.frequency, a.hz * 1.006, 3);
      }
    };
  })();

  /* ---------------- OBSERVERS ----------------
     Two, not three thousand. Sections drive the mood; lines
     reveal once and immediately stop being watched.        */

  var zones = Array.prototype.slice.call(document.querySelectorAll("[data-mood]"));

  var moodObs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting) applyMood(e.target.getAttribute("data-mood"));
    });
  }, { rootMargin:"-45% 0px -45% 0px", threshold:0 });
  zones.forEach(function(z){ moodObs.observe(z); });

  var lines = document.querySelectorAll(".line");
  if(reduced){
    Array.prototype.forEach.call(lines, function(l){ l.classList.add("seen"); });
  } else {
    var lineObs = new IntersectionObserver(function(entries, obs){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.classList.add("seen");
          obs.unobserve(e.target);          /* released immediately */
        }
      });
    }, { rootMargin:"0px 0px -12% 0px", threshold:0.1 });
    Array.prototype.forEach.call(lines, function(l){ lineObs.observe(l); });
  }

  /* ---------------- PROGRESS RAIL ---------------- */

  var railfill = document.getElementById("railfill");
  var rail = document.getElementById("rail");
  var ticking = false;

  function drawTicks(){
    var docH = document.body.scrollHeight;
    zones.forEach(function(z){
      if(z.hasAttribute("data-skip-index")) return;
      var t = document.createElement("div");
      t.className = "tick";
      t.style.top = ((z.offsetTop / docH) * 100) + "%";
      rail.appendChild(t);
    });
  }

  function onScroll(){
    if(ticking) return;
    ticking = true;
    requestAnimationFrame(function(){
      var max = document.body.scrollHeight - window.innerHeight;
      var pct = max > 0 ? (window.scrollY / max) * 100 : 0;
      railfill.style.height = pct + "%";
      ticking = false;
    });
  }
  window.addEventListener("scroll", onScroll, {passive:true});

  /* ---------------- CHAPTER INDEX ---------------- */

  var index = document.getElementById("index");
  var indexbtn = document.getElementById("indexbtn");
  var indexChapters = document.getElementById("indexChapters");

  zones.forEach(function(z, i){
    if(!z.getAttribute("data-title")) return;
    var id = "z" + i;
    z.id = id;
    var a = document.createElement("a");
    a.href = "#" + id;
    a.innerHTML = "<small>" + (z.getAttribute("data-num") || "") + "</small>" +
                  z.getAttribute("data-title");
    a.addEventListener("click", function(){ setIndex(false); });
    indexChapters.appendChild(a);
  });

  function setIndex(open){
    index.classList.toggle("open", open);
    indexbtn.setAttribute("aria-expanded", String(open));
    indexbtn.textContent = open ? "Close" : "Chapters";
  }
  indexbtn.addEventListener("click", function(){
    setIndex(!index.classList.contains("open"));
  });
  document.addEventListener("keydown", function(e){
    if(e.key === "Escape") setIndex(false);
  });
  document.addEventListener("click", function(e){
    if(index.classList.contains("open") &&
       !index.contains(e.target) && e.target !== indexbtn) setIndex(false);
  });

  /* ---------------- CONTROLS ---------------- */

  var soundbtn = document.getElementById("soundbtn");
  soundbtn.addEventListener("click", function(){
    var playing = Ambient.toggle();
    soundbtn.setAttribute("aria-pressed", String(playing));
    soundbtn.textContent = playing ? "Sound on" : "Sound off";
  });

  /* ---------------- GO ---------------- */

  drawTicks();
  onScroll();
  applyMood("frost");
})();
</script>
</body>
</html>
