---
import SiteHeader from '../../components/SiteHeader.astro';
import { CALLINGS, ORDER } from '../../data/fivefold.js';

// Each Trial carries its own light. No artwork is shipped yet, so the scenes
// are painted in gradient and grain; a real plate can drop into .scene-art
// later without touching the flow.
const TONES = [
  ['#2a1a10', '#0b0806'], ['#3a1512', '#0a0605'], ['#0e1a20', '#05080b'],
  ['#33270c', '#0b0805'], ['#16202b', '#05080c'], ['#241a2c', '#08060c'],
  ['#101c18', '#050807'], ['#2b2110', '#0a0806'], ['#2a0f12', '#080505'],
  ['#301c10', '#080605'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Fivefold Calling | LASH</title>
  <meta name="description" content="Five Callings contend within every soul. Forty statements reveal which of them organise you. A research-inspired fantasy personality assessment, for reflection." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Cormorant+SC:wght@300;400;500&display=swap" rel="stylesheet" />
  <!-- Global, not scoped. The choices, the Crucible options and the five marks
       are all built by the script below, so they never receive Astro's scoping
       attribute and scoped rules would silently skip them. -->
  <style is:global>
    :root {
      --ink:#0a0908; --text:#b9b0a2; --bright:#f0e8db; --dim:#6f685c;
      --oath:#C89B3C; --hearth:#9E3030; --forge:#406A9B; --voice:#2F7D78; --watch:#684A87;
      --edge:rgba(200,155,60,0.20);
      --scene-a:#2a1a10; --scene-b:#0b0806;
    }
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    /* Anything given the hidden attribute stays hidden. Without this, a class
       that sets its own display outranks the browser's rule for [hidden] and
       the element keeps taking up space while appearing to be switched off. */
    [hidden]{display:none !important}
    html{scroll-behavior:smooth}
    body{
      background:var(--ink); color:var(--text);
      font-family:'EB Garamond',Georgia,serif; font-size:18px; line-height:1.7;
      overflow-x:hidden; min-height:100vh;
    }
    #scene{
      position:fixed; inset:0; z-index:0; pointer-events:none;
      background:
        radial-gradient(ellipse 90% 70% at 50% 18%, var(--scene-a) 0%, transparent 72%),
        radial-gradient(ellipse 80% 60% at 50% 110%, var(--scene-b) 0%, transparent 70%),
        var(--ink);
      transition:background 1400ms ease;
    }
    #grain{
      position:fixed; inset:-200%; z-index:0; pointer-events:none; opacity:.05;
      background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3'/></filter><rect width='120' height='120' filter='url(%23n)' opacity='0.55'/></svg>");
      animation:grain 1.1s steps(3) infinite;
    }
    @keyframes grain{0%,100%{transform:translate(0,0)}33%{transform:translate(-2%,1%)}66%{transform:translate(1%,-2%)}}
    #vig{position:fixed;inset:0;z-index:0;pointer-events:none;
      background:radial-gradient(ellipse at center,transparent 40%,rgba(0,0,0,.82) 100%)}
    main{position:relative;z-index:1}

    .screen{display:none}
    .screen.on{display:block}
    /* the gate lays out as a column, but only while it is the screen on
       show. Setting display on .gate alone outranked .screen{display:none}
       and left the gate stacked above every later screen. */
    .screen.on.gate{display:flex}

    /* ─── the gate ─── */
    .gate{min-height:100svh;flex-direction:column;align-items:center;
      justify-content:center;text-align:center;padding:7rem 1.2rem 4rem;gap:1.1rem}
    .gate-eyebrow{font-family:'Cormorant SC',serif;font-size:.68rem;letter-spacing:.42em;
      text-transform:uppercase;color:var(--oath)}
    .gate h1{font-family:'Cinzel',serif;font-weight:700;letter-spacing:.05em;line-height:1.1;
      font-size:clamp(1.9rem,7vw,4rem);color:var(--bright)}
    .gate-lede{max-width:34rem;font-style:italic;font-size:clamp(1rem,2.3vw,1.2rem)}
    .gate-lede span{display:block}
    .gate-small{font-family:'Cormorant SC',serif;font-size:.66rem;letter-spacing:.24em;
      text-transform:uppercase;color:var(--dim);margin-top:.6rem}


    /* ── the gateway: a rune ring, and a real arch with two doors ── */
    .gateway{position:relative;width:min(23rem,88vw);aspect-ratio:1;
      margin:1.5rem auto .2rem;display:grid;place-items:center;
      transition:transform 400ms cubic-bezier(.2,.7,.3,1)}

    /* the ring turns slowly and the five marks sit on it, each one touchable */
    .rune-ring{position:absolute;inset:0;border-radius:50%;pointer-events:none;z-index:4}
    .ring-band{position:absolute;inset:0;border-radius:50%;border:1px solid var(--edge);
      box-shadow:inset 0 0 70px rgba(0,0,0,.85),0 0 46px rgba(0,0,0,.6);
      transition:border-color .8s ease,box-shadow .8s ease}
    .ring-band.two{inset:8%;border-color:rgba(200,155,60,.13);box-shadow:none}
    .ring-runes{position:absolute;inset:2%;border-radius:50%;
      background:repeating-conic-gradient(from 0deg,
        rgba(200,155,60,.30) 0deg 1.1deg, transparent 1.1deg 9deg);
      -webkit-mask:radial-gradient(circle,transparent 0 87%,#000 87.5% 100%);
              mask:radial-gradient(circle,transparent 0 87%,#000 87.5% 100%);
      animation:ringTurn 90s linear infinite}
    .ring-runes.inner{inset:14%;
      background:repeating-conic-gradient(from 0deg,
        rgba(200,155,60,.20) 0deg 2deg, transparent 2deg 24deg);
      animation:ringTurn 150s linear infinite reverse}
    @keyframes ringTurn{to{transform:rotate(360deg)}}

    .sigil{position:absolute;width:36px;height:36px;border-radius:50%;
      display:grid;place-items:center;background:none;border:none;padding:0;
      cursor:pointer;pointer-events:auto;transition:transform .3s ease}
    .sigil i{display:block;width:12px;height:12px;border-radius:50%;
      background:currentColor;opacity:.26;
      transition:opacity .45s ease,box-shadow .45s ease,transform .45s ease}
    .sigil:hover,.sigil:focus-visible{transform:scale(1.18)}
    .sigil:hover i,.sigil:focus-visible i,.sigil.lit i{opacity:1;transform:scale(1.4)}
    .sigil:focus-visible{outline:2px solid var(--oath);outline-offset:2px}
    .gateway.all-lit .ring-band{border-color:rgba(200,155,60,.5);
      box-shadow:inset 0 0 70px rgba(0,0,0,.85),0 0 72px rgba(200,155,60,.2)}

    /* the gate: two pillars, an arch, a keystone, a step */
    .gate-door{position:relative;z-index:2;width:58%;height:74%;background:none;border:none;
      padding:0;cursor:pointer;color:inherit;display:block;
      transition:filter .45s ease,transform .2s ease}
    .gate-door:hover{filter:brightness(1.14)}
    .gate-door:active{transform:scale(.985)}
    .gate-door:focus-visible{outline:2px solid var(--oath);outline-offset:16px;
      border-radius:20px}

    .pillar{position:absolute;bottom:0;width:16%;height:86%;
      background:linear-gradient(90deg,#0c0a08,#221b14 38%,#2b2318 58%,#100d0a);
      border:1px solid rgba(200,155,60,.22);border-bottom:none;border-radius:4px 4px 0 0}
    .pillar.left{left:-14%}
    .pillar.right{right:-14%}
    .pillar::before{content:'';position:absolute;top:-1px;left:-24%;right:-24%;height:6%;
      background:linear-gradient(180deg,#3b3021,#181310);
      border:1px solid rgba(200,155,60,.3);border-radius:3px}

    .arch{position:absolute;inset:0;overflow:hidden;
      border-radius:50% 50% 8px 8px / 34% 34% 8px 8px;
      border:1px solid rgba(200,155,60,.32);
      background:linear-gradient(180deg,#191410,#0b0908);
      box-shadow:inset 0 0 55px rgba(0,0,0,.9),0 0 60px rgba(0,0,0,.7)}
    .arch-inner{position:absolute;inset:6% 8% 4%;display:flex;overflow:hidden;
      border-radius:50% 50% 5px 5px / 31% 31% 5px 5px;background:#050403}

    .gate-glow{position:absolute;inset:0;z-index:0;pointer-events:none;opacity:0;
      background:radial-gradient(ellipse at 50% 72%,rgba(245,205,125,.6),
        rgba(200,155,60,.14) 46%,transparent 74%);
      transition:opacity 900ms ease}
    .gate-door.opening .gate-glow{opacity:1}

    .door{position:relative;z-index:1;flex:1;
      background:
        repeating-linear-gradient(90deg,rgba(0,0,0,.4) 0 1px,transparent 1px 15%),
        linear-gradient(180deg,#241c14,#120e0b 62%,#0a0807);
      border:1px solid rgba(200,155,60,.18);
      transition:transform 1100ms cubic-bezier(.6,0,.2,1)}
    .door.l{transform-origin:left center;border-right:none}
    .door.r{transform-origin:right center;border-left:none}
    .gate-door.opening .door.l{transform:perspective(900px) rotateY(-84deg)}
    .gate-door.opening .door.r{transform:perspective(900px) rotateY(84deg)}
    .door i{position:absolute;left:0;right:0;height:5.5%;
      background:linear-gradient(180deg,#3a3025,#191410);
      border-top:1px solid rgba(200,155,60,.16);
      border-bottom:1px solid rgba(0,0,0,.6)}
    .door i:nth-child(1){top:17%}
    .door i:nth-child(2){top:48%}
    .door i:nth-child(3){top:79%}
    .handle{position:absolute;top:45%;width:15%;aspect-ratio:1;border-radius:50%;
      border:2px solid rgba(200,155,60,.5);box-shadow:0 0 10px rgba(0,0,0,.85)}
    .door.l .handle{right:9%}
    .door.r .handle{left:9%}

    .keystone{position:absolute;top:-2.5%;left:50%;transform:translateX(-50%);
      width:17%;height:8%;z-index:3;border-radius:4px;
      background:linear-gradient(180deg,#3d3122,#161210);
      border:1px solid rgba(200,155,60,.38)}
    .step{position:absolute;bottom:-4.5%;left:-26%;right:-26%;height:4.5%;z-index:3;
      background:linear-gradient(180deg,#251e16,#0c0a08);
      border:1px solid rgba(200,155,60,.2);border-radius:4px}

    .seal-word{position:absolute;left:50%;top:53%;transform:translate(-50%,-50%);z-index:4;
      font-family:'Cinzel',serif;font-weight:600;white-space:nowrap;pointer-events:none;
      font-size:clamp(.6rem,2.1vw,.82rem);letter-spacing:.28em;text-transform:uppercase;
      color:var(--bright);text-shadow:0 0 20px rgba(0,0,0,.95),0 0 44px rgba(0,0,0,.85);
      transition:opacity 500ms ease}
    .gate-door.opening .seal-word{opacity:0}

    .mark-pop{position:absolute;z-index:6;width:min(15rem,72vw);
      background:rgba(10,9,8,.97);border:1px solid var(--oath);border-radius:12px;
      padding:.7rem .85rem;text-align:left;pointer-events:none;
      box-shadow:0 10px 30px rgba(0,0,0,.65);
      opacity:0;transform:translateY(4px);transition:opacity .18s ease,transform .18s ease}
    .mark-pop.on{opacity:1;transform:translateY(0)}
    .mark-pop b{display:block;font-family:'Cinzel',serif;font-size:.84rem;
      font-weight:400;color:var(--bright);margin-bottom:.22rem}
    .mark-pop span{display:block;font-size:.86rem;line-height:1.45;color:var(--text)}
    .mark-pop i{position:absolute;width:.55rem;height:.55rem;border-radius:50%;
      background:currentColor;top:.95rem;right:.85rem;opacity:.9}

    .name-wrap{max-width:34rem;margin:0 auto;padding:7rem 1.2rem 4rem;text-align:center}
    .name-head{font-family:'Cinzel',serif;font-weight:600;color:var(--bright);
      font-size:clamp(1.4rem,5vw,2.1rem);line-height:1.2;margin-bottom:.9rem}
    .name-field{display:flex;flex-direction:column;gap:.45rem;text-align:left;
      max-width:22rem;margin:1.8rem auto 0}
    .name-field>span{font-family:'Cormorant SC',serif;font-size:.6rem;
      letter-spacing:.22em;text-transform:uppercase;color:var(--dim)}
    .name-field input{width:100%;padding:.85rem 1rem;min-height:52px;
      border:1px solid var(--edge);border-radius:14px;background:rgba(0,0,0,.45);
      color:var(--bright);font:inherit;font-size:1.05rem;
      transition:border-color .2s}
    .name-field input:hover{border-color:rgba(200,155,60,.5)}
    .name-field input:focus-visible{outline:2px solid var(--oath);outline-offset:2px;
      border-color:var(--oath)}
    #screenName .nav{justify-content:center;margin-top:1.6rem}

    .gate-recent{display:flex;flex-direction:column;align-items:center;gap:.25rem;
      margin:.6rem auto 0;padding:1rem 1.3rem;max-width:26rem;
      border:1px solid var(--edge);border-radius:16px;background:rgba(0,0,0,.4)}
    .recent-label{font-family:'Cormorant SC',serif;font-size:.6rem;letter-spacing:.26em;
      text-transform:uppercase;color:var(--dim)}
    .recent-name{font-family:'Cinzel',serif;font-size:1.12rem;color:var(--bright);
      line-height:1.25}
    .recent-meta{font-family:'Cormorant SC',serif;font-size:.6rem;letter-spacing:.18em;
      text-transform:uppercase;color:var(--dim)}
    .recent-actions{display:flex;flex-wrap:wrap;gap:.55rem;justify-content:center;
      margin-top:.75rem}
    .recent-actions .btn{font-size:.6rem;padding:.6rem 1.1rem}

    .sigil-name{min-height:1.4rem;font-family:'Cormorant SC',serif;font-size:.64rem;
      letter-spacing:.26em;text-transform:uppercase;color:var(--dim);
      transition:color .3s ease}
    .sigil-name.on{color:var(--bright)}

    .gate-links{display:flex;flex-wrap:wrap;gap:.7rem;justify-content:center;margin-top:1.4rem}
    .gate-links button{font-family:'Cormorant SC',serif;font-size:.62rem;letter-spacing:.2em;
      text-transform:uppercase;color:var(--text);background:none;border:1px solid var(--edge);
      padding:.6rem 1.05rem;border-radius:999px;cursor:pointer;transition:color .3s,border-color .3s,background-color .3s}
    .gate-links button:hover{color:var(--bright);border-color:var(--oath)}
    .panel{max-width:34rem;margin:1.4rem auto 0;text-align:left;font-size:.95rem;
      border:1px solid var(--edge);border-left:3px solid var(--oath);border-radius:16px;padding:1.1rem 1.3rem;
      background:rgba(0,0,0,.35)}
    .panel h3{font-family:'Cinzel',serif;font-weight:400;color:var(--bright);
      font-size:1rem;margin-bottom:.5rem}
    .panel p{margin-bottom:.7rem;color:var(--dim)}
    .panel p:last-child{margin-bottom:0}

    /* the passing-through moment */
    .veil{position:fixed;inset:0;z-index:120;display:grid;place-items:center;
      background:#050403;opacity:0;pointer-events:none;transition:opacity 500ms ease}
    .veil.on{opacity:1}
    .veil span{font-family:'Cinzel',serif;letter-spacing:.42em;text-transform:uppercase;
      font-size:clamp(.7rem,3vw,1rem);color:var(--bright);opacity:0;transform:scale(.96)}
    .veil.on span{animation:declare 1400ms ease forwards}
    @keyframes declare{0%{opacity:0;transform:scale(.96)}30%{opacity:1;transform:scale(1)}
      75%{opacity:1}100%{opacity:0}}

    /* ─── the trials ─── */
    .hud{position:sticky;top:0;z-index:20;backdrop-filter:blur(8px);
      background:linear-gradient(to bottom,rgba(6,5,4,.92),rgba(6,5,4,.4));
      padding:4.6rem 1.2rem .8rem}
    .hud-in{max-width:44rem;margin:0 auto;display:flex;align-items:center;gap:1rem}
    .hud-count{font-family:'Cormorant SC',serif;font-size:.64rem;letter-spacing:.26em;
      text-transform:uppercase;color:var(--dim);white-space:nowrap}
    .hud-sigils{display:flex;gap:.42rem;margin-left:auto}
    .hud-sigils i{width:7px;height:7px;border-radius:50%;opacity:.3;display:block}
    .track{height:2px;background:rgba(255,255,255,.08);margin-top:.7rem;
      max-width:44rem;margin-inline:auto}
    .track i{display:block;height:100%;background:var(--oath);width:0;transition:width 600ms ease}

    .trial{max-width:44rem;margin:0 auto;padding:2.2rem 1.2rem 6rem}
    .scene-art{height:8.5rem;border:1px solid var(--edge);border-radius:16px;margin-bottom:1.6rem;
      background:linear-gradient(160deg,var(--scene-a),var(--scene-b));position:relative;overflow:hidden}
    .scene-art::after{content:'';position:absolute;inset:0;
      background:radial-gradient(ellipse at 30% 20%,rgba(255,220,160,.10),transparent 60%)}
    .scene-cap{position:absolute;left:0;right:0;bottom:0;padding:.7rem .9rem;font-size:.86rem;
      color:var(--text);background:linear-gradient(to top,rgba(0,0,0,.85),transparent);z-index:1}
    .trial-no{font-family:'Cormorant SC',serif;font-size:.62rem;letter-spacing:.3em;
      text-transform:uppercase;color:var(--oath);display:block;margin-bottom:.5rem}
    .trial h2{font-family:'Cinzel',serif;font-weight:600;color:var(--bright);
      font-size:clamp(1.25rem,4vw,1.9rem);line-height:1.25;margin-bottom:1rem}
    .prompt{font-size:1.06rem;margin-bottom:1.6rem}

    /* Choices and Crucible share one look: a lettered coin and a soft card.
       Selection has to be unmistakable at a glance, so the coin fills. */
    .choices{display:flex;flex-direction:column;gap:.7rem}
    .choice,.cru{display:flex;gap:.85rem;align-items:center;text-align:left;width:100%;
      background:rgba(12,10,8,.72);border:1px solid var(--edge);border-radius:16px;
      color:var(--text);font:inherit;cursor:pointer;
      transition:border-color .2s,background-color .2s,transform .12s,box-shadow .2s}
    .choice{padding:1rem 1.15rem;font-size:1rem}
    .choice:hover,.cru:hover{background:rgba(32,25,15,.88);
      border-color:rgba(200,155,60,.5);transform:translateY(-2px);
      box-shadow:0 6px 20px rgba(0,0,0,.45)}
    .choice:active,.cru:active{transform:translateY(0) scale(.985)}
    .choice:focus-visible,.cru:focus-visible{outline:2px solid var(--oath);
      outline-offset:3px;border-color:var(--oath)}
    .choice[aria-pressed="true"],.cru[aria-pressed="true"]{border-color:var(--oath);
      background:rgba(52,39,17,.92);
      box-shadow:inset 0 0 0 1px var(--oath),0 8px 26px rgba(0,0,0,.5)}

    /* the lettered coin */
    .choice b,.cru b{flex-shrink:0;display:grid;place-items:center;
      width:2.05rem;height:2.05rem;border-radius:50%;
      border:1px solid rgba(200,155,60,.4);background:rgba(0,0,0,.4);
      font-family:'Cinzel',serif;font-weight:600;font-size:.82rem;letter-spacing:0;
      color:var(--oath);
      transition:background-color .2s,color .2s,box-shadow .2s,transform .2s}
    .choice:hover b,.cru:hover b{border-color:var(--oath)}
    .choice[aria-pressed="true"] b,.cru[aria-pressed="true"] b{
      background:var(--oath);color:#12100c;border-color:var(--oath);
      box-shadow:0 0 18px rgba(200,155,60,.55);transform:scale(1.07)}

    .crucible{margin-top:2rem;padding-top:1.4rem;border-top:1px solid var(--edge)}
    .crucible.locked{opacity:.35;pointer-events:none}
    .crucible-q{font-family:'Cormorant SC',serif;font-size:.64rem;letter-spacing:.24em;
      text-transform:uppercase;color:var(--oath);margin-bottom:.9rem;display:block}
    .cru-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:.6rem}
    .cru{padding:.9rem 1rem;min-height:56px;font-size:.92rem}

    .nav{display:flex;gap:.7rem;margin-top:1.8rem;align-items:center;flex-wrap:wrap}
    .btn{font-family:'Cormorant SC',serif;font-size:.66rem;letter-spacing:.24em;
      text-transform:uppercase;padding:.8rem 1.6rem;border-radius:999px;cursor:pointer;
      border:1px solid var(--edge);background:none;color:var(--text);
      transition:color .25s,border-color .25s,background-color .25s,transform .12s,box-shadow .25s}
    .btn:active:not(:disabled){transform:scale(.97)}
    .btn:hover:not(:disabled){color:var(--bright);border-color:var(--oath)}
    .btn:disabled{opacity:.35;cursor:default}
    .btn.primary{background:var(--oath);border-color:var(--oath);color:#12100c}
    .btn.primary:hover:not(:disabled){background:#e0b45c;border-color:#e0b45c;color:#12100c}
    .nav-note{font-size:.85rem;color:var(--dim);margin-left:auto}

    /* ─── the record ─── */
    .result{max-width:44rem;margin:0 auto;padding:6.5rem 1.2rem 6rem}
    .rec-head{text-align:center;border-bottom:1px solid var(--edge);padding-bottom:2rem;margin-bottom:2rem}
    .rec-tier{font-family:'Cormorant SC',serif;font-size:.64rem;letter-spacing:.3em;
      text-transform:uppercase;color:var(--oath)}
    .rec-name{font-family:'Cinzel',serif;font-weight:700;color:var(--bright);
      font-size:clamp(1.7rem,6vw,3rem);line-height:1.15;margin:.8rem 0}
    .rec-tag{font-style:italic;font-size:1.08rem;max-width:32rem;margin:0 auto}
    .rec-art{height:11rem;margin:1.6rem 0 1.2rem;border:1px solid var(--edge);border-radius:18px;
      display:grid;place-items:center;position:relative;overflow:hidden;
      background:linear-gradient(150deg,#1a1510,#08070a)}
    .rec-art .glyphs{display:flex;gap:1.1rem;z-index:1}
    .rec-art .glyphs i{width:15px;height:15px;border-radius:50%;
      box-shadow:0 0 22px currentColor}
    .rec-art::after{content:'';position:absolute;inset:0;
      background:radial-gradient(ellipse at center,rgba(255,225,170,.10),transparent 65%)}

    section.block{margin-bottom:2.4rem}
    .block h3{font-family:'Cormorant SC',serif;font-size:.66rem;letter-spacing:.28em;
      text-transform:uppercase;color:var(--oath);margin-bottom:.9rem;
      padding-bottom:.55rem;border-bottom:1px solid var(--edge)}
    .block p{margin-bottom:.9rem}
    .block p:last-child{margin-bottom:0}

    .bars{display:flex;flex-direction:column;gap:.85rem}
    .bar-row{display:grid;grid-template-columns:6.6rem 1fr auto;gap:.8rem;align-items:center}
    .bar-name{font-size:.92rem;color:var(--bright)}
    .bar-track{height:9px;background:rgba(255,255,255,.07);border-radius:1px;overflow:hidden}
    .bar-fill{height:100%;width:0;transition:width 900ms cubic-bezier(.3,0,.2,1)}
    .bar-num{font-family:'Cormorant SC',serif;font-size:.6rem;letter-spacing:.14em;
      color:var(--dim);white-space:nowrap}
    .bar-row.off .bar-name{color:var(--dim)}
    .legend{margin-top:.9rem;font-size:.86rem;color:var(--dim);font-style:italic}

    .decide li{list-style:none;margin-bottom:.7rem;padding-left:1.1rem;position:relative}
    .decide li::before{content:'';position:absolute;left:0;top:.62em;width:6px;height:6px;
      border-radius:50%;background:var(--c)}

    details.tech{border:1px solid var(--edge);border-radius:2px;background:rgba(0,0,0,.3)}
    details.tech summary{padding:.9rem 1.1rem;cursor:pointer;list-style:none;
      font-family:'Cormorant SC',serif;font-size:.64rem;letter-spacing:.24em;
      text-transform:uppercase;color:var(--text)}
    details.tech summary::-webkit-details-marker{display:none}
    details.tech .tech-body{padding:0 1.1rem 1.1rem;font-size:.9rem;color:var(--dim)}
    details.tech table{width:100%;border-collapse:collapse;margin-bottom:.9rem}
    details.tech td{padding:.32rem 0;border-bottom:1px solid rgba(255,255,255,.06)}
    details.tech td:last-child{text-align:right;color:var(--text)}

    .science{font-size:.9rem;color:var(--dim);border:1px solid var(--edge);
      border-left:2px solid var(--oath);padding:1rem 1.1rem;background:rgba(0,0,0,.3)}
    .rec-limits{max-width:40rem;margin:2.4rem auto 0;text-align:center;font-style:italic;
      font-size:.88rem;color:var(--dim);padding-top:1.4rem;
      border-top:1px solid rgba(200,155,60,.15)}
    .rec-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin:2.4rem 0 1.4rem}

    @media (max-width:560px){
      body{font-size:17px}
      .hud{padding-top:4.2rem}
      .bar-row{grid-template-columns:5.2rem 1fr;grid-template-rows:auto auto}
      .bar-num{grid-column:1/-1;text-align:right}
      .nav-note{width:100%;margin-left:0}
    }
    @media (prefers-reduced-motion:reduce){
      *{animation-duration:.01ms !important;transition-duration:.01ms !important}
      html{scroll-behavior:auto}
      #grain{animation:none}
      .door{transition:none}
      .ring-runes{animation:none}
      .gateway{transform:none !important}
    }

    /* ─── the Mirror ─── */
    .hud-stage{font-family:'Cinzel',serif;font-size:.72rem;letter-spacing:.2em;
      text-transform:uppercase;color:var(--oath);margin-left:auto}
    .mirror-item{padding:1.1rem 0 1.3rem;border-bottom:1px solid rgba(200,155,60,.12)}
    .mirror-item:last-child{border-bottom:none}
    .mirror-q{font-size:1.02rem;color:var(--text);margin-bottom:.85rem}
    .scale{display:grid;grid-template-columns:repeat(auto-fit,minmax(8.5rem,1fr));gap:.45rem}
    .step-btn{display:flex;align-items:center;gap:.55rem;padding:.7rem .8rem;min-height:48px;
      background:rgba(12,10,8,.72);border:1px solid var(--edge);border-radius:14px;
      color:var(--dim);font:inherit;font-size:.82rem;text-align:left;cursor:pointer;
      transition:border-color .2s,background-color .2s,color .2s,transform .12s}
    .step-btn i{flex-shrink:0;width:.85rem;height:.85rem;border-radius:50%;
      border:1px solid rgba(200,155,60,.45);background:rgba(0,0,0,.4);
      transition:background-color .2s,box-shadow .2s}
    .step-btn:hover{border-color:rgba(200,155,60,.5);color:var(--text);transform:translateY(-1px)}
    .step-btn:active{transform:translateY(0) scale(.985)}
    .step-btn:focus-visible{outline:2px solid var(--oath);outline-offset:3px}
    .step-btn[aria-pressed="true"]{border-color:var(--oath);color:var(--bright);
      background:rgba(52,39,17,.92)}
    .step-btn[aria-pressed="true"] i{background:var(--oath);
      box-shadow:0 0 14px rgba(200,155,60,.6)}

    .choice.trade{align-items:flex-start;padding:1.15rem 1.2rem;font-size:1.04rem}
    .nav-note{font-size:.86rem;color:var(--dim);font-style:italic}

    /* ─── the record ─── */
    .record{max-width:46rem;margin:0 auto;padding:5.5rem 1.2rem 6rem}
    .rec-head{text-align:center;margin-bottom:2.6rem}
    .rec-tier{font-family:'Cormorant SC',serif;font-size:.66rem;letter-spacing:.32em;
      text-transform:uppercase;color:var(--oath);display:block;margin-bottom:.5rem}
    .rec-name{font-family:'Cinzel',serif;font-weight:700;color:var(--bright);
      font-size:clamp(1.9rem,7vw,3.2rem);line-height:1.1;letter-spacing:.03em}
    .rec-blend{font-family:'Cormorant SC',serif;font-size:.72rem;letter-spacing:.26em;
      text-transform:uppercase;color:var(--dim);margin-bottom:1rem}
    .rec-tag{font-style:italic;font-size:1.14rem;color:var(--text);margin-bottom:1.1rem}
    .rec-clarity{font-size:.92rem;color:var(--dim);margin-top:1rem}
    .rec-date{font-family:'Cormorant SC',serif;font-size:.62rem;letter-spacing:.24em;
      text-transform:uppercase;color:var(--dim);margin-top:1rem}

    .rec-block{margin:0 0 2.8rem}
    .page-no{display:block;font-family:'Cormorant SC',serif;font-size:.6rem;
      letter-spacing:.28em;text-transform:uppercase;color:var(--dim);margin-bottom:.45rem}
    .rec-block h2{font-family:'Cinzel',serif;font-weight:600;color:var(--bright);
      font-size:clamp(1.1rem,3.4vw,1.5rem);margin-bottom:1rem;padding-bottom:.55rem;
      border-bottom:1px solid rgba(200,155,60,.22)}
    .rec-block h3{font-family:'Cormorant SC',serif;font-size:.7rem;letter-spacing:.24em;
      text-transform:uppercase;color:var(--oath);margin:1.5rem 0 .6rem}
    .rec-block p{margin-bottom:1rem;font-size:1.02rem}
    .rec-block p:last-child{margin-bottom:0}
    .rec-block strong{color:var(--bright);font-weight:600}
    .prompts{list-style:none;margin:.4rem 0 1rem}
    .prompts li{position:relative;padding:.7rem 0 .7rem 1.5rem;font-size:1.02rem;
      border-bottom:1px solid rgba(200,155,60,.1)}
    .prompts li::before{content:'';position:absolute;left:.15rem;top:1.25rem;
      width:.4rem;height:.4rem;border-radius:50%;background:var(--oath)}
    .prompts li:last-child{border-bottom:none}

    .bars{margin:.2rem 0 1.4rem}
    .bar-row{display:flex;align-items:center;gap:.8rem;margin-bottom:.5rem}
    .bar-row.off{opacity:.55}
    .bar-name{flex:0 0 6.5rem;font-family:'Cinzel',serif;font-size:.82rem;color:var(--bright)}
    .bar-track{flex:1;height:9px;border-radius:99px;background:rgba(255,255,255,.07);
      overflow:hidden;min-width:3rem}
    .bar-fill{display:block;height:100%;border-radius:99px}
    .bar-num{flex:0 0 auto;font-size:.74rem;color:var(--dim);white-space:nowrap}
    .bar-note{font-size:.9rem;color:var(--dim);margin:0 0 1.1rem 0;padding-left:.1rem}

    .facet-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));
      gap:.7rem;margin-bottom:1.4rem}
    .facet-card{padding:.75rem .85rem;border:1px solid var(--edge);border-radius:14px;
      background:rgba(12,10,8,.6)}
    .facet-name{display:block;font-family:'Cinzel',serif;font-size:.78rem;
      color:var(--bright);margin-bottom:.45rem}
    .facet-card .bar-track{display:block;width:100%;margin-bottom:.4rem}
    .facet-band{font-size:.72rem;color:var(--dim);letter-spacing:.04em}

    .gap-list{margin-bottom:1.3rem}
    .gap-row{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;
      padding:.55rem 0;border-bottom:1px solid rgba(200,155,60,.1)}
    .gap-name{flex:1 1 8rem;font-family:'Cinzel',serif;font-size:.8rem;color:var(--bright)}
    .gap-num{font-size:.75rem;color:var(--dim);white-space:nowrap}
    .gap-tag{font-family:'Cormorant SC',serif;font-size:.62rem;letter-spacing:.16em;
      text-transform:uppercase;padding:.24rem .6rem;border-radius:99px;
      border:1px solid var(--edge);color:var(--dim);white-space:nowrap}
    .tag-HiddenStrength{color:#7fd6a0;border-color:rgba(127,214,160,.4)}
    .tag-Idealized{color:#d9a55f;border-color:rgba(217,165,95,.4)}

    .rec-limits{max-width:40rem;margin:2.4rem auto 0;text-align:center;font-style:italic;
      font-size:.88rem;color:var(--dim);padding-top:1.4rem;
      border-top:1px solid rgba(200,155,60,.15)}
    .rec-actions{display:flex;gap:.8rem;flex-wrap:wrap;justify-content:center;
      margin:2.6rem 0 1.6rem}
    .tech{border:1px solid var(--edge);border-radius:16px;background:rgba(0,0,0,.3);
      padding:.2rem .2rem}
    .tech summary{cursor:pointer;padding:.9rem 1.1rem;font-family:'Cormorant SC',serif;
      font-size:.66rem;letter-spacing:.24em;text-transform:uppercase;color:var(--dim)}
    .tech summary:hover{color:var(--bright)}
    .tech-body{padding:0 1.1rem 1.1rem}
    .tech-body p{font-size:.82rem;color:var(--dim);margin-bottom:.7rem;line-height:1.6}
    .tech-body .science{font-style:italic;padding-top:.7rem;
      border-top:1px solid rgba(200,155,60,.15)}

    @media (max-width:420px){
      .bar-name{flex:0 0 5rem;font-size:.74rem}
      .bar-num{font-size:.68rem}
      .record{padding-left:.9rem;padding-right:.9rem}
    }


    /* On a phone the gate ran past the fold, which put the two lower marks
       out of reach and left the page scrolling for no reason. Compact it
       when the screen is short rather than shrinking it for everyone. */
    @media (max-height:820px){
      .gate{padding:5.2rem 1.2rem 1.5rem;gap:.55rem}
      /* A returning visitor carries an extra card, and has already read the
         opening lines once. Give the space to the card instead. */
      .gate.with-recent .gate-lede{display:none}
      .gate.with-recent .gateway{width:min(13.5rem,54vw);margin:.4rem auto 0}
      .gate.with-recent{gap:.4rem;padding-bottom:.4rem}
      .gate.with-recent .gate-links{margin-top:.5rem}
      .gateway{width:min(17.5rem,70vw);margin:.7rem auto .1rem}
      .gate-lede{font-size:1rem}
      .gate-lede span:nth-child(2){display:none}
      .gate-links{margin-top:.8rem}
      .gate-small{margin-top:.3rem}
    }
    @media (max-height:680px){
      .gate{padding:4.6rem 1.2rem 1.8rem}
      .gateway{width:min(14rem,58vw)}
      .gate-lede span:nth-child(3){display:none}
    }
  </style>
</head>
<body>

<div id="scene"></div>
<div id="grain" aria-hidden="true"></div>
<div id="vig" aria-hidden="true"></div>
<div class="veil" id="veil" aria-hidden="true"><span>The Trial Begins</span></div>

<SiteHeader current="trial" accent="#C89B3C" dim="#6f685c" bright="#f0e8db" bg="rgba(10,9,8,.86)" />

<main>
  <!-- ── the gate ── -->
  <section class="screen on gate" id="screenGate">
    <span class="gate-eyebrow">A Rite of Judgment</span>
    <h1>The Fivefold Calling</h1>
    <p class="gate-lede">
      <span>Five Callings contend within every soul.</span>
      <span>Few answer only one.</span>
      <span>Forty statements will reveal which of them actually organise you.</span>
    </p>

    <div class="gateway" id="gateway">
      <div class="rune-ring" id="runeRing">
        <span class="ring-band" aria-hidden="true"></span>
        <span class="ring-band two" aria-hidden="true"></span>
        <span class="ring-runes" aria-hidden="true"></span>
        <span class="ring-runes inner" aria-hidden="true"></span>
      </div>

      <button class="gate-door" id="seal" aria-describedby="sealHint">
        <span class="pillar left" aria-hidden="true"></span>
        <span class="pillar right" aria-hidden="true"></span>
        <span class="arch" aria-hidden="true">
          <span class="arch-inner">
            <span class="gate-glow"></span>
            <span class="door l"><i></i><i></i><i></i><span class="handle"></span></span>
            <span class="door r"><i></i><i></i><i></i><span class="handle"></span></span>
          </span>
        </span>
        <span class="keystone" aria-hidden="true"></span>
        <span class="step" aria-hidden="true"></span>
        <span class="seal-word" id="sealWord">Begin the Trial</span>
      </button>
      <div class="mark-pop" id="markPop" role="status" aria-live="polite" hidden>
        <i aria-hidden="true"></i><b></b><span></span>
      </div>
    </div>
    <p class="sigil-name" id="sigilName" aria-live="polite">Touch the five marks, or open the gate</p>
    <div class="gate-recent" id="gateRecent" hidden>
      <span class="recent-label">Your most recent result</span>
      <span class="recent-name" id="recentName"></span>
      <span class="recent-meta" id="recentMeta"></span>
      <div class="recent-actions">
        <button type="button" class="btn primary" id="btnResume">Read the full record</button>
        <button type="button" class="btn" id="btnRetake">Take the Trial again</button>
      </div>
    </div>
    <p class="gate-small" id="sealHint">A research-inspired fantasy assessment. Roughly 8 to 12 minutes.</p>

    <div class="gate-links">
      <button type="button" data-panel="how">How the Trial Works</button>
      <button type="button" data-panel="science">About the Science</button>
      <button type="button" data-panel="privacy">Privacy</button>
    </div>

    <div class="panel" id="panelHow" hidden>
      <h3>How the Trial works</h3>
      <p>Forty statements, five to a page. For each one you say how true it is of you, from strongly disagree to strongly agree.</p>
      <p>Eight statements stand behind each of the five Callings. Some are written the other way round on purpose, so that simply agreeing with everything does not produce a flattering result.</p>
      <p>No score is shown while you answer, so nothing nudges you toward a result. You may go back and change any answer before the end. Your progress is kept on this device, so a refresh will not lose it.</p>
    </div>
    <div class="panel" id="panelScience" hidden>
      <h3>About the science</h3>
      <p>A research-inspired fantasy personality assessment. It is not a validated clinical or diagnostic instrument, and it is not a measure of who you objectively are.</p>
      <p>The Five Callings are a fantasy translation of themes from trait psychology. Each is measured by eight statements on a five point scale, and your score for a Calling is where your answers to those eight fall between the lowest and highest possible totals.</p>
      <p>Affinity is a score on this test's own scale. A Watch of 80 does not mean you are eighty percent vigilant as an objective fact. It means your answers sat high on the range this test can measure.</p>
    </div>
    <div class="panel" id="panelPrivacy" hidden>
      <h3>Privacy</h3>
      <p>No account, name or email is required. Your answers stay in this browser, on this device. Nothing is sent to a server and nothing is stored about you elsewhere.</p>
      <p>Clearing your browser data, or choosing Retake the Trial, removes them.</p>
    </div>
  </section>

  <!-- ── the assessment: the Mirror, the Trial, the Scales ── -->
  <!-- Asked before every attempt, including a retake, because the record is
       addressed to whoever is taking it now. -->
  <section class="screen" id="screenName">
    <div class="name-wrap">
      <span class="trial-no">Before the first question</span>
      <h2 class="name-head">What should the record call you?</h2>
      <p class="prompt">Your name is written into the record itself. It is kept on this device with your answers and is never sent anywhere.</p>
      <label class="name-field">
        <span>Your name</span>
        <input type="text" id="nameInput" maxlength="40" autocomplete="given-name"
               placeholder="Alfar" aria-describedby="nameNote" />
      </label>
      <p class="age-note" id="nameNote" aria-live="polite"></p>
      <div class="nav">
        <button class="btn primary" id="btnName" type="button">Begin</button>
        <button class="btn" id="btnNameSkip" type="button">Continue without a name</button>
      </div>
    </div>
  </section>

  <section class="screen" id="screenTrial">
    <div class="hud">
      <div class="hud-in">
        <span class="hud-count" id="hudCount">0 answered</span>
        <span class="hud-stage" id="hudStage">The Mirror</span>
      </div>
      <div class="track"><i id="trackFill"></i></div>
    </div>

    <div class="trial">
      <!-- the statements -->
      <div id="stageAsk">
        <span class="trial-no" id="askNo"></span>
        <h2 id="askHead">How true is each of these of you?</h2>
        <p class="prompt">Answer as you actually are rather than as you would like to be. There are no right answers, and no statement counts for more than any other.</p>
        <div id="askList"></div>
      </div>

      <div class="nav">
        <button class="btn" id="btnBack" type="button">Back</button>
        <button class="btn primary" id="btnNext" type="button" disabled>Next</button>
        <span class="nav-note" id="navNote"></span>
      </div>
    </div>
  </section>

  <!-- ── the record ── -->
  <section class="screen" id="screenResult">
    <div class="record" id="record"></div>
  </section>


</main>

<script define:vars={{ TONES }}>
  window.__TRIAL_TONES = TONES;
</script>

<script>
  import { CALLINGS, ORDER, QUESTIONS, SCALE } from '../../data/fivefold.js';
  import { analyse, DEPTH } from '../../lib/fivefold-deep.js';
  import { buildFivefold } from '../../lib/fivefold-report.js';

  const TONES = window.__TRIAL_TONES;
  const $ = (id) => document.getElementById(id);
  const KEY = 'lash.fivefold.v2';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The forty core statements decide the archetype. The ten Depth Module
  // statements only sharpen the report and can never change the result.
  const ALL = [...QUESTIONS, ...DEPTH];
  const CORE = QUESTIONS.length;
  const PER_PAGE = 5;
  const PAGES = Math.ceil(ALL.length / PER_PAGE);

  const fresh = () => ({ page: 0, answers: Array(ALL.length).fill(null),
                         name: '', done: false });
  let state = fresh();
  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (saved && Array.isArray(saved.answers) && saved.answers.length === ALL.length) state = saved;
  } catch { /* start clean */ }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} };
  const answered = () => state.answers.filter((x) => x !== null).length;

  const show = (id) => {
    ['screenGate', 'screenName', 'screenTrial', 'screenResult'].forEach((s) =>
      $(s).classList.toggle('on', s === id));
    window.scrollTo({ top: 0, behavior: 'auto' });
  };
  const tone = (i) => {
    const [a, b] = TONES[i % TONES.length] || TONES[0];
    document.documentElement.style.setProperty('--scene-a', a);
    document.documentElement.style.setProperty('--scene-b', b);
  };

  // ── the gate ──
  const gateway = $('gateway');
  const sigilName = $('sigilName');
  const REST = 'Touch the five marks, or open the gate';
  const lit = new Set();
  const glow = (s) => {
    s.classList.add('lit');
    s.querySelector('i').style.boxShadow = '0 0 20px ' + s.style.color + ', 0 0 42px ' + s.style.color;
  };
  const MEASURES = {
    O: 'principle, fairness and keeping your word',
    H: 'loyalty, attachment and protecting your own',
    F: 'discipline, preparation and seeing things through',
    V: 'influence, persuasion and reading a room',
    W: 'caution, verification and looking for what is hidden',
  };
  const pop = $('markPop');
  function openPop(mark, cal, measures) {
    pop.hidden = false;
    pop.style.color = cal.colour;
    pop.style.borderColor = cal.colour;
    pop.querySelector('b').textContent = cal.name;
    pop.querySelector('span').textContent = 'Measures ' + measures + '.';
    const box = gateway.getBoundingClientRect();
    const m = mark.getBoundingClientRect();
    const cx = m.left - box.left + m.width / 2;
    const cy = m.top - box.top + m.height / 2;
    const w = pop.offsetWidth, h = pop.offsetHeight;
    const left = Math.max(-14, Math.min(cx - w / 2, box.width - w + 14));
    const top = cy < box.height / 2 ? cy + 26 : cy - h - 26;
    pop.style.left = left + 'px';
    pop.style.top = Math.max(-10, top) + 'px';
    void pop.offsetHeight;
    pop.classList.add('on');
  }
  function closePop() {
    pop.classList.remove('on');
    setTimeout(() => { if (!pop.classList.contains('on')) pop.hidden = true; }, 200);
  }
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePop(); });

  (function placeSigils() {
    const ring = $('runeRing');
    ORDER.forEach((k, i) => {
      const cal = CALLINGS[k];
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'sigil';
      b.style.color = cal.colour;
      b.setAttribute('aria-label', cal.name + '. ' + MEASURES[k]);
      b.innerHTML = '<i></i>';
      const angle = (-90 + i * 72) * (Math.PI / 180);
      b.style.left = 'calc(50% + ' + (Math.cos(angle) * 46) + '% - 18px)';
      b.style.top = 'calc(50% + ' + (Math.sin(angle) * 46) + '% - 18px)';
      const touch = () => {
        glow(b); lit.add(k);
        openPop(b, cal, MEASURES[k]);
        sigilName.textContent = lit.size === 5 ? 'All five answer. The way is open.' : REST;
        sigilName.classList.toggle('on', lit.size === 5);
        if (lit.size === 5) gateway.classList.add('all-lit');
      };
      b.addEventListener('pointerenter', touch);
      b.addEventListener('focus', touch);
      b.addEventListener('click', (e) => { e.stopPropagation(); touch(); });
      const rest = () => { if (lit.size < 5) closePop(); };
      b.addEventListener('pointerleave', rest);
      b.addEventListener('blur', rest);
      ring.appendChild(b);
    });
  })();

  if (!reduced) {
    gateway.addEventListener('pointermove', (e) => {
      const r = gateway.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / r.width;
      const dy = (e.clientY - (r.top + r.height / 2)) / r.height;
      gateway.style.transform =
        'perspective(900px) rotateY(' + (dx * 7) + 'deg) rotateX(' + (-dy * 7) + 'deg)';
    });
    gateway.addEventListener('pointerleave', () => { gateway.style.transform = ''; });
  }

  $('seal').addEventListener('click', () => {
    const seal = $('seal');
    if (seal.classList.contains('opening')) return;
    closePop();
    if (reduced) { enter(); return; }
    seal.classList.add('opening');
    gateway.classList.add('all-lit');
    [...$('runeRing').querySelectorAll('.sigil')]
      .forEach((s, i) => setTimeout(() => glow(s), 90 * i));
    setTimeout(() => { $('veil').classList.add('on'); }, 950);
    setTimeout(enter, 1800);
    setTimeout(() => $('veil').classList.remove('on'), 2800);
  });

  // Past the gate the reader is asked their name, every time, including on a
  // retake, because the record is addressed to whoever is sitting there now.
  function enter() {
    if (answered() > 0 && state.name) { show('screenTrial'); render(); return; }
    show('screenName');
    $('nameInput').value = state.name || '';
    setTimeout(() => $('nameInput').focus(), 60);
  }

  function acceptName(name) {
    state.name = (name || '').trim().slice(0, 40);
    save();
    show('screenTrial');
    render();
  }
  $('btnName').addEventListener('click', () => {
    const v = $('nameInput').value.trim();
    if (!v) { $('nameNote').textContent = 'Enter a name, or continue without one.'; return; }
    $('nameNote').textContent = '';
    acceptName(v);
  });
  $('btnNameSkip').addEventListener('click', () => acceptName(''));
  $('nameInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); $('btnName').click(); }
  });

  document.querySelectorAll('[data-panel]').forEach((b) => {
    b.addEventListener('click', () => {
      const id = { how: 'panelHow', science: 'panelScience', privacy: 'panelPrivacy' }[b.dataset.panel];
      const panel = $(id);
      const wasOpen = !panel.hidden;
      ['panelHow', 'panelScience', 'panelPrivacy'].forEach((p) => { $(p).hidden = true; });
      panel.hidden = wasOpen;
    });
  });

  // ── the statements, five to a page ──
  function render() {
    tone(state.page);
    window.scrollTo({ top: 0, behavior: 'auto' });
    const from = state.page * PER_PAGE;
    const items = ALL.slice(from, from + PER_PAGE);
    $('askNo').textContent = 'Page ' + (state.page + 1) + ' of ' + PAGES;
    $('hudStage').textContent = from >= CORE ? 'Depth' : 'The Fivefold Calling';

    const box = $('askList');
    box.innerHTML = '';
    items.forEach((item, n) => {
      const idx = from + n;
      const wrap = document.createElement('div');
      wrap.className = 'mirror-item';
      const q = document.createElement('p');
      q.className = 'mirror-q';
      q.textContent = item.n + '. ' + item.t;
      wrap.appendChild(q);
      const row = document.createElement('div');
      row.className = 'scale';
      row.setAttribute('role', 'group');
      row.setAttribute('aria-label', item.t);
      SCALE.forEach((sc) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'step-btn';
        b.setAttribute('aria-pressed', String(state.answers[idx] === sc.v));
        b.innerHTML = '<i></i><span></span>';
        b.querySelector('span').textContent = sc.t;
        b.addEventListener('click', () => { state.answers[idx] = sc.v; save(); paint(); });
        row.appendChild(b);
      });
      wrap.appendChild(row);
      box.appendChild(wrap);
    });
    paint();
  }

  function paint() {
    const from = state.page * PER_PAGE;
    const idxs = ALL.slice(from, from + PER_PAGE).map((_, n) => from + n);
    idxs.forEach((idx, n) => {
      const row = $('askList').children[n];
      if (!row) return;
      [...row.querySelector('.scale').children].forEach((b, si) =>
        b.setAttribute('aria-pressed', String(state.answers[idx] === SCALE[si].v)));
    });
    const left = idxs.filter((i) => state.answers[i] === null).length;
    const done = answered();
    $('hudCount').textContent = done + ' of ' + ALL.length + ' answered';
    $('trackFill').style.width = ((done / ALL.length) * 100) + '%';
    $('btnBack').disabled = state.page === 0;
    $('btnNext').disabled = left > 0;
    $('btnNext').textContent = state.page === PAGES - 1 ? 'Receive Your Calling' : 'Next';
    $('navNote').textContent = left ? left + ' still to answer on this page.' : '';
    save();
  }

  $('btnBack').addEventListener('click', () => {
    if (state.page === 0) return;
    state.page--; save(); render();
  });
  $('btnNext').addEventListener('click', () => {
    if (state.page === PAGES - 1) { finish(); return; }
    state.page++; save(); render();
  });

  // ── the record ──
  let lastDoc = null, lastResult = null;
  const longDate = (ms) => new Date(ms).toLocaleDateString(undefined,
    { year: 'numeric', month: 'long', day: 'numeric' });

  function startOver() {
    state = fresh(); save();
    $('gateRecent').hidden = true;
    $('screenGate').classList.remove('with-recent');
    show('screenGate');
    lit.clear(); gateway.classList.remove('all-lit');
    $('seal').classList.remove('opening');
    sigilName.textContent = REST; sigilName.classList.remove('on');
    document.querySelectorAll('.sigil').forEach((s) => {
      s.classList.remove('lit'); s.querySelector('i').style.boxShadow = '';
    });
  }

  const readResult = () => analyse(
    state.answers.slice(0, CORE),
    state.answers.slice(CORE),
    { name: state.name }
  );

  function finish() {
    if (!state.done || !state.completedAt) {
      state.done = true;
      state.completedAt = state.completedAt || Date.now();
    }
    save();
    lastResult = readResult();
    lastDoc = buildFivefold(lastResult,
      state.completedAt ? { completedAt: longDate(state.completedAt) } : {});
    drawRecord(lastDoc, lastResult);
    show('screenResult');
  }

  const el = (tag, cls, text) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };
  // a **lead-in.** at the start of a paragraph becomes a real bold opening
  const para = (text) => {
    const p = el('p');
    const m = /^\*\*(.+?)\*\*\s*(.*)$/s.exec(String(text));
    if (m) { p.appendChild(el('strong', null, m[1])); p.append(' ' + m[2]); }
    else p.textContent = text;
    return p;
  };

  function drawRecord(doc, r) {
    const root = $('record');
    root.innerHTML = '';

    // the verdict
    const head = el('div', 'rec-head');
    head.appendChild(el('span', 'rec-tier', doc.verdict.tier));
    head.appendChild(el('h1', 'rec-name', doc.verdict.name));
    const art = el('div', 'rec-art');
    art.setAttribute('role', 'img');
    art.setAttribute('aria-label', doc.verdict.name + '. ' + doc.verdict.blend + '.');
    const glyphs = el('span', 'glyphs');
    doc.verdict.active.forEach((k) => {
      const i = el('i');
      i.style.background = CALLINGS[k].colour;
      i.style.boxShadow = '0 0 18px ' + CALLINGS[k].colour;
      i.title = CALLINGS[k].name;
      glyphs.appendChild(i);
    });
    art.appendChild(glyphs);
    head.appendChild(art);
    head.appendChild(el('p', 'rec-blend', doc.verdict.blend));
    head.appendChild(el('p', 'rec-tag', doc.verdict.motto));
    head.appendChild(el('p', 'rec-date', 'Completed ' + doc.verdict.when));
    root.appendChild(head);

    for (const page of doc.pages) {
      const sec = el('section', 'rec-block');
      sec.appendChild(el('span', 'page-no', 'Page ' + page.n + ' of ' + doc.pages.length));
      sec.appendChild(el('h2', null, page.title));

      // all five affinities, always
      if (page.bars) {
        const bars = el('div', 'bars');
        page.bars.forEach((b) => {
          const row = el('div', 'bar-row' + (b.active ? '' : ' off'));
          row.appendChild(el('span', 'bar-name', b.name));
          const track = el('span', 'bar-track');
          const fill = el('i', 'bar-fill');
          fill.style.width = Math.max(2, b.affinity) + '%';
          fill.style.background = b.colour;
          track.appendChild(fill);
          row.appendChild(track);
          row.appendChild(el('span', 'bar-num',
            b.affinity + ' · ' + b.band + (b.active ? ' · active' : '')));
          bars.appendChild(row);
          bars.appendChild(el('p', 'bar-note', b.modifier));
        });
        sec.appendChild(bars);
      }

      (page.paras || []).forEach((t) => sec.appendChild(para(t)));

      // the identity cards
      if (page.cards) {
        const grid = el('div', 'facet-grid');
        page.cards.forEach((c) => {
          const card = el('div', 'facet-card');
          card.appendChild(el('span', 'facet-name', c.label));
          card.appendChild(el('span', 'facet-band', c.text));
          grid.appendChild(card);
        });
        sec.appendChild(grid);
      }

      // the decision pathway and the six scales
      if (page.flow) {
        const f = el('p', 'bar-note',
          page.flow.map((x) => x.name).join('  →  '));
        sec.appendChild(f);
      }
      if (page.scales) {
        const bars = el('div', 'bars');
        page.scales.forEach((s) => {
          const row = el('div', 'bar-row');
          row.appendChild(el('span', 'bar-name', s.low));
          const track = el('span', 'bar-track');
          const fill = el('i', 'bar-fill');
          fill.style.width = Math.max(2, s.value) + '%';
          fill.style.background = 'var(--oath)';
          track.appendChild(fill);
          row.appendChild(track);
          row.appendChild(el('span', 'bar-num', s.high));
          bars.appendChild(row);
        });
        sec.appendChild(bars);
      }

      // what you mean against what others may hear
      if (page.perception && page.perception.length) {
        sec.appendChild(el('h3', null, 'What you mean, and what they may hear'));
        const ul = el('ul', 'prompts');
        page.perception.forEach((t) => ul.appendChild(el('li', null, t)));
        sec.appendChild(ul);
      }

      for (const [label, key] of [['Ideal conditions', 'ideal'], ['Bad environment', 'bad'],
                                  ['Your place in the party', 'party']]) {
        if (page[key] && page[key].length) {
          sec.appendChild(el('h3', null, label));
          const ul = el('ul', 'prompts');
          page[key].forEach((t) => ul.appendChild(el('li', null, t)));
          sec.appendChild(ul);
        }
      }

      // balanced, strained, shadow, return
      if (page.sequence) {
        const grid = el('div', 'facet-grid');
        page.sequence.forEach((s) => {
          const card = el('div', 'facet-card');
          card.appendChild(el('span', 'facet-name', s.label));
          card.appendChild(el('span', 'facet-band', s.text));
          grid.appendChild(card);
        });
        sec.appendChild(grid);
      }

      if (page.growth && page.growth.length) {
        sec.appendChild(el('h3', null, 'Growth roadmap'));
        const ul = el('ul', 'prompts');
        page.growth.forEach((t) => ul.appendChild(el('li', null, t)));
        sec.appendChild(ul);
      }

      if (page.closing) sec.appendChild(para(page.closing));
      root.appendChild(sec);
    }

    root.appendChild(el('p', 'rec-limits', doc.pages[doc.pages.length - 1].disclaimer));

    const actions = el('div', 'rec-actions');
    const dl = el('button', 'btn primary', 'Download Your Record');
    dl.id = 'btnDownload'; dl.type = 'button';
    const again = el('button', 'btn', 'Take the Trial Again');
    again.type = 'button';
    actions.appendChild(dl); actions.appendChild(again);
    root.appendChild(actions);
    dl.addEventListener('click', onDownload);
    again.addEventListener('click', startOver);

    const tech = doc.pages[doc.pages.length - 1].technical;
    if (tech) {
      const det = el('details', 'tech');
      det.appendChild(el('summary', null, 'How this was scored, and what it does not claim'));
      const body = el('div', 'tech-body');
      tech.forEach((l) => body.appendChild(el('p', null, l)));
      det.appendChild(body);
      root.appendChild(det);
    }
  }

  async function onDownload() {
    const btn = $('btnDownload');
    const was = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Sealing the record...';
    try {
      const { buildTrialRecord } = await import('../../lib/trial-report.js');
      const blob = await buildTrialRecord(lastDoc, lastResult);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'The Fivefold Calling - ' + lastDoc.verdict.name + '.pdf';
      document.body.appendChild(a);
      a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 4000);
      btn.textContent = 'Record downloaded';
      setTimeout(() => { btn.textContent = was; btn.disabled = false; }, 2500);
    } catch (err) {
      btn.textContent = 'Could not build the record';
      btn.disabled = false;
      console.error(err);
    }
  }

  // ── where to begin ──
  $('btnResume').addEventListener('click', finish);
  $('btnRetake').addEventListener('click', startOver);

  if (state.done) {
    try {
      const past = readResult();
      $('recentName').textContent = past.chapter.name
        .toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
      const tierWorth = past.chapter.name.toLowerCase().includes(past.tier.toLowerCase())
        ? '' : past.tier;
      const when = state.completedAt ? longDate(state.completedAt) : '';
      $('recentMeta').textContent = [state.name, tierWorth, when].filter(Boolean).join(' · ');
      $('gateRecent').hidden = false;
      $('screenGate').classList.add('with-recent');
    } catch {
      $('gateRecent').hidden = true;
    }
  } else if (answered() > 0 && state.name) { show('screenTrial'); render(); }
</script>

</body>
</html>
