<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Codex | LASH</title>
  <meta name="description" content="The Foundation Age Codex: Titans, mortals, realms, and relics of the LASH universe." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Cormorant+SC:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:          #0a0704;
      --card:        #120d08;
      --gold:        #c4952a;
      --gold-light:  #e8c875;
      --gold-pale:   #f2e4b8;
      --bronze:      #8a5a2b;
      --text:        #c9baa0;
      --text-dim:    #7a6a54;
      --text-bright: #ede0c4;
      --line:        rgba(196,149,42,0.18);
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'EB Garamond', serif;
      font-size: 17px;
      line-height: 1.75;
      overflow-x: hidden;
      cursor: none;
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse at center, transparent 40%, rgba(10,7,4,0.8) 100%);
      pointer-events: none;
      z-index: 0;
    }

    #cursor {
      position: fixed;
      width: 7px; height: 7px;
      background: var(--gold);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%);
      box-shadow: 0 0 8px var(--gold), 0 0 22px rgba(196,149,42,0.5);
    }
    #cursor-ring {
      position: fixed;
      width: 30px; height: 30px;
      border: 1px solid rgba(196,149,42,0.3);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9998;
      transform: translate(-50%, -50%);
    }

    #dust-canvas {
      position: fixed;
      inset: 0;
      width: 100%; height: 100%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.55;
    }

    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 10;
      padding: 1.6rem 2.2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(to bottom, rgba(10,7,4,0.9) 0%, transparent 100%);
    }
    .nav-back {
      font-family: 'Cormorant SC', serif;
      font-size: 0.65rem;
      letter-spacing: 0.4em;
      color: var(--text-dim);
      text-decoration: none;
      transition: color 0.3s;
    }
    .nav-back:hover { color: var(--gold); }
    .nav-series {
      font-family: 'Cormorant SC', serif;
      font-size: 0.62rem;
      letter-spacing: 0.35em;
      color: var(--text-dim);
    }

    /* PAGES MENU */
    .pages-menu { position: relative; }
    .pages-toggle {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: none;
      border: none;
      cursor: pointer;
      font: inherit;
      padding: 0;
    }
    .pages-caret {
      color: var(--gold);
      font-size: 0.6rem;
      transition: transform 0.3s ease;
    }
    .pages-toggle[aria-expanded="true"] .pages-caret { transform: rotate(180deg); }
    .pages-panel {
      position: absolute;
      top: calc(100% + 1rem);
      right: 0;
      min-width: 15rem;
      background: rgba(10,7,4,0.97);
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 0.5rem;
      display: flex;
      flex-direction: column;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-6px);
      transition: opacity 0.25s ease, transform 0.25s ease;
      backdrop-filter: blur(10px);
    }
    .pages-panel.open { opacity: 1; pointer-events: auto; transform: translateY(0); }
    .pages-item {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.65rem 0.8rem;
      text-decoration: none;
      border-radius: 2px;
      transition: background-color 0.2s ease;
    }
    .pages-item:hover, .pages-item:focus-visible { background: rgba(196,149,42,0.08); outline: none; }
    .pages-item-num {
      font-family: 'Cormorant SC', serif;
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--bronze);
    }
    .pages-item-title {
      font-family: 'EB Garamond', serif;
      font-size: 0.9rem;
      color: var(--text);
    }
    .pages-item:hover .pages-item-title, .pages-item:focus-visible .pages-item-title { color: var(--gold-light); }
    .pages-item.is-current .pages-item-title { color: var(--gold); }

    /* HERO */
    .hero {
      position: relative;
      min-height: 92vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 1;
      padding: 6rem 2rem 4rem;
      text-align: center;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 90% 55% at 50% 40%, rgba(196,149,42,0.08) 0%, transparent 70%);
    }
    .hero-eyebrow {
      font-family: 'Cormorant SC', serif;
      font-size: 0.72rem;
      letter-spacing: 0.42em;
      color: var(--gold);
      text-transform: uppercase;
      opacity: 0;
      animation: fadeUp 1s ease forwards 0.3s;
      margin-bottom: 1.6rem;
    }
    .hero-title {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(3rem, 9vw, 6.5rem);
      font-weight: 700;
      letter-spacing: 0.05em;
      line-height: 1.05;
      background: linear-gradient(180deg, var(--gold-pale) 0%, var(--gold) 55%, rgba(138,90,43,0.5) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      opacity: 0;
      animation: fadeUp 1.3s ease forwards 0.6s;
    }
    .hero-divider {
      width: 140px; height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
      margin: 2rem auto;
      opacity: 0;
      animation: fadeIn 1s ease forwards 1.2s;
    }
    .hero-tagline {
      font-family: 'EB Garamond', serif;
      font-style: italic;
      font-size: clamp(1rem, 2.2vw, 1.3rem);
      color: var(--text);
      max-width: 560px;
      opacity: 0;
      animation: fadeUp 1s ease forwards 1.5s;
    }
    .hero-note {
      margin-top: 2.5rem;
      font-family: 'Cormorant SC', serif;
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--text-dim);
      opacity: 0;
      animation: fadeIn 1s ease forwards 2s;
    }

    /* SECTION SHELL */
    .section {
      position: relative;
      z-index: 1;
      max-width: 74rem;
      margin: 0 auto;
      padding: 5rem 2rem;
    }
    .section-myth { max-width: 42rem; }
    .section-head {
      text-align: center;
      margin-bottom: 3.5rem;
    }
    .section-label {
      font-family: 'Cormorant SC', serif;
      font-size: 0.72rem;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: var(--gold);
      opacity: 0.8;
      display: block;
      margin-bottom: 1rem;
    }
    .section-title {
      font-family: 'Cinzel', serif;
      font-weight: 600;
      font-size: clamp(1.6rem, 4vw, 2.4rem);
      color: var(--text-bright);
      letter-spacing: 0.03em;
    }
    .section-note {
      margin-top: 1rem;
      font-style: italic;
      color: var(--text-dim);
      font-size: 1rem;
    }
    .ornament {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.2rem;
      color: var(--gold);
      font-size: 0.7rem;
      margin: 1.5rem 0 0;
    }
    .ornament::before, .ornament::after {
      content: '';
      width: 60px; height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold));
    }
    .ornament::after { background: linear-gradient(90deg, var(--gold), transparent); }

    /* MYTH PROSE */
    .myth-chapter { margin-bottom: 3.5rem; }
    .myth-heading {
      font-family: 'Cinzel', serif;
      font-size: 1.1rem;
      letter-spacing: 0.08em;
      color: var(--gold-light);
      margin-bottom: 1.2rem;
      text-align: center;
    }
    .myth-chapter p {
      margin-bottom: 1.2rem;
      color: var(--text);
      font-size: 1.05rem;
    }
    .myth-chapter:first-of-type p.first::first-letter {
      font-family: 'Cinzel Decorative', serif;
      font-size: 3.6em;
      float: left;
      line-height: 0.72;
      padding-right: 0.1em;
      padding-top: 0.05em;
      color: var(--gold);
      text-shadow: 0 0 24px rgba(196,149,42,0.4);
    }

    /* GROUP HEADER (within character/artifact registers) */
    .group {
      margin-bottom: 3.5rem;
    }
    .group-head {
      margin-bottom: 1.6rem;
      text-align: center;
    }
    .group-roman {
      font-family: 'Cormorant SC', serif;
      font-size: 0.65rem;
      letter-spacing: 0.3em;
      color: var(--text-dim);
      display: block;
      margin-bottom: 0.4rem;
    }
    .group-title {
      font-family: 'Cinzel', serif;
      font-size: 1.15rem;
      letter-spacing: 0.05em;
      color: var(--gold-light);
    }
    .group-note {
      font-style: italic;
      color: var(--text-dim);
      font-size: 0.9rem;
      margin-top: 0.4rem;
    }

    /* CARD GRID */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
      gap: 1.4rem;
    }
    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 3px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .card-image {
      position: relative;
      aspect-ratio: 2 / 3;
      overflow: hidden;
      background: #050403;
    }
    .card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: saturate(0.85) brightness(0.82);
      transition: transform 8s ease, filter 0.6s ease;
    }
    .card:hover .card-image img {
      transform: scale(1.06);
      filter: saturate(0.95) brightness(0.92);
    }
    .card-image::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 55%, rgba(10,7,4,0.9) 100%);
    }
    .card-image-empty {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-dim);
      font-family: 'Cormorant SC', serif;
      letter-spacing: 0.3em;
      font-size: 0.62rem;
      text-transform: uppercase;
    }
    .card-body {
      padding: 1.1rem 1.2rem 1.3rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      flex: 1;
    }
    .card-name {
      font-family: 'Cinzel', serif;
      font-size: 1.02rem;
      color: var(--text-bright);
      letter-spacing: 0.02em;
    }
    .card-subtitle {
      font-family: 'Cormorant SC', serif;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold);
      opacity: 0.85;
    }
    .card-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin-top: 0.3rem;
    }
    .card-bullets li {
      font-size: 0.86rem;
      color: var(--text-dim);
      padding-left: 0.9rem;
      position: relative;
      line-height: 1.5;
    }
    .card-bullets li::before {
      content: '·';
      position: absolute;
      left: 0;
      color: var(--gold);
    }
    .card-legacy {
      margin-top: auto;
      padding-top: 0.7rem;
      border-top: 1px solid var(--line);
      font-style: italic;
      font-size: 0.82rem;
      color: var(--gold-light);
    }
    .card-field-label {
      font-family: 'Cormorant SC', serif;
      font-size: 0.62rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-top: 0.4rem;
    }
    .card-field-value {
      font-size: 0.86rem;
      color: var(--text);
    }
    .card-num {
      font-variant-numeric: tabular-nums;
      color: var(--text-dim);
    }

    /* REVEAL */
    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.9s ease, transform 0.9s ease;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* CLOSING */
    .closing {
      text-align: center;
      padding: 2rem 2rem 8rem;
      max-width: 34rem;
      margin: 0 auto;
    }
    .closing p {
      font-style: italic;
      color: var(--text-dim);
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }
    .closing-back {
      display: inline-block;
      font-family: 'Cormorant SC', serif;
      font-size: 0.72rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--gold);
      text-decoration: none;
      border: 1px solid var(--line);
      padding: 0.7rem 1.4rem;
      transition: color 0.3s, border-color 0.3s;
    }
    .closing-back:hover { color: var(--gold-light); border-color: var(--gold); }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    @media (max-width: 640px) {
      .section { padding: 3.5rem 1.3rem; }
      .grid { grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr)); gap: 1rem; }
    }
  </style>
</head>
<body>

<div id="cursor"></div>
<div id="cursor-ring"></div>
<canvas id="dust-canvas"></canvas>

<nav class="nav">
  <a href="/" class="nav-back">← LASH</a>
  <div class="pages-menu">
    <button class="pages-toggle" id="pagesToggle" aria-expanded="false" aria-controls="pagesPanel">
      <span class="nav-series">The Codex</span>
      <span class="pages-caret">▾</span>
    </button>
    <div class="pages-panel" id="pagesPanel">
      <a href="/" class="pages-item">
        <span class="pages-item-num">№ 001</span>
        <span class="pages-item-title">The Spear That Was Not Meant to Exist</span>
      </a>
      <a href="/serpent-wars" class="pages-item">
        <span class="pages-item-num">№ 002</span>
        <span class="pages-item-title">The Serpent Wars</span>
      </a>
      <a href="/icetear" class="pages-item">
        <span class="pages-item-num">№ 003</span>
        <span class="pages-item-title">The Icetear Legacy</span>
      </a>
      <a href="/codex" class="pages-item is-current">
        <span class="pages-item-num">Reference</span>
        <span class="pages-item-title">The Codex</span>
      </a>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <span class="hero-eyebrow">A Record Kept Where Fire Cannot Reach</span>
  <h1 class="hero-title">The Codex</h1>
  <div class="hero-divider"></div>
  <p class="hero-tagline">Titans, mortals, realms, and relics of the Foundation Age — the world beneath every story told here.</p>
  <p class="hero-note">Book I · The Foundation Age</p>
</section>

<!-- MYTH -->
<section class="section section-myth" id="myth">
  {myth.map((chapter, i) => (
    <div class="myth-chapter reveal">
      <h2 class="myth-heading">{chapter.heading}</h2>
      {chapter.body.map((para, j) => (
        <p class={i === 0 && j === 0 ? "first" : ""}>{para}</p>
      ))}
    </div>
  ))}
  <div class="ornament reveal">✦</div>
</section>

<!-- CHARACTER REGISTER -->
<section class="section" id="characters">
  <div class="section-head reveal">
    <span class="section-label">Key Character Register</span>
    <h2 class="section-title">Who Shaped the Age</h2>
  </div>

  {characterGroups.map((group) => (
    <div class="group">
      <div class="group-head reveal">
        <span class="group-roman">{group.roman}</span>
        <h3 class="group-title">{group.title}</h3>
        {group.note && <p class="group-note">{group.note}</p>}
      </div>
      <div class="grid">
        {group.entries.map((c) => (
          <div class="card reveal">
            <div class="card-image">
              <img src={`/images/codex/${c.img}.jpg`} alt={c.name} loading="lazy" width="480" height="720" />
            </div>
            <div class="card-body">
              <div class="card-name">{c.name}</div>
              <div class="card-subtitle">{c.subtitle}</div>
              {c.bullets.length > 0 && (
                <ul class="card-bullets">
                  {c.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
              {c.legacy && <div class="card-legacy">{c.legacy}</div>}
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

<!-- LOCATIONS -->
<section class="section" id="locations">
  <div class="section-head reveal">
    <span class="section-label">Geographic &amp; Metaphysical Locations</span>
    <h2 class="section-title">Where It Happened</h2>
  </div>
  <div class="grid">
    {locations.map((loc) => (
      <div class="card reveal">
        <div class="card-image">
          <img src={`/images/codex/${loc.img}.jpg`} alt={loc.name} loading="lazy" width="480" height="720" />
        </div>
        <div class="card-body">
          <div class="card-name"><span class="card-num">{loc.num}.</span> {loc.name}</div>
          <div class="card-subtitle">{loc.type}</div>
          <p class="card-field-value">{loc.desc}</p>
          <div class="card-legacy">{loc.importance}</div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ARTIFACTS -->
<section class="section" id="artifacts">
  <div class="section-head reveal">
    <span class="section-label">Key Artifact Register</span>
    <h2 class="section-title">What Endured</h2>
  </div>

  {artifactGroups.map((group) => (
    <div class="group">
      <div class="group-head reveal">
        <span class="group-roman">{group.roman}</span>
        <h3 class="group-title">{group.title}</h3>
        {group.note && <p class="group-note">{group.note}</p>}
      </div>
      <div class="grid">
        {group.entries.map((a) => (
          <div class="card reveal">
            <div class="card-image">
              {a.img ? (
                <img src={`/images/codex/${a.img}.jpg`} alt={a.name} loading="lazy" width="480" height="720" />
              ) : (
                <div class="card-image-empty">Undepicted</div>
              )}
            </div>
            <div class="card-body">
              <div class="card-name">{a.name}</div>
              <div class="card-subtitle">Bearer: {a.bearer}</div>
              <div class="card-field-label">Origin</div>
              <div class="card-field-value">{a.origin}</div>
              <div class="card-field-label">Nature</div>
              <div class="card-field-value">{a.nature}</div>
              <ul class="card-bullets">
                {a.bullets.map((b) => <li>{b}</li>)}
              </ul>
              <div class="card-legacy">{a.significance}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

<div class="closing reveal">
  <div class="ornament">✦</div>
  <p>More chronicles remain sealed — historical accounts and untold chapters of the Foundation Age, kept for another day.</p>
  <a href="/" class="closing-back">Return to LASH</a>
</div>

<script>
  // CURSOR
  const cursor = document.getElementById('cursor');
  const ring   = document.getElementById('cursor-ring');
  let mx = 0, my = 0, rx = 0, ry = 0;
  document.addEventListener('mousemove', e => {
    mx = e.clientX; my = e.clientY;
    cursor.style.left = mx + 'px';
    cursor.style.top  = my + 'px';
  });
  (function trackRing() {
    rx += (mx - rx) * 0.1;
    ry += (my - ry) * 0.1;
    ring.style.left = rx + 'px';
    ring.style.top  = ry + 'px';
    requestAnimationFrame(trackRing);
  })();

  // PAGES MENU
  const pagesToggle = document.getElementById('pagesToggle');
  const pagesPanel  = document.getElementById('pagesPanel');
  if (pagesToggle && pagesPanel) {
    pagesToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = pagesPanel.classList.toggle('open');
      pagesToggle.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!pagesPanel.contains(e.target) && e.target !== pagesToggle) {
        pagesPanel.classList.remove('open');
        pagesToggle.setAttribute('aria-expanded', 'false');
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        pagesPanel.classList.remove('open');
        pagesToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // DUST MOTES
  const canvas = document.getElementById('dust-canvas');
  const ctx    = canvas.getContext('2d');
  let W = canvas.width  = window.innerWidth;
  let H = canvas.height = window.innerHeight;
  window.addEventListener('resize', () => {
    W = canvas.width  = window.innerWidth;
    H = canvas.height = window.innerHeight;
  });

  function mkMote() {
    const maxLife = 260 + Math.random() * 300;
    return {
      x: Math.random() * W,
      y: Math.random() * H,
      size: 0.4 + Math.random() * 1.6,
      vx: (Math.random() - 0.5) * 0.15,
      vy: -(0.03 + Math.random() * 0.12),
      life: Math.random() * maxLife,
      maxLife,
    };
  }

  const motes = Array.from({ length: 60 }, mkMote);
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    (function loop() {
      ctx.clearRect(0, 0, W, H);
      for (const m of motes) {
        m.x += m.vx + Math.sin(m.life * 0.02) * 0.12;
        m.y += m.vy;
        m.life++;
        if (m.y < -10 || m.life > m.maxLife) Object.assign(m, mkMote(), { y: H + 10, life: 0 });
        const alpha = Math.sin((m.life / m.maxLife) * Math.PI) * 0.5;
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(196,149,42,${alpha})`;
        ctx.fill();
      }
      requestAnimationFrame(loop);
    })();
  }

  // SCROLL REVEAL
  const io = new IntersectionObserver(
    entries => entries.forEach(en => { if (en.isIntersecting) en.target.classList.add('visible'); }),
    { threshold: 0.05, rootMargin: '0px 0px -30px 0px' }
  );
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>

</body>
</html>
