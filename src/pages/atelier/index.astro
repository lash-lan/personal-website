---
// The private character workshop. Not part of the public site: it carries its
// own markup rather than the shared layout so that nothing here can leak into
// the pages visitors see, and so that it can ask search engines to ignore it.
import { env } from 'cloudflare:workers';
import { ticketHolds, ticketFrom } from '../../lib/session.js';

export const prerender = false;

const unlocked = await ticketHolds(env.ATELIER_SESSION_SECRET, ticketFrom(Astro.cookies));

const problem = {
  wrong: 'That is not the password.',
  unconfigured: 'The password has not been set on the server yet.',
}[Astro.url.searchParams.get('e') ?? ''] ?? '';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Atelier</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Cormorant+SC:wght@300;400&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #0a0908; --panel: #131110; --line: rgba(196,149,42,0.18);
      --accent: #c4952a; --accentLight: #e8c875;
      --text: #c9baa0; --textDim: #7a6a54; --textBright: #ede0c4;
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--bg); color: var(--text);
      font-family: 'EB Garamond', Georgia, serif; font-size: 17px;
      min-height: 100dvh;
    }
    /* The workshop manages its own height and only the transcript scrolls.
       Without this the page itself scrolls on a phone — where 100vh means the
       height with the address bar hidden — and carries the top bar, and with
       it the way into the character panel, up out of sight. */
    body.workshop { height: 100dvh; overflow: hidden; }
    h1 {
      font-family: 'Cinzel', Georgia, serif; font-weight: 600;
      color: var(--textBright); font-size: 1.5rem; letter-spacing: 0.04em;
    }
    label {
      display: block; font-family: 'Cormorant SC', Georgia, serif;
      font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--textDim); margin-bottom: 0.4rem;
    }
    input[type=text], input[type=password], textarea {
      width: 100%; background: #0a0908; color: var(--text);
      border: 1px solid var(--line); border-radius: 3px;
      padding: 0.6rem 0.7rem; font-family: inherit; font-size: 0.95rem;
      resize: vertical;
    }
    input:focus, textarea:focus { outline: none; border-color: var(--accent); }
    button {
      font-family: 'Cormorant SC', Georgia, serif;
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      background: transparent; color: var(--text);
      border: 1px solid var(--line); border-radius: 3px;
      padding: 0.55rem 1.1rem; cursor: pointer;
      transition: color 0.3s ease, border-color 0.3s ease;
    }
    button:hover:not(:disabled) { color: var(--accentLight); border-color: var(--accent); }
    button:disabled { opacity: 0.4; cursor: default; }

    /* ─── LOCK ─── */
    .lock {
      min-height: 100vh; display: grid; place-items: center; padding: 2rem;
    }
    .lock form {
      width: min(22rem, 100%); display: flex; flex-direction: column; gap: 1rem;
      text-align: center;
    }
    .lock h1 { font-size: 1.2rem; }
    .problem { color: #c46a4a; font-size: 0.85rem; min-height: 1.2em; }

    /* ─── WORKSHOP ─── */
    .shell {
      display: grid; grid-template-columns: minmax(18rem, 24rem) 1fr;
      gap: 1px; background: var(--line); height: 100dvh;
    }
    .side, .main { background: var(--bg); min-height: 0; }
    .side { padding: 1.5rem 1.3rem; display: flex; flex-direction: column; gap: 1.1rem; overflow-y: auto; }
    .main { display: flex; flex-direction: column; min-height: 0; }
    .topbar, .only-small { display: none; }
    .head { display: flex; align-items: center; gap: 0.6rem; }

    .who { display: flex; gap: 0.9rem; align-items: center; }
    .face {
      width: 4.2rem; height: 4.2rem; flex: none; border-radius: 50%;
      border: 1px solid var(--line); object-fit: cover; background: var(--panel);
      display: grid; place-items: center; color: var(--textDim); font-size: 0.7rem;
    }
    .who input { font-family: 'Cinzel', Georgia, serif; }

    .log { flex: 1; overflow-y: auto; padding: 1.6rem clamp(1rem, 4vw, 3rem); display: flex; flex-direction: column; gap: 1.3rem; }
    .turn { display: flex; gap: 0.9rem; max-width: 46rem; }
    .turn.me { align-self: flex-end; flex-direction: row-reverse; }
    .turn img, .turn .blank {
      width: 2.2rem; height: 2.2rem; flex: none; border-radius: 50%;
      border: 1px solid var(--line); object-fit: cover;
    }
    .said { white-space: pre-wrap; line-height: 1.65; }
    .turn.me .said { color: var(--textBright); }
    .turn .said em { color: var(--accentLight); font-style: italic; }

    .ask { border-top: 1px solid var(--line); padding: 1rem clamp(1rem, 4vw, 3rem); display: flex; gap: 0.7rem; align-items: flex-end; }
    .ask textarea { flex: 1; min-height: 3rem; max-height: 12rem; }

    .note { font-size: 0.78rem; color: var(--textDim); line-height: 1.5; }

    /* ─── DOCUMENTS ─── */
    .docs { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.5rem; }
    .doc {
      display: flex; align-items: center; gap: 0.5rem;
      border: 1px solid var(--line); border-radius: 3px;
      padding: 0.4rem 0.55rem; font-size: 0.82rem;
    }
    .doc-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--textBright); }
    .doc-size { color: var(--textDim); font-size: 0.72rem; flex: none; }
    .doc-drop {
      flex: none; border: none; background: none; color: var(--textDim);
      cursor: pointer; padding: 0 0.2rem; font-size: 0.9rem; letter-spacing: 0;
    }
    .doc-drop:hover { color: #c46a4a; }
    .drop {
      display: block; text-align: center; cursor: pointer;
      border: 1px dashed var(--line); border-radius: 3px;
      padding: 0.65rem; margin-bottom: 0.5rem;
      font-family: 'Cormorant SC', Georgia, serif;
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--textDim);
      transition: color 0.3s ease, border-color 0.3s ease;
    }
    .drop:hover, .drop.over { color: var(--accentLight); border-color: var(--accent); }
    .meter { font-size: 0.74rem; color: var(--textDim); margin-top: 0.45rem; line-height: 1.5; }
    .meter.full { color: #c46a4a; }
    .empty-hint {
      margin: auto; max-width: 22rem; text-align: center;
      color: var(--textDim); font-style: italic; line-height: 1.6;
    }
    .row { display: flex; gap: 0.6rem; }
    .row button { flex: 1; }

    /* On a phone the conversation IS the page. The character panel slides in
       over it, because scrolling past every setup field to reach the chat is
       the wrong way round when chatting is what you opened it for. */
    @media (max-width: 800px) {
      .shell { grid-template-columns: 1fr; gap: 0; }
      .only-small { display: block; }

      .topbar {
        display: flex; align-items: center; gap: 0.7rem; flex: none;
        padding: 0.55rem 0.9rem; border-bottom: 1px solid var(--line);
      }
      .topbar .face-sm {
        width: 2.1rem; height: 2.1rem; border-radius: 50%; flex: none;
        border: 1px solid var(--line); background: var(--panel);
        background-size: cover; background-position: center;
      }
      .topbar .whoami {
        flex: 1; min-width: 0; font-family: 'Cinzel', Georgia, serif;
        color: var(--textBright); font-size: 0.95rem;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .topbar button { padding: 0.45rem 0.75rem; }

      .side {
        position: fixed; inset: 0; z-index: 50;
        transform: translateX(-100%);
        transition: transform 0.28s ease;
        padding-bottom: calc(2.5rem + env(safe-area-inset-bottom));
      }
      .side.open { transform: none; }

      .main { height: 100dvh; }
      .log { padding: 1.1rem 0.9rem; }
      .turn { max-width: 100%; }
      .ask { padding: 0.7rem 0.9rem calc(0.7rem + env(safe-area-inset-bottom)); }
    }
  </style>
</head>
<body class={unlocked ? 'workshop' : ''}>

{!unlocked && (
  <div class="lock">
    <form method="POST" action="/api/login">
      <h1>Atelier</h1>
      <div>
        <label for="p">Password</label>
        <input type="password" id="p" name="password" autocomplete="current-password" autofocus required />
      </div>
      <p class="problem">{problem}</p>
      <button type="submit">Enter</button>
    </form>
  </div>
)}

{unlocked && (
  <div class="shell">
    <aside class="side" id="side">
      <div class="head">
        <h1 style="flex:1">Atelier</h1>
        <button type="button" id="shut" class="only-small">Done</button>
      </div>

      <div class="who">
        <label for="face" class="face" id="faceWrap" style="margin:0">Portrait</label>
        <input type="file" id="face" accept="image/*" hidden />
        <div style="flex:1">
          <label for="name">Character</label>
          <input type="text" id="name" placeholder="Unnamed" />
        </div>
      </div>

      <div>
        <label for="instructions">Instructions</label>
        <textarea id="instructions" rows="10" placeholder="Who they are, how they speak, what they do with actions, who you are to them. Describe more than one character here if you want a scene."></textarea>
      </div>

      <div>
        <label>Knowledge base</label>
        <div class="docs" id="docs"></div>
        <label for="docfile" class="drop" id="drop">Add documents</label>
        <input type="file" id="docfile" multiple hidden />
        <textarea id="knowledge" rows="5" placeholder="…or type notes straight in here."></textarea>
        <p class="meter" id="meter"></p>
      </div>

      <div class="row">
        <button type="button" id="save">Save</button>
        <button type="button" id="clear">Clear chat</button>
      </div>

      <p class="note" id="status">Saved in this browser only.</p>
    </aside>

    <main class="main">
      <div class="topbar">
        <div class="face-sm" id="faceSm"></div>
        <div class="whoami" id="whoami">Unnamed</div>
        <button type="button" id="panel">Character</button>
      </div>
      <div class="log" id="log"></div>
      <form class="ask" id="ask">
        <textarea id="say" rows="1" placeholder="Say something…" autofocus></textarea>
        <button type="submit" id="send">Send</button>
      </form>
    </main>
  </div>
)}

<script>
  import { shrinkPortrait, readDocument, KINDS } from '../../lib/atelier-files.js';

  const $ = (id) => document.getElementById(id);
  const log = $('log');
  if (log) {
    // Everything the character can draw on rides along with every message, so
    // the budget below is really a budget on what each reply costs and on what
    // the model can hold at once. Roughly four characters to a token.
    const BUDGET = 60000;
    const size = (n) => (n > 1e6 ? (n / 1e6).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1000)) + ' KB');
    const STORE = 'atelier.character.v1';
    const fields = { name: $('name'), instructions: $('instructions'), knowledge: $('knowledge') };
    let portrait = '';
    let docs = [];          // [{ name, text }]
    let messages = [];
    let busy = false;

    $('docfile').accept = KINDS;

    /** Everything the character may draw on: the documents, then your notes. */
    const knowledgeText = () => [
      ...docs.map((d) => `— ${d.name} —\n${d.text}`),
      fields.knowledge.value.trim(),
    ].filter(Boolean).join('\n\n');

    // ─── the character, kept in this browser ───
    /** Returns true if there is a character here already. */
    const load = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(STORE) || '{}');
        for (const k of Object.keys(fields)) if (saved[k]) fields[k].value = saved[k];
        if (saved.portrait) setFace(saved.portrait);
        if (Array.isArray(saved.docs)) docs = saved.docs;
      } catch {}
      drawDocs();
      return Boolean(fields.name.value.trim() || fields.instructions.value.trim());
    };
    const save = () => {
      try {
        localStorage.setItem(STORE, JSON.stringify({
          name: fields.name.value, instructions: fields.instructions.value,
          knowledge: fields.knowledge.value, portrait, docs,
        }));
        say('Saved.');
      } catch (err) {
        say(err?.name === 'QuotaExceededError'
          ? 'Too much to store in this browser. Remove a document and save again.'
          : 'Could not save — the browser refused.');
      }
    };
    const say = (t) => { $('status').textContent = t; };

    function setFace(dataUrl) {
      portrait = dataUrl;
      for (const el of [$('faceWrap'), $('faceSm')]) {
        if (!el) continue;
        el.style.backgroundImage = `url(${dataUrl})`;
        el.style.backgroundSize = 'cover';
        el.style.backgroundPosition = 'center';
        el.textContent = '';
      }
    }

    // The phone's top bar mirrors who you are talking to.
    const echoName = () => {
      const w = $('whoami');
      if (w) w.textContent = fields.name.value.trim() || 'Unnamed';
    };
    fields.name.addEventListener('input', echoName);

    const side = $('side');
    $('panel')?.addEventListener('click', () => side.classList.toggle('open'));
    $('shut')?.addEventListener('click', () => side.classList.remove('open'));

    // Any size of image is fine. It is scaled down here before being kept,
    // because a portrait is shown a few centimetres across and storing the
    // original would fill the browser's cupboard for no visible gain.
    $('face').addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      say('Preparing the portrait…');
      try {
        setFace(await shrinkPortrait(file));
        say(`Portrait set, from ${size(file.size)}.`);
      } catch (err) {
        say(err.message || 'That image could not be read.');
      }
      e.target.value = '';
    });

    // ─── documents ───
    function drawDocs() {
      const list = $('docs');
      list.innerHTML = '';
      for (const [i, d] of docs.entries()) {
        const row = document.createElement('div');
        row.className = 'doc';
        const name = document.createElement('span');
        name.className = 'doc-name';
        name.textContent = d.name;
        const len = document.createElement('span');
        len.className = 'doc-size';
        len.textContent = size(d.text.length);
        const drop = document.createElement('button');
        drop.type = 'button';
        drop.className = 'doc-drop';
        drop.textContent = '✕';
        drop.title = `Remove ${d.name}`;
        drop.addEventListener('click', () => { docs.splice(i, 1); drawDocs(); });
        row.append(name, len, drop);
        list.append(row);
      }
      drawMeter();
    }

    // What every single message carries, and therefore what it costs.
    function drawMeter() {
      const used = knowledgeText().length;
      const m = $('meter');
      const pct = Math.round((used / BUDGET) * 100);
      m.classList.toggle('full', used > BUDGET);
      m.textContent = used === 0
        ? 'Nothing here yet. Documents are read on this device; the text goes with every message.'
        : `${size(used)} of reference — about ${pct}% of a comfortable load, sent with every message.` +
          (used > BUDGET ? ' This is more than the character can hold well. Remove something.' : '');
    }

    fields.knowledge.addEventListener('input', drawMeter);

    async function takeFiles(files) {
      for (const file of files) {
        say(`Reading ${file.name}…`);
        try {
          const text = await readDocument(file, (m) => say(`${file.name}: ${m}`));
          if (!text.trim()) { say(`${file.name} had no readable text in it.`); continue; }
          docs = docs.filter((d) => d.name !== file.name);
          docs.push({ name: file.name, text });
          drawDocs();
          say(`Added ${file.name} — ${size(text.length)} of text.`);
        } catch (err) {
          say(err.message || `Could not read ${file.name}.`);
        }
      }
    }

    $('docfile').addEventListener('change', async (e) => {
      await takeFiles([...e.target.files]);
      e.target.value = '';
    });

    // Dragging files onto the panel works too, for when you are at a desk.
    const dz = $('drop');
    for (const ev of ['dragenter', 'dragover']) {
      dz.addEventListener(ev, (e) => { e.preventDefault(); dz.classList.add('over'); });
    }
    for (const ev of ['dragleave', 'drop']) {
      dz.addEventListener(ev, (e) => { e.preventDefault(); dz.classList.remove('over'); });
    }
    dz.addEventListener('drop', (e) => takeFiles([...(e.dataTransfer?.files ?? [])]));

    $('save').addEventListener('click', () => { save(); echoName(); side.classList.remove('open'); });
    $('clear').addEventListener('click', () => { messages = []; log.innerHTML = ''; say('Chat cleared.'); });
    // Anything the character says or is asked replaces the standing hint.
    const dropHint = () => log.querySelector('.empty-hint')?.remove();

    // ─── the conversation ───
    function bubble(role, text) {
      const turn = document.createElement('div');
      turn.className = 'turn' + (role === 'user' ? ' me' : '');
      const face = document.createElement(role === 'assistant' && portrait ? 'img' : 'div');
      if (face.tagName === 'IMG') face.src = portrait; else face.className = 'blank';
      const said = document.createElement('div');
      said.className = 'said';
      said.textContent = text;
      turn.append(face, said);
      log.append(turn);
      log.scrollTop = log.scrollHeight;
      return said;
    }

    $('ask').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;
      const text = $('say').value.trim();
      if (!text) return;

      $('say').value = '';
      dropHint();
      messages.push({ role: 'user', content: text });
      bubble('user', text);

      busy = true;
      $('send').disabled = true;
      const out = bubble('assistant', '…');
      let reply = '';

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages,
            instructions: fields.instructions.value,
            knowledge: knowledgeText(),
          }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          out.textContent = err.error || `Something went wrong (${res.status}).`;
          messages.pop();
          return;
        }

        const reader = res.body.getReader();
        const dec = new TextDecoder();
        let buffer = '';

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += dec.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop() ?? '';
          for (const line of lines) {
            if (!line.startsWith('data:')) continue;
            const payload = line.slice(5).trim();
            if (!payload || payload === '[DONE]') continue;
            try {
              const piece = JSON.parse(payload).choices?.[0]?.delta?.content;
              if (piece) { reply += piece; out.textContent = reply; log.scrollTop = log.scrollHeight; }
            } catch {}
          }
        }

        if (reply) messages.push({ role: 'assistant', content: reply });
        else { out.textContent = 'It returned nothing.'; messages.pop(); }
      } catch (err) {
        out.textContent = 'The connection failed.';
        messages.pop();
      } finally {
        busy = false;
        $('send').disabled = false;
        $('say').focus();
      }
    });

    // Enter sends, Shift+Enter makes a new line.
    $('say').addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); $('ask').requestSubmit(); }
    });

    // With no character yet, open on the panel rather than on an empty chat.
    // This is a place for building characters; talking to nobody is not the
    // point of arriving here.
    const hasCharacter = load();
    echoName();
    if (!hasCharacter) {
      side.classList.add('open');
      const hint = document.createElement('p');
      hint.className = 'empty-hint';
      hint.textContent = 'Give them a name and some instructions, press Save, and this is where you will talk.';
      log.append(hint);
    }
  }
</script>
</body>
</html>
