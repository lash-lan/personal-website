---
// The opening of the home page: the fight on the ice, then a drop of blood.
// Every visitor gets the still picture and the title below. When motion is
// allowed, src/scripts/film.js turns the section into a scroll-driven film.
---
<section class="film" aria-label="Hansall and the young Hannah Icetear lock blades on a frozen field under the moon">
  <div class="film-stage">
    <!-- Phones get the portrait frame here too, or the two of them would be
         cropped out of the still exactly as they were out of the film. -->
    <picture>
      <source media="(max-width: 819px)" srcset="/cine/open-p-800.webp" />
      <source srcset="/cine/open-960.webp 960w, /cine/open-1536.webp 1536w" sizes="100vw" />
      <img
        class="film-still"
        src="/cine/open-960.webp"
        alt="Hansall, masked and crowned in gold, and the young Hannah Icetear in blue and silver armour, face each other across a frozen lake under the moon."
        fetchpriority="high"
      />
    </picture>
    <div class="film-title">
      <div class="film-wordmark" role="img" aria-label="Blood of Icetear: a world of frost and ember">
        <!-- The still base is the transparent artwork, so visitors who never
             see the videos (reduced motion, no JavaScript) get the title on
             the scene rather than on a black plate. -->
        <img
          src="/cine/logo-1400.webp"
          srcset="/cine/logo-900.webp 900w, /cine/logo-1400.webp 1400w, /cine/logo-2000.webp 2000w"
          sizes="(max-width: 819px) 92vw, min(74vw, 1100px)"
          alt="" width="2133" height="717" decoding="async"
        />
        <video class="wordmark-cycle" muted playsinline loop preload="auto" aria-hidden="true" src="/cine/title-cycle.mp4"></video>
      </div>
    </div>
    <button class="film-enter" type="button" hidden>
      <span>Enter</span>
      <small>with sound</small>
    </button>
  </div>
</section>

<script>
  import { startFilm } from '../scripts/film.js';
  const section = document.querySelector('.film');
  if (section) startFilm(section);
</script>

<style is:global>
  /* ─── the still (everyone), and the stage the film plays on ─── */
  .film { position: relative; background: #05080f; }
  .film-stage {
    position: relative;
    height: min(92vh, 66.6vw + 4rem);
    min-height: 26rem;
    overflow: hidden;
  }
  .film-still {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 60%;
  }
  .film-stage::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 28%;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  /* ─── the title ─── */
  .film-title {
    position: absolute; left: 0; right: 0; top: 7%;
    text-align: center; padding: 0 1.5rem;
    z-index: 3; pointer-events: none;
  }
  /* The title is the artwork itself: forged iron and faesilver, bleeding and
     freezing. The files carry a black background rather than transparency, so
     the layer is blended with screen: black falls away and only the metal,
     blood and frost remain over the ice. */
  .film-wordmark {
    position: relative; margin: 0 auto;
    width: min(74vw, 1100px); aspect-ratio: 3 / 1;
    filter: drop-shadow(0 14px 34px rgba(0, 0, 0, 0.7));
  }
  .film-wordmark img,
  .film-wordmark video {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: contain;
  }
  /* The videos carry a black background rather than transparency. Blending it
     away would also eat the dark iron inside the letters and leave them
     hollow, so the shape is cut out instead: the mask is the silhouette of
     everything that ever lights up across the animation. */
  .film-wordmark video {
    pointer-events: none;
    -webkit-mask-image: url('/cine/title-mask.png?v=2');
    mask-image: url('/cine/title-mask.png?v=2');
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  /* The freezing and thawing cycle, faded in over the still artwork. The two
     are framed differently, so the still is faded out as the cycle arrives:
     left underneath it would double every letter. */
  .wordmark-cycle { opacity: 0; transition: opacity 0.5s linear; }
  .film-wordmark img { transition: opacity 0.5s linear; }
  .film-wordmark.is-looping .wordmark-cycle { opacity: 1; }
  .film-wordmark.is-looping img { opacity: 0; }
  @media (max-width: 819px) { .film-wordmark { width: 92vw; } }
  @media (prefers-reduced-motion: reduce) { .film-wordmark video { display: none; } }

  /* ─── the film (only when film.js adds .is-on) ─── */
  .film.is-on { height: 340vh; }
  .film.is-on .film-stage {
    position: sticky; top: 0;
    height: 100vh; height: 100svh; min-height: 0;
  }
  .film.is-on .film-still,
  .film.is-on .film-stage::after { display: none; }
  .film.is-on .film-title[hidden] { display: none; }
  /* the title's home while the film runs: in among the footage, not above it */
  .film-title-layer {
    position: absolute; left: 0; right: 0; top: 12%;
    display: flex; justify-content: center;
    padding: 0 1.5rem; pointer-events: none;
  }
  .film.is-on .film-wordmark { opacity: 0; }
  .film.is-on .film-blood, .film.is-on .film-ice { font-size: clamp(2.4rem, 7.4vw, 5.2rem); }
  @media (max-width: 819px) { .film.is-on { height: 280vh; } }

  .film-layers { position: absolute; inset: 0; overflow: hidden; }
  .film-video {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
    background: #05080f;
  }
  /* On a tall screen, filling it would crop the shot down to hands and blades,
     so the whole frame is shown, over a blurred view of the same field. */
  /* Transparent, or the video element's own background hides the backdrop.
     The box is made wider than the screen so the shot plays larger; the outer
     edges of the frame fall outside the screen, but nothing important does. */
  @media (max-width: 819px) {
    .film-video { object-fit: contain; background: transparent; width: 150%; left: -25%; }
  }
  /* With the portrait cut there is nothing to letterbox: the frame is already
     the shape of the screen, so it fills it and the blurred field behind it
     is not needed. */
  .film.is-tall-cut .film-video { object-fit: cover; width: 100%; left: 0; }
  .film.is-tall-cut .film-backdrop { display: none; }
  .film-backdrop { position: absolute; inset: 0; visibility: hidden; }
  .film-backdrop img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: blur(14px) brightness(0.45) saturate(0.8); transform: scale(1.08);
  }
  /* One quiet prompt over the first frame. Browsers keep every page silent
     until the reader has clicked, tapped or typed, and scrolling does not
     count; this gives them one thing to click, so the strike is heard. */
  .film-enter {
    position: absolute; left: 50%; top: 58%; transform: translate(-50%, -50%);
    z-index: 5; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    padding: 0.9rem 2.4rem 0.8rem;
    background: rgba(5, 8, 15, 0.42); color: #eaf3fb;
    border: 1px solid rgba(207, 227, 242, 0.35); border-radius: 2px;
    font-family: 'Cormorant SC', Georgia, serif; cursor: pointer;
    transition: opacity 0.5s ease, border-color 0.35s ease, background-color 0.35s ease;
    backdrop-filter: blur(3px);
  }
  .film-enter[hidden] { display: none; }
  .film-enter span { font-size: 0.86rem; letter-spacing: 0.5em; text-transform: uppercase; padding-left: 0.5em; }
  .film-enter small { font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; color: #cfe3f2; opacity: 0.7; padding-left: 0.3em; }
  .film-enter:hover, .film-enter:focus-visible {
    border-color: rgba(207, 227, 242, 0.75);
    background: rgba(5, 8, 15, 0.6); outline: none;
  }

  .film-reveal { background: transparent; }
  /* a short dip toward black hides the change of scale at the join */
  .film-dip { position: absolute; inset: 0; background: #05080f; opacity: 0; pointer-events: none; }
  .film-shade {
    position: absolute; left: 0; right: 0; bottom: 0; height: 45%; opacity: 0;
    background: linear-gradient(to bottom, transparent, var(--bg));
  }
  .film-hint {
    position: absolute; left: 50%; bottom: 5%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
    font-family: 'Cormorant SC', Georgia, serif; font-size: 0.66rem;
    letter-spacing: 0.4em; text-transform: uppercase; color: #cfe3f2;
  }
  .film-hint i {
    width: 1px; height: 2.6rem;
    background: linear-gradient(to bottom, #cfe3f2, transparent);
    animation: filmHint 2.2s ease-in-out infinite;
  }
  @keyframes filmHint { 0%, 100% { transform: scaleY(0.4); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } }

</style>
