---
// Read-aloud for story pages, using the browser's own speech synthesis.
// Nothing is hosted or downloaded: no audio files, no external service.
//
// Speaks one paragraph per utterance rather than the whole story in one go,
// which keeps Chrome from truncating long text and lets us highlight and
// follow along line by line.
const {
  selector = 'main p',   // what counts as readable prose on this page
  title = '',            // spoken first, so the listener knows where they are
} = Astro.props;
---

<div id="readaloud" data-selector={selector} data-title={title} hidden>
  <button class="atmos-btn tts-main" id="ttsMain" aria-pressed="false">Read aloud</button>
  <button class="atmos-btn tts-stop" id="ttsStop" hidden aria-label="Stop reading">Stop</button>
</div>

<style is:global>
  #readaloud { display: flex; flex-direction: column; gap: .5rem; align-items: flex-end; }
  /* Standalone pages (no atmosphere cluster) get their own corner. */
  #readaloud.tts-floating {
    position: fixed; right: 1rem; bottom: 1rem; z-index: 60;
  }
  @media (max-width: 640px) {
    #readaloud.tts-floating { right: .7rem; bottom: .7rem; }
  }

  /* the button styling mirrors the ambient-sound control */
  #readaloud .atmos-btn {
    font-family: 'Cormorant SC', Georgia, serif;
    font-size: .68rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--text, #b9bfc7);
    background: rgba(8,8,10,0.82);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 2px;
    padding: .5rem .8rem;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: color 220ms ease, border-color 220ms ease;
  }
  #readaloud .atmos-btn:hover { color: var(--text-bright, #fff); border-color: var(--accent, #888); }
  #readaloud .tts-main[aria-pressed="true"] { color: var(--accent, #888); border-color: var(--accent, #888); }

  /* the line currently being spoken */
  .tts-speaking {
    color: var(--text-bright, #fff) !important;
    text-shadow: 0 0 22px color-mix(in srgb, var(--accent, #888) 45%, transparent);
    transition: color 400ms ease, text-shadow 400ms ease;
  }
</style>

<script>
  (function () {
    const host = document.getElementById('readaloud');
    if (!host) return;

    const synth = window.speechSynthesis;
    // No support (or a browser that hides it): leave the control hidden.
    if (!synth || typeof SpeechSynthesisUtterance === 'undefined') return;

    const selector = host.dataset.selector || 'main p';
    const nodes = Array.from(document.querySelectorAll(selector))
      .filter((el) => el.textContent && el.textContent.trim().length);
    if (!nodes.length) return;

    // Join the ambient-sound cluster if the page has one, else float alone.
    const cluster = document.getElementById('controls');
    if (cluster) cluster.prepend(host);
    else host.classList.add('tts-floating');
    host.hidden = false;

    const mainBtn = document.getElementById('ttsMain');
    const stopBtn = document.getElementById('ttsStop');

    const pieces = [];
    if (host.dataset.title) pieces.push({ el: null, text: host.dataset.title });
    nodes.forEach((el) => pieces.push({ el, text: el.textContent.trim() }));

    let at = 0;
    let state = 'idle';        // idle | playing | paused
    let voice = null;
    let keepAlive = null;

    function pickVoice() {
      const all = synth.getVoices();
      if (!all.length) return null;
      const en = all.filter((v) => /^en(-|_|$)/i.test(v.lang));
      const pool = en.length ? en : all;
      // prefer a natural-sounding voice over the robotic defaults
      return (
        pool.find((v) => /natural|neural|enhanced|premium/i.test(v.name)) ||
        pool.find((v) => /^en-GB/i.test(v.lang)) ||
        pool[0]
      );
    }
    voice = pickVoice();
    synth.addEventListener?.('voiceschanged', () => { voice = pickVoice(); });

    function highlight(el) {
      document.querySelectorAll('.tts-speaking').forEach((n) => n.classList.remove('tts-speaking'));
      if (!el) return;
      el.classList.add('tts-speaking');
      const r = el.getBoundingClientRect();
      if (r.top < 80 || r.bottom > window.innerHeight - 80) {
        const gentle = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        el.scrollIntoView({ block: 'center', behavior: gentle ? 'smooth' : 'auto' });
      }
    }

    function setUI(next) {
      state = next;
      const playing = next === 'playing';
      mainBtn.textContent = playing ? 'Pause' : next === 'paused' ? 'Resume' : 'Read aloud';
      mainBtn.setAttribute('aria-pressed', String(next !== 'idle'));
      stopBtn.hidden = next === 'idle';
    }

    function speakFrom(i) {
      if (i >= pieces.length) { stop(); return; }
      at = i;
      const piece = pieces[i];
      const u = new SpeechSynthesisUtterance(piece.text);
      if (voice) u.voice = voice;
      u.rate = 0.95;
      u.pitch = 1;
      u.onstart = () => highlight(piece.el);
      u.onend = () => { if (state === 'playing') speakFrom(at + 1); };
      u.onerror = () => { if (state === 'playing') speakFrom(at + 1); };
      synth.speak(u);
    }

    function start() {
      synth.cancel();
      setUI('playing');
      // Chrome silently stops long sessions; a periodic resume keeps it alive.
      clearInterval(keepAlive);
      keepAlive = setInterval(() => {
        if (state === 'playing' && !synth.paused) { synth.resume(); }
      }, 9000);
      speakFrom(0);
    }

    function stop() {
      clearInterval(keepAlive);
      synth.cancel();
      highlight(null);
      setUI('idle');
      at = 0;
    }

    mainBtn.addEventListener('click', () => {
      if (state === 'idle') start();
      else if (state === 'playing') { synth.pause(); setUI('paused'); }
      else { synth.resume(); setUI('playing'); }
    });
    stopBtn.addEventListener('click', stop);

    // Speech outlives navigation in some browsers, so silence it on the way out.
    window.addEventListener('pagehide', () => { clearInterval(keepAlive); synth.cancel(); });
    window.addEventListener('beforeunload', () => { synth.cancel(); });
  })();
</script>
